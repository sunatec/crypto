//@version=6
indicator("缠论行情基准采集辅助", overlay=true, precision=8)
// Export metadata only. Does not calculate structures or alter the main indicator.
string standardTickerId = ticker.standard(syminfo.tickerid)
int feedCode = standardTickerId == "BINANCE:BTCUSDT" ? 1 : standardTickerId == "BINANCE:ETHUSDT" ? 2 : 0
plot(feedCode, "audit_feed_code", display=display.data_window)
plot(timeframe.in_seconds(), "audit_timeframe_seconds", display=display.data_window)
plot(syminfo.mintick, "audit_tick_size", display=display.data_window)
plot(chart.is_standard ? 1 : 0, "audit_standard", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "audit_closed", display=display.data_window)
plot(time_close, "audit_close_time_ms", display=display.data_window)
plot(1, "audit_capture_version", display=display.data_window)
var table status = table.new(position.top_right, 1, 3)
if barstate.islast
    table.cell(status, 0, 0, "行情基准采集辅助 · 不产生结构", text_color=color.orange, bgcolor=color.rgb(22,27,34))
    table.cell(status, 0, 1, standardTickerId + " · " + timeframe.period + " · tick=" + str.tostring(syminfo.mintick), text_color=color.white, bgcolor=color.rgb(22,27,34))
    table.cell(status, 0, 2, "导出CSV后由本地工具检查；没有曲线是正常的", text_color=color.white, bgcolor=color.rgb(22,27,34))
