        "basis": "gross",
        "desc": "b浪任何部分不能超过a浪起点"
      },
      {
        "id": "zigzag.ratio.c-between-0.9b-and-5b",
        "layer": "ratio",
        "kind": "rule",
        "basis": "price",
        "desc": "c浪须≥b浪90%且<b浪5倍且<a浪5倍"
      },
      {
        "id": "zigzag.time.b-lt-10a",
        "layer": "time",
        "kind": "rule",
        "basis": null,
        "desc": "b浪时间≤a浪10倍"
      },
      {
        "id": "zigzag.time.c-lt-10a-and-10b",
        "layer": "time",
        "kind": "rule",
        "basis": null,
        "desc": "c浪时间≤a、b浪10倍"
      }
    ],
    "guidelines": [
      {
        "id": "zigzag.guide.b-common-ratio",
        "layer": "ratio",
        "kind": "guideline",
        "basis": null,
        "desc": "b浪接近常见比率(0.382/0.5/0.618)"
      },
      {
        "id": "zigzag.guide.c-common-ratio",
        "layer": "ratio",
        "kind": "guideline",
        "basis": null,
        "desc": "c浪接近常见比率(1/0.618/1.618)"
      },
      {
        "id": "zigzag.guide.b-not-approach-a-start",
        "layer": "ratio",
        "kind": "guideline",
        "basis": null,
        "desc": "b浪通常不接近a浪起点（回撤≤a的90%）"
      },
      {
        "id": "zigzag.guide.c-not-far-beyond-1.618a",
        "layer": "ratio",
        "kind": "guideline",
        "basis": null,
        "desc": "c浪未远超a浪的1.618倍（否则更像推动浪）"
      },
      {
        "id": "zigzag.guide.b-time-window",
        "layer": "time",
        "kind": "guideline",
        "basis": null,
