  {
    "pattern": "impulse-strict",
    "roles": [
      "impulse|leading",
      "corrective",
      "impulse",
      "corrective",
      "impulse|ending"
    ],
    "alternateRoles": [],
    "rules": [
      {
        "id": "impulse.pattern.wave2-not-retrace-100",
        "layer": "pattern",
        "kind": "rule",
        "basis": null,
        "desc": "2浪不能折返1浪的100%"
      },
      {
        "id": "impulse.pattern.wave3-exceeds-wave1-end",
        "layer": "pattern",
        "kind": "rule",
        "basis": null,
        "desc": "3浪须超过1浪的终点"
      },
      {
        "id": "impulse.pattern.wave4-not-cross-wave1",
        "layer": "pattern",
        "kind": "rule",
        "basis": null,
        "desc": "推动浪的4浪不能切入1浪"
      },
      {
        "id": "impulse.pattern.wave3-not-shortest",
        "layer": "pattern",
        "kind": "rule",
        "basis": null,
        "desc": "3浪一定不是1/3/5浪中最短的"
      },
      {
        "id": "impulse.ratio.wave2-retrace-range",
        "layer": "ratio",
        "kind": "rule",
        "basis": "price",
        "desc": "2浪回撤须在1浪的23.6%~88.6%之间"
      },
      {
        "id": "impulse.ratio.wave3-extend-range",
        "layer": "ratio",
        "kind": "rule",
        "basis": "price",
        "desc": "3浪相对1浪的扩展须在1~4.236倍之间"
      }
    ],
    "guidelines": [
      {
        "id": "impulse.guide.alternation-2-4",
        "layer": "pattern",
        "kind": "guideline",
        "basis": null,
        "desc": "2浪与4浪呈现交替（回撤比率不同）"
      },
      {
        "id": "impulse.guide.wave3-common-extension",
        "layer": "ratio",
        "kind": "guideline",
        "basis": "price",
        "desc": "3浪扩展接近常见斐波那契倍数（1.618/2.618）"
      },
      {
        "id": "impulse.guide.wave4-time-balance",
        "layer": "time",
        "kind": "guideline",
        "basis": null,
        "desc": "4浪与2浪耗时比在0.2~5倍之间（时间平衡）"
      }
    ]
  },
