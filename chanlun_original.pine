bool showMovements3 = input.bool(true, "显示L3走势", group = "L3层")
bool showCenters3 = input.bool(true, "显示L3中枢", group = "L3层")
color l3Color = input.color(color.rgb(236, 72, 153), "L3颜色", group = "L3层")
int movementWidth = input.int(3, "走势线宽（逐层加粗）", minval = 1, maxval = 6, group = "走势")
bool showMovementIds = input.bool(true, "显示走势类型与编号", group = "走势")
color mergedColor = input.color(color.gray, "合并K线边界颜色", group = "研究视图")
int mergedWidth = input.int(1, "合并K线边界线宽", minval = 1, maxval = 3, group = "研究视图")
int mergedTransparency = input.int(92, "合并K线填充透明度", minval = 75, maxval = 100, group = "研究视图")
bool showComparison = input.bool(true, "研究：显示面积对比与比较段", group = "研究视图")
bool showNotes = input.bool(false, "研究：显示未成立原因", group = "研究视图")
bool showDiagnostic = input.bool(true, "研究：显示R端点诊断", group = "研究视图")
string groupSignals = "买卖点（信号阶段）"
bool signalsOn = input.bool(true, "启用背驰与买卖点（关闭则不计算）", group = groupSignals)
bool showSignals = input.bool(true, "显示确认买卖点", group = groupSignals)
bool showSignalL1 = input.bool(true, "显示L1买卖点", group = groupSignals)
bool showSignalL2 = input.bool(true, "显示L2买卖点", group = groupSignals)
bool showSignalL3 = input.bool(true, "显示L3买卖点", group = groupSignals)
bool showFirst = input.bool(true, "显示第一类买卖点", group = groupSignals)
bool showConsolidation = input.bool(true, "显示盘整背驰点", group = groupSignals)
bool showSecond = input.bool(true, "显示第二类买卖点", group = groupSignals)
bool showThird = input.bool(true, "显示第三类买卖点", group = groupSignals)
color buyColor = input.color(color.rgb(8, 153, 129), "买点颜色", group = groupSignals)
color sellColor = input.color(color.rgb(242, 54, 69), "卖点颜色", group = groupSignals)
string groupAlerts = "提醒（信号阶段）"
bool alertsOn = input.bool(false, "启用提醒（确认K线收盘时每个信号一条）", group = groupAlerts)
bool alertL1 = input.bool(true, "提醒L1", group = groupAlerts)
bool alertL2 = input.bool(true, "提醒L2", group = groupAlerts)
bool alertL3 = input.bool(true, "提醒L3", group = groupAlerts)
bool alertFirst = input.bool(true, "提醒第一类", group = groupAlerts)
bool alertConsolidation = input.bool(true, "提醒盘整背驰点", group = groupAlerts)
bool alertSecond = input.bool(true, "提醒第二类", group = groupAlerts)
bool alertThird = input.bool(true, "提醒第三类", group = groupAlerts)
bool research = viewMode == "研究"

// ==================== Signal display and alerts: projections of committed signals, nothing flows back ====================
chan_signal_type_text(string type) =>
    type == "first" ? "一" : type == "second" ? "二" : type == "third" ? "三" : "盘背"

chan_signal_caption(ChanSignal signal) =>
    "L" + str.tostring(signal.layer) + " " + chan_signal_type_text(signal.type) + (signal.side == 1 ? "买" : "卖")

// One filter for marks and for alerts: the layer switch and the type switch must both be on.
chan_signal_allowed(ChanSignal signal, bool l1, bool l2, bool l3, bool first, bool consolidation, bool second, bool third) =>
    bool layerOn = signal.layer == 1 ? l1 : signal.layer == 2 ? l2 : l3
    bool typeOn = signal.type == "first" ? first : signal.type == "second" ? second : signal.type == "third" ? third : consolidation
    layerOn and typeOn

chan_signal_reason_text(string reason) =>
    switch reason
        "not-new-extreme" => "终点没有严格创新高（低）"
        "area-unavailable" => "面积不可用（已回收或预热）"
        "area-not-smaller" => "面积不小于比较段"
        "no-entry-segment" => "没有进入段"
        "no-same-direction-entry" => "进入段方向不同"
        "breaks-first-class-price" => "越过第一类价格"
        "touch-edge" => "回抽触及中枢边界，算回到中枢"
        => reason

chan_signal_area_text(ChanSegmentArea segment) =>
    na(segment.area) ? "不可用" : str.tostring(segment.area, "#.##")

chan_signal_draw(ChanDrawRegistry registry, ChanSignal signal, float tickSize, color buyHue, color sellHue, int fontSize, bool detailed, bool withComparison, int labelBudget) =>
    color hue = signal.side == 1 ? buyHue : sellHue
    string tooltip = "买卖点，不是结构编号\n" + signal.id + "\n规则：" + signal.ruleId + "\n发生：" + str.format_time(signal.occurredAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC\n确认：" + str.format_time(signal.confirmedAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
    if detailed
        tooltip += "\n依赖：" + array.join(signal.dependencies, "\n")
        tooltip += "\n可用低级别区间套细化"
    chan_draw_put(registry, ChanDrawSpec.new(signal.id + "/mark", signal.side == 1 ? "D-signal-buy" : "D-signal-sell", "label", signal.occurredAt, signal.occurredAt, signal.priceTicks * tickSize, signal.priceTicks * tickSize, hue, 1, true, chan_signal_caption(signal), tooltip, math.max(8, fontSize - 1), 100, false, math.max(1, math.min(30, labelBudget))))
    if withComparison and not na(signal.comparison)
        ChanComparison comparison = signal.comparison
        float aPrice = comparison.a.extremeTicks * tickSize
        float cPrice = comparison.c.extremeTicks * tickSize
        // The drawing registry rejects a backwards line, so the two ends are put in time order.
        bool ordered = comparison.a.endTime <= comparison.c.endTime
        chan_draw_put(registry, ChanDrawSpec.new(signal.id + "/compare-line", "D-compare-line", "line", ordered ? comparison.a.endTime : comparison.c.endTime, ordered ? comparison.c.endTime : comparison.a.endTime, ordered ? aPrice : cPrice, ordered ? cPrice : aPrice, hue, 1, false, "", "", fontSize, 100, false, 30))
        string compareText = (comparison.kind == "trend" ? "趋势" : "盘整") + " A面积 " + chan_signal_area_text(comparison.a) + " / C面积 " + chan_signal_area_text(comparison.c)
        int middleTime = comparison.a.endTime + (comparison.c.endTime - comparison.a.endTime) / 2
        chan_draw_put(registry, ChanDrawSpec.new(signal.id + "/compare-text", "D-compare", "label", middleTime, middleTime, (aPrice + cPrice) / 2, (aPrice + cPrice) / 2, hue, 1, false, compareText, "A与C的端点极值连线；面积越小越背驰\n" + signal.id, math.max(8, fontSize - 2), 100, false, 30))
    true

chan_signal_note_draw(ChanDrawRegistry registry, ChanSignalNote note, ChanComponent anchor, float tickSize, int fontSize) =>
    int at = anchor.realEndTime
    float price = anchor.realEndTicks * tickSize
    if not na(note.comparison)
        at := note.comparison.c.endTime
        price := note.comparison.c.extremeTicks * tickSize
    string id = array.join(note.dependencies, ">") + "/" + note.type + "/" + note.reason
    string typeName = note.type == "first" ? "第一类" : note.type == "second" ? "第二类" : note.type == "third" ? "第三类" : "盘整背驰"
    chan_draw_put(registry, ChanDrawSpec.new(id, "D-note", "label", at, at, price, price, color.gray, 1, false, typeName + "未成立：" + chan_signal_reason_text(note.reason), "未成立记录，不是信号，不触发提醒\n" + id, math.max(8, fontSize - 2), 100, false, 16))
    true

chan_signal_alert_text(ChanSignal signal, float tickSize) =>
    "缠论买卖点 " + syminfo.tickerid + " " + timeframe.period + " L" + str.tostring(signal.layer) + " " + chan_signal_type_text(signal.type) + (signal.side == 1 ? "买点" : "卖点") + " 价格 " + str.tostring(signal.priceTicks * tickSize, format.mintick) + " 发生 " + str.format_time(signal.occurredAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC 确认 " + str.format_time(signal.confirmedAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC ID " + signal.id

// R endpoint diagnostic (7.1). A completed movement is only read: the diagnostic asks whether a first-class signal of the same
// layer sits on its endpoint. Nothing here feeds back into the engine, the signal runtime or the movement record.
// The first-class signal of the movement's last centre (the one whose close completed it), or na.
chan_r_linked_signal(ChanMovement movement, ChanSignalLayer owner) =>
    ChanSignal linked = na
    string lastCenter = movement.centerIds.size() > 0 ? movement.centerIds.last() : ""
    if lastCenter != "" and owner.signals.size() > 0
        for candidate in owner.signals
            if candidate.type == "first" and candidate.dependencies.size() > 0 and candidate.dependencies.get(0) == lastCenter and candidate.side == -movement.direction
                linked := candidate
                break
    linked

// matched: same time and price; offset: the last centre has a first-class signal elsewhere; none: it has none;
// unknown: none was found but older signals of the layer were recycled.
chan_r_endpoint_verdict(ChanMovement movement, ChanSignal linked, ChanSignalLayer owner) =>
    string verdict = "none"
    if not na(linked)
        verdict := linked.occurredAt == movement.endTime and linked.priceTicks == movement.endTicks ? "matched" : "offset"
    else if owner.dropped > 0
        verdict := "unknown"
    verdict

chan_r_verdict_index(string verdict) =>
    verdict == "matched" ? 0 : verdict == "offset" ? 1 : verdict == "none" ? 2 : 3

chan_r_verdict_text(string verdict) =>
    switch verdict
        "matched" => "端点已背驰确认"
        "offset" => "端点未经背驰确认·末中枢一类点偏移"
        "none" => "端点未经背驰确认·末中枢无一类点"
        => "端点未经背驰确认·信号已回收，无法比对"

chan_r_diagnostic_draw(ChanDrawRegistry registry, ChanMovement movement, ChanSignal linked, string verdict, float tickSize, int fontSize) =>
    color hue = verdict == "matched" ? color.teal : verdict == "offset" ? color.orange : color.gray
    string tooltip = "走势完成诊断，不是买卖点；不改变走势完成记录\n" + movement.id + "\n规则：" + movement.ruleId + "\n类型：" + movement.morphology + "\n端点：" + str.format_time(movement.endTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC @ " + str.tostring(movement.endTicks * tickSize, format.mintick) + "\n完成确认：" + str.format_time(movement.confirmedAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
    if not na(linked)
        tooltip += "\n同层一类点：" + linked.id + "\n其端点：" + str.format_time(linked.occurredAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC @ " + str.tostring(linked.priceTicks * tickSize, format.mintick)
    tooltip += "\nR-003 取离开部件起点之前的同向极值，第一类点取离开部件终点"
    chan_draw_put(registry, ChanDrawSpec.new(movement.id + "/diagnostic", movement.direction == 1 ? "D-diag-top" : "D-diag-bottom", "label", movement.endTime, movement.endTime, movement.endTicks * tickSize, movement.endTicks * tickSize, hue, 1, true, "L" + str.tostring(movement.level) + " R" + str.tostring(movement.ordinal) + " " + chan_r_verdict_text(verdict), tooltip, math.max(8, fontSize - 2), 100, false, 16))
    true

// ==================== Chart scheduling: no drawing decisions enter the core ====================
var ChanRuntime engine = chan_runtime_new_levels(syminfo.tickerid + "/" + timeframe.period + "/" + str.tostring(syminfo.mintick), segmentPendingLimit, 8192, 64, levelLimit)
var ChanWindow analysisWindow = chan_window_new(fixedStart, requestedStart, initialBars, last_bar_index, time, sampleLimit)
// The fixed window stops at sampleLimit, so its prefixes are never recycled. The recent
// window keeps growing with live bars, so it keeps twice the initial bars and recycles the oldest.
var ChanMacd macd = chan_macd_new(macdFast, macdSlow, macdSignal, fixedStart ? sampleLimit : 2 * initialBars)
// The divergence layer keeps its own mirror of the Z/R stack, fed the same confirmed L0 parts in the same order.
var ChanSignalRuntime signals = chan_signal_runtime_new(syminfo.tickerid + "/" + timeframe.period + "/" + str.tostring(syminfo.mintick), levelLimit)
// R endpoint diagnostic tallies: index = layer * 4 + (0 matched, 1 offset, 2 none, 3 unknown). Display only, written on confirmed frames.
var array<int> diagCounts = array.new<int>(16, 0)
var array<string> diagMisses = array.new<string>()
ChanState committed = engine.morphology
ChanSegmentState segments = engine.segments
ChanNormalizationState normalized = engine.normalized
ChanCenterState centers = engine.centers
var ChanDrawRegistry drawings = chan_draw_new(labelBudget)
color statusBackground = color.rgb(22, 27, 34)
color statusMuted = color.rgb(200, 210, 222)
int statusFontSize = math.max(14, math.min(16, fontSize))
var table status = table.new(position.top_right, 2, 13, bgcolor = statusBackground, frame_color = color.rgb(75, 85, 99), frame_width = 1)
if barstate.isfirst
    table.merge_cells(status, 0, 0, 1, 0)
    table.merge_cells(status, 0, 1, 1, 1)
    table.merge_cells(status, 0, 2, 1, 2)
    table.merge_cells(status, 0, 8, 1, 8)
    table.merge_cells(status, 0, 9, 1, 9)
    table.merge_cells(status, 0, 10, 1, 10)
    table.merge_cells(status, 0, 11, 1, 11)
    table.merge_cells(status, 0, 12, 1, 12)
bool supported = chart.is_standard and not na(time_close)
ChanWindowFrame windowFrame = chan_window_step(analysisWindow, time, bar_index, supported and barstate.isconfirmed)
if supported
    analysisWindow := windowFrame.state
bool inRange = chan_context_allows(supported, windowFrame)
bool limited = analysisWindow.fixed and analysisWindow.count >= analysisWindow.maxSamples
bool insufficientHistory = analysisWindow.fixed and analysisWindow.requestedStart < analysisWindow.firstAvailable
ChanState visible = committed
ChanVisualStyle strokeStyle = ChanVisualStyle.new()
strokeStyle.strokeColor := strokeColor
strokeStyle.strokeWidth := strokeWidth
strokeStyle.segmentColor := segmentColor
strokeStyle.segmentWidth := segmentWidth
strokeStyle.fontSize := fontSize
strokeStyle.detailed := research
strokeStyle.l1Color := centerColor
strokeStyle.l2Color := l2Color
strokeStyle.l3Color := l3Color
strokeStyle.movementWidth := movementWidth
strokeStyle.centerTransparency := centerTransparency
strokeStyle.centerWidth := centerWidth
strokeStyle.strokeLabelStride := strokeLabelStride
strokeStyle.segmentLabelStride := segmentLabelStride
if supported and inRange
    ChanRaw incoming = ChanRaw.new(time, time_close, int(math.round(open / syminfo.mintick)), int(math.round(high / syminfo.mintick)), int(math.round(low / syminfo.mintick)), int(math.round(close / syminfo.mintick)))
    ChanRuntimeFrame frame = chan_runtime_update(engine, incoming, barstate.isconfirmed)
    engine := frame.committed
    committed := engine.morphology
    segments := engine.segments
    normalized := engine.normalized
    centers := engine.centers
    visible := frame.visible
    // MACD shares the window gate and the close gate with the engine; nothing reads it back yet.
    if signalsOn and barstate.isconfirmed
        chan_macd_push(macd, time, close)
    if frame.submitted
        if frame.segmentEvents.size() > 0
            for eventIndex = 0 to frame.segmentEvents.size() - 1
                ChanStructure segment = frame.segmentEvents.get(eventIndex)
                ChanComponent component = frame.componentEvents.get(eventIndex)
                // D1..D3 read the Z/R states after this part; MACD already holds this bar.
                if signalsOn
                    signals := chan_signal_part(signals, component, macd)
                    // Committed signals are only read here: marks, comparison labels and alerts are projections.
                    for signal in signals.events
                        if showSignals and chan_signal_allowed(signal, showSignalL1, showSignalL2, showSignalL3, showFirst, showConsolidation, showSecond, showThird)
                            chan_signal_draw(drawings, signal, syminfo.mintick, buyColor, sellColor, fontSize, research, research and showComparison, labelBudget)
                        // alert() fires on the closing execution of a live bar only; historical bars and open-bar candidates never alert.
                        if alertsOn and barstate.isrealtime and chan_signal_allowed(signal, alertL1, alertL2, alertL3, alertFirst, alertConsolidation, alertSecond, alertThird)
                            alert(chan_signal_alert_text(signal, syminfo.mintick), alert.freq_all)
                    if research and showNotes
                        for note in signals.notes
                            chan_signal_note_draw(drawings, note, component, syminfo.mintick, fontSize)
                    // R completions of this part, read from the mirror stack; the engine's own movement records are untouched.
                    for layerIndex = 1 to levelLimit
                        ChanMovement completed = na
                        ChanSignalLayer owner = na
                        if layerIndex == 1
                            completed := signals.stack.movements.event
                            owner := signals.d1
                        else if layerIndex == 2
                            completed := signals.stack.levels.movements2.event
                            owner := signals.d2
                        else
                            completed := signals.stack.levels.movements3.event
                            owner := signals.d3
                        if not na(completed) and completed.completed
                            ChanSignal linked = chan_r_linked_signal(completed, owner)
                            string verdict = chan_r_endpoint_verdict(completed, linked, owner)
                            int tally = layerIndex * 4 + chan_r_verdict_index(verdict)
                            diagCounts.set(tally, diagCounts.get(tally) + 1)
                            if verdict != "matched"
                                diagMisses.push("L" + str.tostring(layerIndex) + " " + str.format_time(completed.endTime, "yyyy-MM-dd HH:mm", "UTC") + (verdict == "offset" ? "偏" : verdict == "none" ? "无" : "?"))
                                if diagMisses.size() > 4
                                    diagMisses.shift()
                            if research and showDiagnostic
                                chan_r_diagnostic_draw(drawings, completed, linked, verdict, syminfo.mintick, fontSize)
                if research and showNormalized
                    chan_draw_component(drawings, component, syminfo.mintick, strokeStyle)
                if showSegments
                    chan_draw_structure(drawings, segment, syminfo.mintick, strokeStyle, showSegmentIds)
                    if research and showConfirmations
                        chan_draw_put(drawings, ChanDrawSpec.new(segment.id + "/confirmation", "S-confirmation", "label", segment.confirmedAt, segment.confirmedAt, segment.endTicks * syminfo.mintick, segment.endTicks * syminfo.mintick, segmentColor, 1, true, "S确认#" + str.tostring(segment.ordinal), "发生端点在过去；此处才具备确认依据\n" + segment.ruleId, math.max(8, fontSize - 2), 100, false, labelBudget))
        if showStrokes and not na(committed.strokeEvent)
            chan_draw_structure(drawings, committed.strokeEvent, syminfo.mintick, strokeStyle, showStrokeIds)
        if showFractals and not na(committed.event) and (committed.confirmedFractals - 1) % labelStride == 0
            chan_draw_put(drawings, chan_fractal_spec(committed.event, syminfo.mintick, true, topColor, bottomColor, fontSize, research, false, labelBudget))
            if research and showConfirmations
                ChanFractal event = committed.event
                chan_draw_put(drawings, ChanDrawSpec.new(event.id + "/confirmation", "F-confirmation", "label", event.confirmedAt, event.confirmedAt, event.priceTicks * syminfo.mintick, event.priceTicks * syminfo.mintick, color.gray, 1, true, "F确认#" + str.tostring(event.middleOrdinal + 1), "端点发生时间与此处的证据确认时间不同", math.max(8, fontSize - 2), 100, false, labelBudget))

// ==================== Last-bar research projection ====================
if barstate.islast
    chan_draw_begin(drawings)
    ChanState strokePreview = chan_stroke_preview(visible)
    if showStrokes and supported
        // Unsealed fractals are evaluated only in an isolated drawing preview.
        // Neither this preview nor its hypothetical locking event enters committed state.
        if not na(strokePreview.strokeCandidate)
            chan_draw_structure(drawings, strokePreview.strokeCandidate, syminfo.mintick, strokeStyle, showStrokeIds)
        ChanStructure pendingLock = chan_stroke_pending(strokePreview, committed.strokeCount)
        if not na(pendingLock)
            chan_draw_structure(drawings, pendingLock, syminfo.mintick, strokeStyle, showStrokeIds)
    if supported
        ChanSegmentPreview segmentProjection = chan_runtime_segment_preview(engine, visible, strokePreview)
        ChanSegmentState segmentPreview = segmentProjection.state
        if not na(segmentPreview)
            if showSegments
                if not na(segmentPreview.candidate)
                    chan_draw_structure(drawings, segmentPreview.candidate, syminfo.mintick, strokeStyle, showSegmentIds)
                int committedSegments = na(segments) ? 0 : segments.segmentCount
                if segmentPreview.segmentCount > committedSegments
                    for event in segmentProjection.events
                        ChanStructure pending = chan_structure_copy(event)
                        pending.confirmed := false
                        pending.confirmedAt := na
                        chan_draw_structure(drawings, pending, syminfo.mintick, strokeStyle, showSegmentIds)
            if research and showFeatures
                if not na(segmentPreview.firstContext)
                    chan_draw_features(drawings, segmentPreview.firstContext, syminfo.mintick, strokeStyle)
                if not na(segmentPreview.secondContext)
                    chan_draw_features(drawings, segmentPreview.secondContext, syminfo.mintick, strokeStyle)
    // Candidate signals of the open bar (5.2). The hypothetical segments are normalised into parts on copies,
    // judged on a copy of the signal runtime, and drawn hollow; nothing here is written back to engine, MACD or signals.
    if supported and inRange and signalsOn and showCandidates and not barstate.isconfirmed
        ChanSegmentPreview candidateProjection = chan_runtime_segment_preview(engine, visible, strokePreview)
        array<ChanComponent> candidateParts = chan_signal_preview_parts(engine.normalized, candidateProjection.events, time_close)
        ChanSignalCandidates candidates = chan_signal_candidates(signals, candidateParts, chan_macd_preview(macd, time, close))
        for candidate in candidates.events
            // Hollow, side-coloured, only if the same layer/type switches would show the confirmed mark.
            if chan_signal_allowed(candidate, showSignalL1, showSignalL2, showSignalL3, showFirst, showConsolidation, showSecond, showThird)
                chan_draw_put(drawings, ChanDrawSpec.new(candidate.id + "/candidate", candidate.side == 1 ? "D-candidate-buy" : "D-candidate-sell", "label", candidate.occurredAt, candidate.occurredAt, candidate.priceTicks * syminfo.mintick, candidate.priceTicks * syminfo.mintick, candidate.side == 1 ? buyColor : sellColor, 1, false, "候选" + chan_signal_caption(candidate), "未收盘预览，收盘时条件不再成立则消失；不触发提醒\n" + candidate.id, math.max(8, fontSize - 2), 100, true, 8))
    if showFractals and supported
        if not na(visible.candidate)
            chan_draw_put(drawings, chan_fractal_spec(visible.candidate, syminfo.mintick, false, topColor, bottomColor, fontSize, research, true, labelBudget))
        // A preview may seal an older fractal; it remains visibly unconfirmed until close.
        if not barstate.isconfirmed and not limited and not na(visible.event)
            chan_draw_put(drawings, chan_fractal_spec(visible.event, syminfo.mintick, false, topColor, bottomColor, fontSize, research, true, labelBudget))
    if research and showMerged and supported and visible.elements.size() > 0
        for element in visible.elements
            if element.lastRaw > element.firstRaw
                string caption = "K#" + str.tostring(element.ordinal + 1)
                string tooltip = caption + " · 合并 " + str.tostring(element.lastRaw - element.firstRaw + 1) + " 根" + (element.sealed ? "" : " · 候选") + "\n" + element.id + "\n高点来源：" + str.format_time(element.highTime, "yyyy-MM-dd HH:mm", "UTC") + "\n低点来源：" + str.format_time(element.lowTime, "yyyy-MM-dd HH:mm", "UTC") + "\n规则：K-001/K-002"
                chan_draw_put(drawings, ChanDrawSpec.new(element.id + "/range", "K-range", "box", element.firstTime, element.lastTime, element.lowTicks * syminfo.mintick, element.highTicks * syminfo.mintick, mergedColor, mergedWidth, element.sealed, "", "", fontSize, mergedTransparency, true, 4))
                chan_draw_put(drawings, ChanDrawSpec.new(element.id + "/caption", "K-caption", "label", element.firstTime, element.firstTime, element.lowTicks * syminfo.mintick, element.lowTicks * syminfo.mintick, mergedColor, 1, element.sealed, caption, tooltip, math.max(8, fontSize - 2), 100, true, 4))
    if supported and showCenters
        for historicalCenter in centers.history
            chan_draw_center(drawings, historicalCenter, syminfo.mintick, strokeStyle, showCenterIds)
        if not na(centers.center) and centers.center.lifecycle != "closed"
            chan_draw_center(drawings, centers.center, syminfo.mintick, strokeStyle, showCenterIds)
    // Per-layer switches only decide what is drawn; the layers keep computing.
    if supported
        if showMovements1
            chan_draw_movement_layer(drawings, engine.movements, syminfo.mintick, strokeStyle, showMovementIds)
        if showMovements2
            chan_draw_movement_layer(drawings, engine.levels.movements2, syminfo.mintick, strokeStyle, showMovementIds)
        if showMovements3
            chan_draw_movement_layer(drawings, engine.levels.movements3, syminfo.mintick, strokeStyle, showMovementIds)
        if showCenters2
            for historicalCenter in engine.levels.centers2.history
                chan_draw_center(drawings, historicalCenter, syminfo.mintick, strokeStyle, showCenterIds)
            if not na(engine.levels.centers2.center) and engine.levels.centers2.center.lifecycle != "closed"
                chan_draw_center(drawings, engine.levels.centers2.center, syminfo.mintick, strokeStyle, showCenterIds)
        if showCenters3
            for historicalCenter in engine.levels.centers3.history
                chan_draw_center(drawings, historicalCenter, syminfo.mintick, strokeStyle, showCenterIds)
            if not na(engine.levels.centers3.center) and engine.levels.centers3.center.lifecycle != "closed"
                chan_draw_center(drawings, engine.levels.centers3.center, syminfo.mintick, strokeStyle, showCenterIds)
    chan_draw_sweep(drawings)
    string centerRelation = centers.relationKind == "up-continuation" ? "上移延续证据" : centers.relationKind == "down-continuation" ? "下移延续证据" : centers.relationKind == "range-overlap" ? "波动重叠：扩展证据" : centers.relationKind == "core-overlap" ? "核心重叠：关系待核验" : centers.relationKind == "new-center-pending" ? "离开已证实：等待新中枢" : "等待中枢关系"
    string condition = chan_status_text(chan_status_code(engine, analysisWindow, supported))
    table.cell(status, 0, 0, "缠论形态 · " + viewMode + "视图", text_color = color.orange, bgcolor = statusBackground, text_size = statusFontSize)
    table.cell(status, 0, 1, condition, text_color = color.rgb(255, 211, 128), bgcolor = statusBackground, text_size = statusFontSize)
    table.cell(status, 0, 2, "有效起点：" + (na(visible.effectiveStart) ? "等待" : str.format_time(visible.effectiveStart, "yyyy-MM-dd HH:mm", "UTC") + " UTC"), text_color = statusMuted, bgcolor = statusBackground, text_size = statusFontSize)
    table.cell(status, 0, 3, "确认分型", text_color = color.white, bgcolor = statusBackground, text_size = statusFontSize, text_halign = text.align_left)
    table.cell(status, 1, 3, str.tostring(committed.confirmedFractals), text_color = color.white, bgcolor = statusBackground, text_size = statusFontSize)
    table.cell(status, 0, 4, "确认笔", text_color = color.white, bgcolor = statusBackground, text_size = statusFontSize, text_halign = text.align_left)
    table.cell(status, 1, 4, str.tostring(committed.strokeCount), text_color = color.white, bgcolor = statusBackground, text_size = statusFontSize)
    table.cell(status, 0, 5, "确认线段", text_color = color.white, bgcolor = statusBackground, text_size = statusFontSize, text_halign = text.align_left)
    table.cell(status, 1, 5, str.tostring(na(segments) ? 0 : segments.segmentCount), text_color = color.orange, bgcolor = statusBackground, text_size = statusFontSize)
    table.cell(status, 0, 6, "L0 标准部件", text_color = color.white, bgcolor = statusBackground, text_size = statusFontSize, text_halign = text.align_left)
    table.cell(status, 1, 6, str.tostring(normalized.count), text_color = color.rgb(125, 211, 252), bgcolor = statusBackground, text_size = statusFontSize)
    table.cell(status, 0, 7, "L1 中枢", text_color = color.white, bgcolor = statusBackground, text_size = statusFontSize, text_halign = text.align_left)
    table.cell(status, 1, 7, str.tostring(centers.count), text_color = color.rgb(216, 180, 254), bgcolor = statusBackground, text_size = statusFontSize)
    string centerPeriod = na(centers.center) ? "中枢时间：尚未形成" : "最近中枢 #" + str.tostring(centers.center.ordinal) + "（UTC）\n" + str.format_time(centers.center.startTime, "yyyy-MM-dd HH:mm", "UTC") + " →\n" + str.format_time(centers.center.extentEndTime, "yyyy-MM-dd HH:mm", "UTC")
    string centerPrices = na(centers.center) ? "中枢价格：—" : "中枢价格：" + str.tostring(centers.center.coreLowTicks * syminfo.mintick, format.mintick) + " ～ " + str.tostring(centers.center.coreHighTicks * syminfo.mintick, format.mintick)
    table.cell(status, 0, 8, centerPeriod, text_color = statusMuted, bgcolor = statusBackground, text_size = statusFontSize)
    table.cell(status, 0, 9, centerPrices + (showCenters ? "" : " · 显示已关闭"), text_color = color.rgb(216, 180, 254), bgcolor = statusBackground, text_size = statusFontSize)
    string movementNote = "走势完成 L1/L2/L3：" + str.tostring(engine.movements.count) + "/" + str.tostring(engine.levels.movements2.count) + "/" + str.tostring(engine.levels.movements3.count) + "\n上层中枢 L2/L3：" + str.tostring(engine.levels.centers2.count) + "/" + str.tostring(engine.levels.centers3.count) + (engine.levels.levelLimit < 3 ? "\n层数上限 " + str.tostring(engine.levels.levelLimit) + "，更高层未计算" : "") + (engine.movements.blocked ? "\n走势层受限：" + engine.movements.blockKind : "")
    table.cell(status, 0, 10, centerRelation + "\n" + movementNote, text_color = statusMuted, bgcolor = statusBackground, text_size = statusFontSize)
    table.cell(status, 0, 11, research ? "绘图：线 " + str.tostring(chan_draw_count(drawings, "line", "")) + " / 框 " + str.tostring(chan_draw_count(drawings, "box", "")) + " / 标签 " + str.tostring(chan_draw_count(drawings, "label", "")) + "\nMACD前缀 " + str.tostring(macd.times.size()) + "/" + str.tostring(macd.capacity) + (macd.dropped > 0 ? " · 已回收 " + str.tostring(macd.dropped) : "") + "\n背驰信号 D1/D2/D3" + (signalsOn ? "：" : "（未启用）：") + str.tostring(signals.d1.count) + "/" + str.tostring(signals.d2.count) + "/" + str.tostring(signals.d3.count) + "\n买卖点标记 买" + str.tostring(chan_draw_count(drawings, "label", "D-signal-buy")) + " / 卖" + str.tostring(chan_draw_count(drawings, "label", "D-signal-sell")) + "\nR端点 确认/偏移/无/?  L1 " + str.tostring(diagCounts.get(4)) + "/" + str.tostring(diagCounts.get(5)) + "/" + str.tostring(diagCounts.get(6)) + "/" + str.tostring(diagCounts.get(7)) + "  L2 " + str.tostring(diagCounts.get(8)) + "/" + str.tostring(diagCounts.get(9)) + "/" + str.tostring(diagCounts.get(10)) + "/" + str.tostring(diagCounts.get(11)) + "  L3 " + str.tostring(diagCounts.get(12)) + "/" + str.tostring(diagCounts.get(13)) + "/" + str.tostring(diagCounts.get(14)) + "/" + str.tostring(diagCounts.get(15)) + (diagMisses.size() > 0 ? "\n未确认端点：" + array.join(diagMisses, "；") : "") : "结构编号不是买卖点", text_color = statusMuted, bgcolor = statusBackground, text_size = statusFontSize)
    string rangeStart = na(analysisWindow.firstInput) ? "等待输入" : str.format_time(analysisWindow.firstInput, "yyyy-MM-dd HH:mm", "UTC")
    string rangeRequest = analysisWindow.fixed ? "请求：" + str.format_time(analysisWindow.requestedStart, "yyyy-MM-dd HH:mm", "UTC") : "近期窗口：加载时固定"
    table.cell(status, 0, 12, rangeRequest + "\n接收起点：" + rangeStart + " UTC · " + str.tostring(analysisWindow.count) + "根" + (insufficientHistory ? "\n请求起点早于可用历史" : ""), text_color = statusMuted, bgcolor = statusBackground, text_size = statusFontSize)
