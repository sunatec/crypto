//@version=6
indicator("缠论原文 · 形态研究预览", "缠论原文·预览", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// BEGIN CHANLUN CORE
// K/F/P/S/N and continuous L1 centers: chanlun-research-0.1.
// R completion and completed L2/L3 inputs still require independent proof.
// All time coordinates are UTC milliseconds; prices are integer ticks.
type ChanRaw
    int openTime
    int closeTime
    int openTicks
    int highTicks
    int lowTicks
    int closeTicks

type ChanElement
    string id
    int ordinal
    int firstTime
    int lastTime
    int highTicks
    int lowTicks
    int highTime
    int lowTime
    int firstRaw
    int lastRaw
    bool sealed

type ChanFractal
    string id
    int kind
    int endpointTime
    int priceTicks
    int confirmedAt
    string leftId
    string middleId
    string rightId
    string ruleId
    int leftOrdinal
    int middleOrdinal
    int rightOrdinal
    int middleHighTicks
    int middleLowTicks

// Shared contracts for later modules. An absent proof is represented by na,
// never by an invented completed structure. These types do not produce signals.
type ChanStructure
    string id
    string objectType
    int level
    int direction
    int startTime
    int endTime
    int startTicks
    int endTicks
    bool confirmed = false
    int confirmedAt = na
    string ruleId
    array<string> dependencies
    int ordinal = 0
    int memberLowTicks = na
    int memberHighTicks = na
    int memberLowTime = na
    int memberHighTime = na

type ChanComponent
    string id
    string segmentId
    int realStartTime
    int realEndTime
    int realStartTicks
    int realEndTicks
    int actualLowTicks
    int actualHighTicks
    int actualLowTime
    int actualHighTime
    int analysisStartTime
    int analysisEndTime
    int analysisStartTicks
    int analysisEndTicks
    int direction
    int confirmedAt
    string ruleId
    array<string> dependencies
    int ordinal = 0

type ChanCenter
    string id
    int level
    int coreLowTicks
    int coreHighTicks
    int ggTicks
    int gTicks
    int dTicks
    int ddTicks
    int startTime
    int formedAt
    int extentEndTime
    int confirmedAt = na
    bool degenerate = false
    string lifecycle
    string ruleId
    array<string> dependencies
    int ordinal = 0
    int zWaves = 0
    int closedAt = na
    string leaveId = ""
    string returnId = ""

type ChanMovement
    string id
    int level
    int direction
    int startTime
    int endTime
    int startTicks
    int endTicks
    string morphology
    bool completed = false
    int confirmedAt = na
    string completionProof
    string ruleId
    array<string> childIds
    array<string> centerIds
    int ordinal = 0
    int lowTicks = na
    int highTicks = na
    int lowTime = na
    int highTime = na
    int occurredAt = na
    bool truncated = false
    ChanComponent upper

type ChanConfirmation
    string id
    string objectId
    string objectType
    int level
    int occurredAt
    int confirmedAt
    string ruleId
    array<string> dependencies

type ChanState
    string contextId = ""
    array<ChanElement> elements
    ChanRaw seed
    ChanRaw lastRaw
    ChanFractal candidate
    ChanFractal lastConfirmed
    ChanFractal event
    int direction = 0
    int processedCount = 0
    int inputCount = 0
    int confirmedFractals = 0
    int effectiveStart = na
    ChanFractal strokeAnchor
    ChanFractal strokeEnd
    ChanFractal lastStrokeInput
    ChanStructure strokeCandidate
    ChanStructure strokeEvent
    ChanStructure lastStroke
    int strokeCount = 0
    int ignoredStrokeFractals = 0

chan_new(string contextId) =>
    ChanState state = ChanState.new()
    state.contextId := "chanlun-research-0.1/" + contextId
    state.elements := array.new<ChanElement>()
    state

chan_structure_copy(ChanStructure source) =>
    ChanStructure result = na
    if not na(source)
        result := source.copy()
        if not na(source.dependencies)
            result.dependencies := source.dependencies.copy()
    result

// UDT.copy() is shallow: copy the collection and each referenced record explicitly.
chan_clone(ChanState source) =>
    ChanState result = source.copy()
    result.elements := array.new<ChanElement>()
    if source.elements.size() > 0
        for element in source.elements
            result.elements.push(element.copy())
    if not na(source.seed)
        result.seed := source.seed.copy()
    if not na(source.lastRaw)
        result.lastRaw := source.lastRaw.copy()
    if not na(source.candidate)
        result.candidate := source.candidate.copy()
    if not na(source.lastConfirmed)
        result.lastConfirmed := source.lastConfirmed.copy()
    if not na(source.event)
        result.event := source.event.copy()
    if not na(source.strokeAnchor)
        result.strokeAnchor := source.strokeAnchor.copy()
    if not na(source.strokeEnd)
        result.strokeEnd := source.strokeEnd.copy()
    if not na(source.lastStrokeInput)
        result.lastStrokeInput := source.lastStrokeInput.copy()
    result.strokeCandidate := chan_structure_copy(source.strokeCandidate)
    result.strokeEvent := chan_structure_copy(source.strokeEvent)
    result.lastStroke := chan_structure_copy(source.lastStroke)
    result

chan_contains(int loA, int hiA, int loB, int hiB) =>
    (loA <= loB and hiA >= hiB) or (loB <= loA and hiB >= hiA)

chan_element(ChanState state, ChanRaw raw, int ordinal, int rawOrdinal) =>
    ChanElement.new(state.contextId + "/K/" + str.tostring(raw.openTime), ordinal, raw.openTime, raw.openTime, raw.highTicks, raw.lowTicks, raw.openTime, raw.openTime, rawOrdinal, rawOrdinal, false)

chan_fractal(ChanState state, int offset, int confirmedAt) =>
    ChanElement left = state.elements.get(offset)
    ChanElement middle = state.elements.get(offset + 1)
    ChanElement right = state.elements.get(offset + 2)
    bool top = middle.highTicks > left.highTicks and middle.highTicks > right.highTicks and middle.lowTicks > left.lowTicks and middle.lowTicks > right.lowTicks
    bool bottom = middle.highTicks < left.highTicks and middle.highTicks < right.highTicks and middle.lowTicks < left.lowTicks and middle.lowTicks < right.lowTicks
    ChanFractal result = na
    if top or bottom
        int kind = top ? 1 : -1
        result := ChanFractal.new(state.contextId + "/F/" + str.tostring(kind) + "/" + left.id + "/" + middle.id + "/" + right.id, kind, top ? middle.highTime : middle.lowTime, top ? middle.highTicks : middle.lowTicks, confirmedAt, left.id, middle.id, right.id, "F-001/F-002", left.ordinal, middle.ordinal, right.ordinal, middle.highTicks, middle.lowTicks)
    result

// P-001 is only a qualification predicate, not a stroke completion algorithm.
// The processed-element ordinals and member IDs survive raw containment merges.
chan_stroke_eligible(ChanFractal first, ChanFractal last) =>
    bool eligible = false
    if not na(first) and not na(last)
        if not na(first.confirmedAt) and not na(last.confirmedAt) and first.kind != last.kind and first.endpointTime < last.endpointTime and first.rightOrdinal + 1 < last.leftOrdinal
            ChanFractal top = first.kind == 1 ? first : last
            ChanFractal bottom = first.kind == -1 ? first : last
            eligible := top.middleHighTicks > bottom.middleHighTicks and top.priceTicks > bottom.priceTicks
    eligible

chan_fractal_signature(ChanFractal fractal) =>
    string result = "none"
    if not na(fractal)
        result := fractal.id + "/" + str.tostring(fractal.kind) + "/" + str.tostring(fractal.endpointTime) + "/" + str.tostring(fractal.priceTicks) + "/" + str.tostring(fractal.confirmedAt) + "/" + fractal.leftId + "/" + fractal.middleId + "/" + fractal.rightId + "/" + str.tostring(fractal.leftOrdinal) + "/" + str.tostring(fractal.middleOrdinal) + "/" + str.tostring(fractal.rightOrdinal) + "/" + str.tostring(fractal.middleHighTicks) + "/" + str.tostring(fractal.middleLowTicks)
    result

chan_structure_signature(ChanStructure source) =>
    string result = "none"
    if not na(source)
        result := source.id + "/" + source.objectType + "/" + str.tostring(source.level) + "/" + str.tostring(source.direction) + "/" + str.tostring(source.startTime) + "/" + str.tostring(source.endTime) + "/" + str.tostring(source.startTicks) + "/" + str.tostring(source.endTicks) + "/" + str.tostring(source.confirmed) + "/" + str.tostring(source.confirmedAt) + "/" + str.tostring(source.ordinal) + "/" + source.ruleId
        result += "/members/" + str.tostring(source.memberLowTicks) + "/" + str.tostring(source.memberHighTicks) + "/" + str.tostring(source.memberLowTime) + "/" + str.tostring(source.memberHighTime)
        if not na(source.dependencies)
            for dependency in source.dependencies
                result += "/" + dependency
    result

chan_stroke_make(ChanState state) =>
    ChanStructure result = ChanStructure.new()
    result.id := state.contextId + "/P/" + str.tostring(state.strokeCount + 1) + "/" + str.tostring(state.strokeAnchor.endpointTime)
    result.objectType := "stroke"
    result.level := 0
    result.direction := state.strokeAnchor.kind == -1 ? 1 : -1
    result.startTime := state.strokeAnchor.endpointTime
    result.endTime := state.strokeEnd.endpointTime
    result.startTicks := state.strokeAnchor.priceTicks
    result.endTicks := state.strokeEnd.priceTicks
    result.ruleId := "P-001/P-002"
    result.dependencies := array.from(state.strokeAnchor.id, state.strokeEnd.id)
    result.ordinal := state.strokeCount + 1
    result.memberLowTicks := math.min(result.startTicks, result.endTicks)
    result.memberHighTicks := math.max(result.startTicks, result.endTicks)
    result.memberLowTime := result.direction == 1 ? result.startTime : result.endTime
    result.memberHighTime := result.direction == 1 ? result.endTime : result.startTime
    result

chan_more_extreme(ChanFractal previous, ChanFractal incoming) =>
    incoming.kind == 1 ? incoming.priceTicks > previous.priceTicks : incoming.priceTicks < previous.priceTicks

// P-002: only a qualified next stroke locks the previous one. Equal extrema
// retain the first endpoint; rejected opposite fractals never create a turn.
chan_stroke_step(ChanState state, ChanFractal incoming) =>
    if na(incoming) or na(incoming.confirmedAt)
        runtime.error("成笔正式输入必须是已封口分型")
    state.strokeEvent := na
    bool duplicate = false
    if not na(state.lastStrokeInput)
        duplicate := state.lastStrokeInput.id == incoming.id
        if duplicate and chan_fractal_signature(state.lastStrokeInput) != chan_fractal_signature(incoming)
            runtime.error("已提交分型发生变化，需重载分析上下文")
        if not duplicate and (incoming.endpointTime <= state.lastStrokeInput.endpointTime or incoming.confirmedAt < state.lastStrokeInput.confirmedAt)
            runtime.error("成笔分型输入顺序无效")
    if not duplicate
        if na(state.strokeAnchor)
            state.strokeAnchor := incoming.copy()
        else if na(state.strokeEnd)
            if incoming.kind == state.strokeAnchor.kind
                if chan_more_extreme(state.strokeAnchor, incoming)
                    state.strokeAnchor := incoming.copy()
            else if chan_stroke_eligible(state.strokeAnchor, incoming)
                state.strokeEnd := incoming.copy()
                state.strokeCandidate := chan_stroke_make(state)
            else
                state.ignoredStrokeFractals += 1
        else if incoming.kind == state.strokeEnd.kind
            if chan_more_extreme(state.strokeEnd, incoming) and chan_stroke_eligible(state.strokeAnchor, incoming)
                state.strokeEnd := incoming.copy()
                state.strokeCandidate := chan_stroke_make(state)
        else if chan_stroke_eligible(state.strokeEnd, incoming)
            ChanStructure locked = chan_structure_copy(state.strokeCandidate)
            locked.confirmed := true
            locked.confirmedAt := incoming.confirmedAt
            locked.dependencies.push(incoming.id)
            state.strokeCount += 1
            state.lastStroke := locked
            state.strokeEvent := locked
            state.strokeAnchor := state.strokeEnd.copy()
            state.strokeEnd := incoming.copy()
            state.strokeCandidate := chan_stroke_make(state)
        else
            state.ignoredStrokeFractals += 1
        state.lastStrokeInput := incoming.copy()
    state

// Project an unsealed fractal only on a deep copy. lastStroke survives a later
// rejected preview input, unlike strokeEvent, which is cleared on every step.
chan_stroke_preview(ChanState source) =>
    ChanState result = chan_clone(source)
    if not na(source.candidate) and not na(source.lastRaw)
        ChanFractal tentative = source.candidate.copy()
        tentative.confirmedAt := source.lastRaw.closeTime
        chan_stroke_step(result, tentative)
    result

chan_stroke_pending(ChanState preview, int committedCount) =>
    ChanStructure result = na
    if preview.strokeCount > committedCount and not na(preview.lastStroke)
        result := chan_structure_copy(preview.lastStroke)
        result.confirmed := false
        result.confirmedAt := na
    result

// Consume one closed input, or one input in an isolated preview copy.
// At most four processed elements are needed for K/F; counts and source spans persist.
chan_step(ChanState state, ChanRaw raw) =>
    if na(raw.openTime) or na(raw.closeTime) or na(raw.openTicks) or na(raw.highTicks) or na(raw.lowTicks) or na(raw.closeTicks) or raw.openTime < 0 or raw.closeTime <= raw.openTime or raw.lowTicks > raw.highTicks or raw.openTicks < raw.lowTicks or raw.openTicks > raw.highTicks or raw.closeTicks < raw.lowTicks or raw.closeTicks > raw.highTicks
        runtime.error("K/F: invalid OHLC input")
    state.event := na
    state.strokeEvent := na
    bool duplicate = false
    if not na(state.lastRaw)
        if raw.openTime < state.lastRaw.openTime or (raw.openTime > state.lastRaw.openTime and raw.openTime < state.lastRaw.closeTime)
            runtime.error("K/F: inputs must be chronological")
        if raw.openTime == state.lastRaw.openTime
            duplicate := raw.closeTime == state.lastRaw.closeTime and raw.openTicks == state.lastRaw.openTicks and raw.highTicks == state.lastRaw.highTicks and raw.lowTicks == state.lastRaw.lowTicks and raw.closeTicks == state.lastRaw.closeTicks
            if not duplicate
                runtime.error("K/F: committed input changed; reload the context")
    if not duplicate
        state.inputCount += 1
        bool appended = false
        if state.direction == 0
            // E-001: compare adjacent original inputs; never invent an initial direction.
            if not na(state.seed)
                if not chan_contains(state.seed.lowTicks, state.seed.highTicks, raw.lowTicks, raw.highTicks)
                    state.contextId += "/seed/" + str.tostring(state.seed.openTime)
                    ChanElement first = chan_element(state, state.seed, 0, state.inputCount - 2)
                    first.sealed := true
                    state.elements.push(first)
                    state.elements.push(chan_element(state, raw, 1, state.inputCount - 1))
                    state.processedCount := 2
                    state.effectiveStart := state.seed.openTime
                    state.direction := raw.highTicks > state.seed.highTicks ? 1 : -1
                    appended := true
            state.seed := raw.copy()
        else
            ChanElement tail = state.elements.last()
            if chan_contains(tail.lowTicks, tail.highTicks, raw.lowTicks, raw.highTicks)
                int mergedHigh = state.direction == 1 ? math.max(tail.highTicks, raw.highTicks) : math.min(tail.highTicks, raw.highTicks)
                int mergedLow = state.direction == 1 ? math.max(tail.lowTicks, raw.lowTicks) : math.min(tail.lowTicks, raw.lowTicks)
                // E-002: equal extrema keep the earlier source independently.
                if mergedHigh != tail.highTicks
                    tail.highTime := raw.openTime
                if mergedLow != tail.lowTicks
                    tail.lowTime := raw.openTime
                tail.highTicks := mergedHigh
                tail.lowTicks := mergedLow
                tail.lastTime := raw.openTime
                tail.lastRaw := state.inputCount - 1
            else
                tail.sealed := true
                state.direction := raw.highTicks > tail.highTicks ? 1 : -1
                state.elements.push(chan_element(state, raw, state.processedCount, state.inputCount - 1))
                state.processedCount += 1
                appended := true
                if state.elements.size() > 4
                    state.elements.shift()
        int count = state.elements.size()
        if appended and count >= 4
            ChanFractal confirmed = chan_fractal(state, count - 4, raw.closeTime)
            if not na(confirmed)
                state.lastConfirmed := confirmed
                state.event := confirmed
                state.confirmedFractals += 1
                chan_stroke_step(state, confirmed)
        state.candidate := count >= 3 ? chan_fractal(state, count - 3, na) : na
        state.lastRaw := raw.copy()
    state

// Deterministic K/F snapshot for replay and clone-isolation assertions.
chan_signature(ChanState state) =>
    string result = state.contextId + "/" + str.tostring(state.inputCount) + "/" + str.tostring(state.processedCount) + "/" + str.tostring(state.direction) + "/" + str.tostring(state.effectiveStart) + "/" + str.tostring(state.confirmedFractals)
    if not na(state.seed)
        result += "/seed/" + str.tostring(state.seed.openTime) + "/" + str.tostring(state.seed.highTicks) + "/" + str.tostring(state.seed.lowTicks)
    if not na(state.lastRaw)
        result += "/raw/" + str.tostring(state.lastRaw.openTime) + "/" + str.tostring(state.lastRaw.closeTime) + "/" + str.tostring(state.lastRaw.openTicks) + "/" + str.tostring(state.lastRaw.highTicks) + "/" + str.tostring(state.lastRaw.lowTicks) + "/" + str.tostring(state.lastRaw.closeTicks)
    if state.elements.size() > 0
        for element in state.elements
            result += "/" + element.id + "/" + str.tostring(element.ordinal) + "/" + str.tostring(element.firstTime) + "/" + str.tostring(element.lastTime) + "/" + str.tostring(element.highTicks) + "/" + str.tostring(element.lowTicks) + "/" + str.tostring(element.highTime) + "/" + str.tostring(element.lowTime) + "/" + str.tostring(element.firstRaw) + "/" + str.tostring(element.lastRaw) + "/" + str.tostring(element.sealed)
    if not na(state.candidate)
        result += "/candidate/" + state.candidate.id + "/" + str.tostring(state.candidate.endpointTime) + "/" + str.tostring(state.candidate.priceTicks)
    if not na(state.lastConfirmed)
        result += "/confirmed/" + state.lastConfirmed.id + "/" + str.tostring(state.lastConfirmed.endpointTime) + "/" + str.tostring(state.lastConfirmed.priceTicks) + "/" + str.tostring(state.lastConfirmed.confirmedAt)
    if not na(state.event)
        result += "/event/" + state.event.id + "/" + str.tostring(state.event.confirmedAt)
    result += "/P/" + str.tostring(state.strokeCount) + "/" + str.tostring(state.ignoredStrokeFractals) + "/" + chan_fractal_signature(state.strokeAnchor) + "/" + chan_fractal_signature(state.strokeEnd) + "/" + chan_fractal_signature(state.lastStrokeInput)
    result += "/candidate/" + chan_structure_signature(state.strokeCandidate) + "/last/" + chan_structure_signature(state.lastStroke) + "/event/" + chan_structure_signature(state.strokeEvent)
    result
// S-001/S-002/S-003: a standard feature sequence is a context-specific view of
// locked strokes. A sequence or feature turn alone never confirms a segment.
chan_segment_seed(ChanStructure first, ChanStructure middle, ChanStructure third) =>
    bool eligible = false
    if not na(first) and not na(middle) and not na(third)
        bool locked = first.objectType == "stroke" and middle.objectType == "stroke" and third.objectType == "stroke" and first.confirmed and middle.confirmed and third.confirmed and not na(first.confirmedAt) and not na(middle.confirmedAt) and not na(third.confirmedAt)
        bool connected = first.endTime == middle.startTime and middle.endTime == third.startTime and first.endTicks == middle.startTicks and middle.endTicks == third.startTicks and first.ordinal + 1 == middle.ordinal and middle.ordinal + 1 == third.ordinal
        bool alternating = (first.direction == 1 or first.direction == -1) and middle.direction == -first.direction and third.direction == first.direction
        bool causal = first.startTime < first.endTime and middle.startTime < middle.endTime and third.startTime < third.endTime and first.confirmedAt >= first.endTime and middle.confirmedAt >= middle.endTime and third.confirmedAt >= third.endTime and first.confirmedAt <= middle.confirmedAt and middle.confirmedAt <= third.confirmedAt
        bool prices = first.direction * (first.endTicks - first.startTicks) > 0 and middle.direction * (middle.endTicks - middle.startTicks) > 0 and third.direction * (third.endTicks - third.startTicks) > 0
        int commonLow = math.max(math.min(first.startTicks, first.endTicks), math.max(math.min(middle.startTicks, middle.endTicks), math.min(third.startTicks, third.endTicks)))
        int commonHigh = math.min(math.max(first.startTicks, first.endTicks), math.min(math.max(middle.startTicks, middle.endTicks), math.max(third.startTicks, third.endTicks)))
        eligible := locked and connected and alternating and causal and prices and commonLow <= commonHigh and first.direction * (third.endTicks - first.startTicks) > 0
    eligible

type ChanFeature
    string id
    int lowTicks
    int highTicks
    int lowTime
    int highTime
    int firstTime
    int lastTime
    int firstOrdinal
    int lastOrdinal
    int firstSide
    int lastSide
    int availableAt
    bool sealed = false
    array<string> sourceIds

type ChanFeatureSequence
    string contextId
    int segmentDirection
    int mergeDirection
    int postDirection
    int boundaryTime
    bool secondSequence
    array<ChanFeature> elements
    ChanStructure lastInput
    ChanStructure heldInput
    int inputCount = 0
    int selectedCount = 0
    int boundaryCuts = 0
    int maxElements = 128
    int maxSources = 512
    bool waitingDirection = false
    bool blocked = false

type ChanFeatureTurn
    int kind
    int endpointTime
    int priceTicks
    int availableAt
    string leftId
    string middleId
    string rightId
    bool gap
    bool rightSealed

chan_feature_new(string contextId, int segmentDirection, int initialDirection, int postDirection, int boundaryTime, bool secondSequence, int maxElements, int maxSources) =>
    if (segmentDirection != 1 and segmentDirection != -1) or initialDirection < -1 or initialDirection > 1 or postDirection < -1 or postDirection > 1 or maxElements < 1 or maxSources < 1
        runtime.error("特征序列上下文无效")
    ChanFeatureSequence result = ChanFeatureSequence.new()
    result.contextId := contextId
    result.segmentDirection := segmentDirection
    result.mergeDirection := initialDirection
    result.postDirection := postDirection
    result.boundaryTime := boundaryTime
    result.secondSequence := secondSequence
    result.maxElements := maxElements
    result.maxSources := maxSources
    result.elements := array.new<ChanFeature>()
    result

chan_feature_clone(ChanFeatureSequence source) =>
    ChanFeatureSequence result = source.copy()
    result.elements := array.new<ChanFeature>()
    for element in source.elements
        ChanFeature copied = element.copy()
        copied.sourceIds := element.sourceIds.copy()
        result.elements.push(copied)
    result.lastInput := chan_structure_copy(source.lastInput)
    result.heldInput := chan_structure_copy(source.heldInput)
    result

chan_feature_step(ChanFeatureSequence state, ChanStructure stroke) =>
    if na(stroke) or stroke.objectType != "stroke" or not stroke.confirmed or na(stroke.confirmedAt) or na(stroke.startTime) or na(stroke.endTime) or na(stroke.startTicks) or na(stroke.endTicks) or stroke.endTime <= stroke.startTime or stroke.confirmedAt < stroke.endTime or (stroke.direction != 1 and stroke.direction != -1) or stroke.direction * (stroke.endTicks - stroke.startTicks) <= 0
        runtime.error("特征序列仅消费合法已锁定笔")
    if not na(state.boundaryTime) and stroke.startTime < state.boundaryTime and stroke.endTime > state.boundaryTime
        runtime.error("假设分界必须位于笔端点")
    bool duplicate = false
    if not na(state.lastInput)
        duplicate := stroke.id == state.lastInput.id
        if duplicate and chan_structure_signature(stroke) != chan_structure_signature(state.lastInput)
            runtime.error("已消费笔发生变化")
        if not duplicate and (stroke.startTime < state.lastInput.endTime or stroke.confirmedAt < state.lastInput.confirmedAt or stroke.ordinal <= state.lastInput.ordinal)
            runtime.error("特征序列输入顺序无效")
    if not duplicate and not state.blocked and not state.waitingDirection
        bool selected = stroke.direction == -state.segmentDirection
        if selected
            int side = not na(state.boundaryTime) and stroke.startTime >= state.boundaryTime ? 1 : 0
            ChanFeature incoming = ChanFeature.new()
            incoming.id := state.contextId + "/E/" + stroke.id
            incoming.lowTicks := math.min(stroke.startTicks, stroke.endTicks)
            incoming.highTicks := math.max(stroke.startTicks, stroke.endTicks)
            incoming.lowTime := stroke.direction == 1 ? stroke.startTime : stroke.endTime
            incoming.highTime := stroke.direction == 1 ? stroke.endTime : stroke.startTime
            incoming.firstTime := stroke.startTime
            incoming.lastTime := stroke.endTime
            incoming.firstOrdinal := stroke.ordinal
            incoming.lastOrdinal := stroke.ordinal
            incoming.firstSide := side
            incoming.lastSide := side
            incoming.availableAt := stroke.confirmedAt
            incoming.sourceIds := array.from(stroke.id)
            ChanFeature tail = state.elements.size() > 0 ? state.elements.last() : na
            bool contained = not na(tail) and chan_contains(tail.lowTicks, tail.highTicks, incoming.lowTicks, incoming.highTicks)
            bool crosses = not na(tail) and tail.lastSide != side
            bool split = crosses and not state.secondSequence
            bool merge = contained and not split
            if state.selectedCount >= state.maxSources or (not merge and state.elements.size() >= state.maxElements)
                state.blocked := true
                state.heldInput := chan_structure_copy(stroke)
            else if merge and state.mergeDirection == 0
                // Preserve the unresolved input. A caller must supply evidenced
                // prior direction and rebuild; never guess from this inclusion.
                state.waitingDirection := true
                state.heldInput := chan_structure_copy(stroke)
                state.inputCount += 1
                state.selectedCount += 1
                state.lastInput := chan_structure_copy(stroke)
            else
                state.selectedCount += 1
                if merge
                    int highTicks = state.mergeDirection == 1 ? math.max(tail.highTicks, incoming.highTicks) : math.min(tail.highTicks, incoming.highTicks)
                    int lowTicks = state.mergeDirection == 1 ? math.max(tail.lowTicks, incoming.lowTicks) : math.min(tail.lowTicks, incoming.lowTicks)
                    if highTicks != tail.highTicks
                        tail.highTime := incoming.highTime
                    if lowTicks != tail.lowTicks
                        tail.lowTime := incoming.lowTime
                    tail.highTicks := highTicks
                    tail.lowTicks := lowTicks
                    tail.lastTime := incoming.lastTime
                    tail.lastOrdinal := incoming.lastOrdinal
                    tail.lastSide := side
                    tail.availableAt := math.max(tail.availableAt, incoming.availableAt)
                    tail.sourceIds.push(stroke.id)
                else
                    if not na(tail)
                        tail.sealed := true
                        if contained and split
                            state.boundaryCuts += 1
                            state.mergeDirection := state.postDirection
                        else
                            state.mergeDirection := incoming.highTicks > tail.highTicks ? 1 : -1
                    state.elements.push(incoming)
                state.inputCount += 1
                state.lastInput := chan_structure_copy(stroke)
        else
            state.inputCount += 1
            state.lastInput := chan_structure_copy(stroke)
    state

// Geometry and gap diagnostics only: segment start, break proof, ownership,
// dependency validity and a sealed right element still belong to the S machine.
chan_feature_turn(ChanFeatureSequence state) =>
    ChanFeatureTurn result = na
    int count = state.elements.size()
    if count >= 3 and not state.blocked and not state.waitingDirection
        ChanFeature left = state.elements.get(count - 3)
        ChanFeature middle = state.elements.get(count - 2)
        ChanFeature right = state.elements.get(count - 1)
        bool top = middle.highTicks > left.highTicks and middle.highTicks > right.highTicks and middle.lowTicks > left.lowTicks and middle.lowTicks > right.lowTicks
        bool bottom = middle.highTicks < left.highTicks and middle.highTicks < right.highTicks and middle.lowTicks < left.lowTicks and middle.lowTicks < right.lowTicks
        if (state.segmentDirection == 1 and top) or (state.segmentDirection == -1 and bottom)
            bool gap = state.segmentDirection == 1 ? left.highTicks < middle.lowTicks : middle.highTicks < left.lowTicks
            result := ChanFeatureTurn.new(state.segmentDirection, state.segmentDirection == 1 ? middle.highTime : middle.lowTime, state.segmentDirection == 1 ? middle.highTicks : middle.lowTicks, math.max(left.availableAt, math.max(middle.availableAt, right.availableAt)), left.id, middle.id, right.id, gap, right.sealed)
    result

chan_feature_signature(ChanFeatureSequence state) =>
    string result = state.contextId + "/" + str.tostring(state.segmentDirection) + "/" + str.tostring(state.mergeDirection) + "/" + str.tostring(state.postDirection) + "/" + str.tostring(state.boundaryTime) + "/" + str.tostring(state.secondSequence) + "/" + str.tostring(state.maxElements) + "/" + str.tostring(state.maxSources) + "/" + str.tostring(state.inputCount) + "/" + str.tostring(state.selectedCount) + "/" + str.tostring(state.boundaryCuts) + "/" + str.tostring(state.waitingDirection) + "/" + str.tostring(state.blocked)
    for element in state.elements
        result += "/" + element.id + "/" + str.tostring(element.lowTicks) + "/" + str.tostring(element.highTicks) + "/" + str.tostring(element.lowTime) + "/" + str.tostring(element.highTime) + "/" + str.tostring(element.firstTime) + "/" + str.tostring(element.lastTime) + "/" + str.tostring(element.firstOrdinal) + "/" + str.tostring(element.lastOrdinal) + "/" + str.tostring(element.firstSide) + "/" + str.tostring(element.lastSide) + "/" + str.tostring(element.availableAt) + "/" + str.tostring(element.sealed)
        for sourceId in element.sourceIds
            result += "/" + sourceId
    result + "/last/" + chan_structure_signature(state.lastInput) + "/held/" + chan_structure_signature(state.heldInput)
// S proofs operate on a bounded suffix of locked strokes. They are rebuilt from
// those facts; neither drawings nor hypothetical child names are input facts.
type ChanSegmentProof
    int kind = 0
    int endIndex = na
    int childEndIndex = na
    int proofIndex = na
    bool firstBreakActive = false
    ChanFeatureSequence firstContext
    ChanFeatureSequence secondContext

type ChanSegmentHypothesis
    string endStrokeId
    int endTime
    int priceTicks
    int proofKind
    bool gapPending

type ChanSegmentState
    string contextId
    array<ChanStructure> strokes
    array<ChanStructure> events
    array<ChanSegmentHypothesis> hypotheses
    ChanStructure lastInput
    ChanStructure heldInput
    ChanStructure lastSegment
    ChanStructure candidate
    ChanFeatureSequence firstContext
    ChanFeatureSequence secondContext
    int inputCount = 0
    int segmentCount = 0
    int skippedInputs = 0
    int maxPending = 64
    int maxWork = 8192
    bool blocked = false
    bool gapPending = false
    string limitReason = ""

chan_segment_new(string contextId, int maxPending, int maxWork) =>
    if maxPending < 6 or maxWork < 1
        runtime.error("线段依赖预算无效")
    ChanSegmentState state = ChanSegmentState.new()
    state.contextId := contextId
    state.maxPending := maxPending
    state.maxWork := maxWork
    state.strokes := array.new<ChanStructure>()
    state.events := array.new<ChanStructure>()
    state.hypotheses := array.new<ChanSegmentHypothesis>()
    state

chan_segment_clone(ChanSegmentState source) =>
    ChanSegmentState result = source.copy()
    result.strokes := array.new<ChanStructure>()
    for stroke in source.strokes
        result.strokes.push(chan_structure_copy(stroke))
    result.events := array.new<ChanStructure>()
    for event in source.events
        result.events.push(chan_structure_copy(event))
    result.hypotheses := array.new<ChanSegmentHypothesis>()
    for hypothesis in source.hypotheses
        result.hypotheses.push(hypothesis.copy())
    result.lastInput := chan_structure_copy(source.lastInput)
    result.heldInput := chan_structure_copy(source.heldInput)
    result.lastSegment := chan_structure_copy(source.lastSegment)
    result.candidate := chan_structure_copy(source.candidate)
    if not na(source.firstContext)
        result.firstContext := chan_feature_clone(source.firstContext)
    if not na(source.secondContext)
        result.secondContext := chan_feature_clone(source.secondContext)
    result

chan_segment_span(array<ChanStructure> strokes, int firstIndex, int lastIndex) =>
    bool eligible = false
    if firstIndex >= 0 and lastIndex < strokes.size() and lastIndex - firstIndex >= 2 and (lastIndex - firstIndex) % 2 == 0
        ChanStructure first = strokes.get(firstIndex)
        ChanStructure last = strokes.get(lastIndex)
        eligible := chan_segment_seed(first, strokes.get(firstIndex + 1), strokes.get(firstIndex + 2)) and last.direction == first.direction and first.direction * (last.endTicks - first.startTicks) > 0
    eligible

chan_segment_probe(array<ChanStructure> strokes, int endIndex, string contextId) =>
    ChanSegmentProof result = ChanSegmentProof.new()
    result.endIndex := endIndex
    int count = strokes.size()
    if chan_segment_span(strokes, 0, endIndex) and endIndex + 3 < count
        ChanStructure endpoint = strokes.get(endIndex)
        ChanStructure firstBreak = strokes.get(endIndex + 1)
        int direction = strokes.first().direction
        int reverse = -direction
        // The legal three-stroke seed provides the direction of this hypothesis.
        // E-007 makes the initial context explicit; it is not a locked segment.
        ChanFeatureSequence first = chan_feature_new(contextId + "/first", direction, direction, reverse, endpoint.endTime, false, 128, 512)
        ChanFeatureSequence reverseSequence = chan_feature_new(contextId + "/second", reverse, reverse, direction, endpoint.endTime, true, 128, 512)
        for i = 0 to endIndex
            first := chan_feature_step(first, strokes.get(i))
        // C65 p169: d[j] <= g[i] / g[j] >= d[i], j >= i+2.
        // The first breaking stroke is identified from the original owned
        // pivots, not the already-compressed feature element's other extreme.
        int breakBoundary = strokes.first().endTicks
        for i = 0 to endIndex - 2 by 2
            int pivot = strokes.get(i).endTicks
            breakBoundary := direction == 1 ? math.max(breakBoundary, pivot) : math.min(breakBoundary, pivot)
        bool directBreak = direction == 1 ? firstBreak.endTicks <= breakBoundary : firstBreak.endTicks >= breakBoundary
        int invalidIndex = na
        for i = endIndex + 1 to count - 1
            ChanStructure inputStroke = strokes.get(i)
            first := chan_feature_step(first, inputStroke)
            reverseSequence := chan_feature_step(reverseSequence, inputStroke)
            if na(invalidIndex) and direction * (inputStroke.endTicks - endpoint.endTicks) > 0
                invalidIndex := i
            bool stillEligible = na(invalidIndex) or invalidIndex == i
            if stillEligible
                bool reverseSpan = chan_segment_span(strokes, endIndex + 1, i)
                bool directProof = directBreak and reverseSpan and reverse * (inputStroke.endTicks - firstBreak.endTicks) > 0
                ChanFeatureTurn firstTurn = chan_feature_turn(first)
                bool targetTurn = not na(firstTurn) and firstTurn.endpointTime == endpoint.endTime and firstTurn.priceTicks == endpoint.endTicks
                // When the very first counter-stroke already breaks the old
                // segment, an inside third stroke must wait (C71 p181-182).
                // Later inclusion must not manufacture an earlier end proof.
                if directProof or (not directBreak and targetTurn and not firstTurn.gap and reverseSpan)
                    result.kind := 1
                    result.proofIndex := i
                else if targetTurn and firstTurn.gap
                    ChanFeatureTurn secondTurn = chan_feature_turn(reverseSequence)
                    if not na(secondTurn)
                        int childEnd = na
                        for j = endIndex + 3 to i
                            ChanStructure child = strokes.get(j)
                            if child.endTime == secondTurn.endpointTime and child.endTicks == secondTurn.priceTicks and child.direction == reverse
                                childEnd := j
                        if not na(childEnd)
                            if chan_segment_span(strokes, endIndex + 1, childEnd) and chan_segment_span(strokes, childEnd + 1, i)
                                result.kind := 2
                                result.childEndIndex := childEnd
                                result.proofIndex := i
            if result.kind > 0
                break
            if not na(invalidIndex)
                result.kind := -1
                break
        // An unresolved first breaking stroke governs the whole suffix, not
        // only this endpoint's local test. A later inner turn cannot rename
        // its own counter-stroke and bypass that outstanding direction proof.
        // Keep the barrier on the proving input too, so a retrospectively
        // cheaper inner proof cannot beat the governing endpoint's proof.
        result.firstBreakActive := directBreak and result.kind >= 0
        result.firstContext := first
        result.secondContext := reverseSequence
    result

chan_segment_record(ChanSegmentState state, int firstIndex, int lastIndex, int proofIndex, int confirmedAt, string ruleId) =>
    ChanStructure first = state.strokes.get(firstIndex)
    ChanStructure last = state.strokes.get(lastIndex)
    ChanStructure result = ChanStructure.new()
    result.id := state.contextId + "/S/" + str.tostring(state.segmentCount + 1) + "/" + str.tostring(first.startTime)
    result.objectType := "segment"
    result.level := 0
    result.direction := first.direction
    result.startTime := first.startTime
    result.endTime := last.endTime
    result.startTicks := first.startTicks
    result.endTicks := last.endTicks
    result.confirmed := not na(confirmedAt)
    result.confirmedAt := confirmedAt
    result.ruleId := ruleId
    result.ordinal := state.segmentCount + 1
    result.dependencies := array.new<string>()
    // Retain extrema of owned stroke endpoints before releasing those strokes.
    // Proof-only strokes do not contribute; raw-OHLC normalization remains N.
    result.memberLowTicks := first.startTicks
    result.memberHighTicks := first.startTicks
    result.memberLowTime := first.startTime
    result.memberHighTime := first.startTime
    for i = firstIndex to lastIndex
        ChanStructure member = state.strokes.get(i)
        if member.endTicks < result.memberLowTicks
            result.memberLowTicks := member.endTicks
            result.memberLowTime := member.endTime
        if member.endTicks > result.memberHighTicks
            result.memberHighTicks := member.endTicks
            result.memberHighTime := member.endTime
    for i = firstIndex to proofIndex
        result.dependencies.push(state.strokes.get(i).id)
    result

chan_segment_emit(ChanSegmentState state, ChanStructure segment) =>
    state.segmentCount += 1
    state.lastSegment := segment
    state.events.push(segment)
    true

// Return a new state: quota failure rolls back the entire input's proposed
// confirmations, preserving the locked prefix and the unconsumed held input.
chan_segment_step(ChanSegmentState source, ChanStructure stroke) =>
    if na(stroke) or stroke.objectType != "stroke" or not stroke.confirmed or na(stroke.confirmedAt) or na(stroke.startTime) or na(stroke.endTime) or na(stroke.startTicks) or na(stroke.endTicks) or stroke.endTime <= stroke.startTime or stroke.confirmedAt < stroke.endTime or (stroke.direction != 1 and stroke.direction != -1) or stroke.direction * (stroke.endTicks - stroke.startTicks) <= 0
        runtime.error("线段仅消费已锁定合法笔")
    ChanSegmentState state = chan_segment_clone(source)
    state.events := array.new<ChanStructure>()
    bool duplicate = false
    if not na(source.lastInput)
        duplicate := stroke.id == source.lastInput.id
        if duplicate and chan_structure_signature(stroke) != chan_structure_signature(source.lastInput)
            runtime.error("线段已消费笔发生变化")
        if not duplicate and not source.blocked and (stroke.startTime != source.lastInput.endTime or stroke.startTicks != source.lastInput.endTicks or stroke.ordinal != source.lastInput.ordinal + 1 or stroke.direction != -source.lastInput.direction or stroke.confirmedAt < source.lastInput.confirmedAt)
            runtime.error("线段笔输入不连续")
    if not duplicate and not source.blocked
        if source.strokes.size() >= source.maxPending
            state.blocked := true
            state.limitReason := "pending-strokes"
            state.heldInput := chan_structure_copy(stroke)
        else
            state.strokes.push(chan_structure_copy(stroke))
            state.lastInput := chan_structure_copy(stroke)
            state.inputCount += 1
            int work = 0
            bool advance = true
            while advance
                advance := false
                state.hypotheses := array.new<ChanSegmentHypothesis>()
                state.firstContext := na
                state.secondContext := na
                state.gapPending := false
                // An impossible initial triple cannot become legal retroactively.
                while state.strokes.size() >= 3 and not chan_segment_span(state.strokes, 0, 2)
                    if state.segmentCount > 0
                        runtime.error("已锁定段后的续部起始依赖不合规")
                    state.strokes.shift()
                    state.skippedInputs += 1
                int count = state.strokes.size()
                ChanSegmentProof best = na
                if count >= 6
                    for endIndex = 2 to count - 4 by 2
                        if chan_segment_span(state.strokes, 0, endIndex)
                            work += count * 2
                            if work > state.maxWork
                                state.blocked := true
                                break
                            string hypothesisId = state.contextId + "/turn/" + state.strokes.get(endIndex).id
                            ChanSegmentProof proof = chan_segment_probe(state.strokes, endIndex, hypothesisId)
                            if proof.kind >= 0
                                ChanFeatureTurn turn = not na(proof.firstContext) ? chan_feature_turn(proof.firstContext) : na
                                bool pending = not na(turn) and turn.gap
                                state.gapPending := state.gapPending or pending
                                ChanStructure endpoint = state.strokes.get(endIndex)
                                state.hypotheses.push(ChanSegmentHypothesis.new(endpoint.id, endpoint.endTime, endpoint.endTicks, proof.kind, pending))
                                if na(state.firstContext)
                                    state.firstContext := proof.firstContext
                                    state.secondContext := proof.secondContext
                                if proof.kind > 0
                                    if na(best)
                                        best := proof
                                    else if proof.proofIndex < best.proofIndex
                                        best := proof
                                if proof.firstBreakActive
                                    break
                if state.blocked
                    // Keep no partial event from this input, even after a chain.
                    state := chan_segment_clone(source)
                    state.events := array.new<ChanStructure>()
                    state.blocked := true
                    state.limitReason := "probe-work"
                    state.heldInput := chan_structure_copy(stroke)
                else if not na(best)
                    string ruleId = best.kind == 1 ? "S-001/S-002/E-007" : "S-001/S-003/E-007"
                    ChanStructure completed = chan_segment_record(state, 0, best.endIndex, best.proofIndex, stroke.confirmedAt, ruleId)
                    if best.proofIndex < count - 1 and state.segmentCount > source.segmentCount
                        completed.dependencies.push(state.lastSegment.id)
                    chan_segment_emit(state, completed)
                    int lastLockedIndex = best.endIndex
                    if best.kind == 2
                        ChanStructure child = chan_segment_record(state, best.endIndex + 1, best.childEndIndex, best.proofIndex, stroke.confirmedAt, "S-001/S-003/E-007")
                        chan_segment_emit(state, child)
                        lastLockedIndex := best.childEndIndex
                    for i = 0 to lastLockedIndex
                        state.strokes.shift()
                    advance := true
                else
                    state.candidate := na
                    if count >= 3
                        int selected = 2
                        int direction = state.strokes.first().direction
                        for i = 2 to count - 1 by 2
                            if chan_segment_span(state.strokes, 0, i)
                                if direction * (state.strokes.get(i).endTicks - state.strokes.get(selected).endTicks) > 0
                                    selected := i
                        state.candidate := chan_segment_record(state, 0, selected, selected, na, "S-001/E-007")
    state

chan_segment_signature(ChanSegmentState state) =>
    string result = state.contextId + "/" + str.tostring(state.segmentCount) + "/" + str.tostring(state.inputCount) + "/" + str.tostring(state.skippedInputs) + "/" + str.tostring(state.maxPending) + "/" + str.tostring(state.maxWork) + "/" + str.tostring(state.blocked) + "/" + str.tostring(state.gapPending) + "/" + state.limitReason
    for stroke in state.strokes
        result += "/P/" + chan_structure_signature(stroke)
    for event in state.events
        result += "/event/" + chan_structure_signature(event)
    for hypothesis in state.hypotheses
        result += "/hypothesis/" + hypothesis.endStrokeId + "/" + str.tostring(hypothesis.endTime) + "/" + str.tostring(hypothesis.priceTicks) + "/" + str.tostring(hypothesis.proofKind) + "/" + str.tostring(hypothesis.gapPending)
    if not na(state.firstContext)
        result += "/first/" + chan_feature_signature(state.firstContext)
    if not na(state.secondContext)
        result += "/second/" + chan_feature_signature(state.secondContext)
    result + "/last/" + chan_structure_signature(state.lastInput) + "/held/" + chan_structure_signature(state.heldInput) + "/locked/" + chan_structure_signature(state.lastSegment) + "/candidate/" + chan_structure_signature(state.candidate)
// N consumes only committed segment events. Each segment owns its own range;
// geometric time anchors and actual extreme source times are separate (E-008).
type ChanNormalizationState
    string contextId
    int count = 0
    ChanStructure lastInput
    ChanComponent lastComponent
    ChanComponent event

chan_component_copy(ChanComponent source) =>
    ChanComponent result = na
    if not na(source)
        result := source.copy()
        result.dependencies := source.dependencies.copy()
    result

chan_component_signature(ChanComponent source) =>
    string result = "na"
    if not na(source)
        result := source.id + "/" + source.segmentId + "/" + str.tostring(source.realStartTime) + "/" + str.tostring(source.realEndTime) + "/" + str.tostring(source.realStartTicks) + "/" + str.tostring(source.realEndTicks) + "/" + str.tostring(source.actualLowTicks) + "/" + str.tostring(source.actualHighTicks) + "/" + str.tostring(source.actualLowTime) + "/" + str.tostring(source.actualHighTime) + "/" + str.tostring(source.analysisStartTime) + "/" + str.tostring(source.analysisEndTime) + "/" + str.tostring(source.analysisStartTicks) + "/" + str.tostring(source.analysisEndTicks) + "/" + str.tostring(source.direction) + "/" + str.tostring(source.confirmedAt) + "/" + source.ruleId + "/" + str.tostring(source.ordinal)
        for dependency in source.dependencies
            result += "/" + dependency
    result

chan_normalization_new(string contextId) =>
    ChanNormalizationState result = ChanNormalizationState.new()
    result.contextId := contextId
    result

chan_normalization_clone(ChanNormalizationState source) =>
    ChanNormalizationState result = source.copy()
    result.lastInput := chan_structure_copy(source.lastInput)
    result.lastComponent := chan_component_copy(source.lastComponent)
    result.event := chan_component_copy(source.event)
    result

chan_normalization_signature(ChanNormalizationState source) =>
    source.contextId + "/" + str.tostring(source.count) + "/" + chan_structure_signature(source.lastInput) + "/" + chan_component_signature(source.lastComponent) + "/" + chan_component_signature(source.event)

chan_normalization_valid(ChanStructure source) =>
    bool valid = false
    if not na(source)
        valid := source.objectType == "segment" and source.level == 0 and source.confirmed and not na(source.confirmedAt) and not na(source.id) and source.id != "" and source.ordinal > 0 and (source.direction == 1 or source.direction == -1) and source.startTime < source.endTime and source.confirmedAt >= source.endTime and source.direction * (source.endTicks - source.startTicks) > 0
        valid := valid and not na(source.memberLowTicks) and not na(source.memberHighTicks) and source.memberLowTicks < source.memberHighTicks and source.memberLowTicks <= math.min(source.startTicks, source.endTicks) and source.memberHighTicks >= math.max(source.startTicks, source.endTicks)
        valid := valid and source.memberLowTime >= source.startTime and source.memberLowTime <= source.endTime and source.memberHighTime >= source.startTime and source.memberHighTime <= source.endTime and not na(source.dependencies)
    valid

chan_normalization_step(ChanNormalizationState source, ChanStructure segment) =>
    if not chan_normalization_valid(segment)
        runtime.error("标准化仅消费具备归属极值摘要的确认线段")
    ChanNormalizationState state = chan_normalization_clone(source)
    state.event := na
    bool duplicate = not na(source.lastInput) and segment.id == source.lastInput.id
    if duplicate
        if chan_structure_signature(segment) != chan_structure_signature(source.lastInput)
            runtime.error("已标准化线段发生变化")
    else
        if segment.ordinal != source.count + 1
            runtime.error("标准化线段序号不连续")
        if not na(source.lastInput)
            if segment.startTime != source.lastInput.endTime or segment.startTicks != source.lastInput.endTicks or segment.direction != -source.lastInput.direction or segment.confirmedAt < source.lastInput.confirmedAt
                runtime.error("标准化线段输入不连续")
        ChanComponent component = ChanComponent.new()
        component.id := source.contextId + "/N/" + str.tostring(segment.ordinal) + "/" + str.tostring(segment.startTime)
        component.segmentId := segment.id
        component.realStartTime := segment.startTime
        component.realEndTime := segment.endTime
        component.realStartTicks := segment.startTicks
        component.realEndTicks := segment.endTicks
        component.actualLowTicks := segment.memberLowTicks
        component.actualHighTicks := segment.memberHighTicks
        component.actualLowTime := segment.memberLowTime
        component.actualHighTime := segment.memberHighTime
        component.analysisStartTime := segment.startTime
        component.analysisEndTime := segment.endTime
        component.analysisStartTicks := segment.direction == 1 ? segment.memberLowTicks : segment.memberHighTicks
        component.analysisEndTicks := segment.direction == 1 ? segment.memberHighTicks : segment.memberLowTicks
        component.direction := segment.direction
        component.confirmedAt := segment.confirmedAt
        component.ruleId := "N-001/E-008"
        component.dependencies := array.from(segment.id)
        component.ordinal := segment.ordinal
        state.count += 1
        state.lastInput := chan_structure_copy(segment)
        state.lastComponent := component
        state.event := component
    state
// L1 center chain. Relation snapshots never emit R completion or L2 input.
type ChanCenterState
    string contextId
    array<ChanComponent> seed
    ChanComponent lastInput
    ChanComponent counter
    ChanComponent heldInput
    ChanCenter center
    ChanCenter event
    int inputCount = 0
    int direction = 0
    int waves = 0
    int maxSources = 64
    int level = 1
    bool waitingRelation = false
    bool blocked = false

    ChanComponent pendingLeave
    ChanCenter previous
    ChanCenter closedEvent
    array<ChanCenter> history
    int count = 0
    string relationKind = "none"
    int relationAt = na

chan_center_copy(ChanCenter source) =>
    ChanCenter result = na
    if not na(source)
        result := source.copy()
        result.dependencies := source.dependencies.copy()
    result

chan_center_new_level(string contextId, int maxSources, int level) =>
    if maxSources < 3
        runtime.error("中枢来源预算至少为3")
    if level < 1 or level > 3
        runtime.error("中枢层级只支持1到3")
    ChanCenterState result = ChanCenterState.new()
    result.contextId := contextId
    result.maxSources := maxSources
    result.level := level
    result.seed := array.new<ChanComponent>()
    result.history := array.new<ChanCenter>()
    result

chan_center_new(string contextId, int maxSources) =>
    chan_center_new_level(contextId, maxSources, 1)

chan_center_clone(ChanCenterState source) =>
    ChanCenterState result = source.copy()
    result.seed := array.new<ChanComponent>()
    for member in source.seed
        result.seed.push(chan_component_copy(member))
    result.lastInput := chan_component_copy(source.lastInput)
    result.counter := chan_component_copy(source.counter)
    result.heldInput := chan_component_copy(source.heldInput)
    result.center := chan_center_copy(source.center)
    result.event := chan_center_copy(source.event)
    result.pendingLeave := chan_component_copy(source.pendingLeave)
    result.previous := chan_center_copy(source.previous)
    result.closedEvent := chan_center_copy(source.closedEvent)
    result.history := array.new<ChanCenter>()
    for center in source.history
        result.history.push(chan_center_copy(center))
    result

chan_center_record_signature(ChanCenter source) =>
    string result = "na"
    if not na(source)
        result := source.id + "/" + str.tostring(source.level) + "/" + str.tostring(source.coreLowTicks) + "/" + str.tostring(source.coreHighTicks) + "/" + str.tostring(source.ggTicks) + "/" + str.tostring(source.gTicks) + "/" + str.tostring(source.dTicks) + "/" + str.tostring(source.ddTicks) + "/" + str.tostring(source.startTime) + "/" + str.tostring(source.formedAt) + "/" + str.tostring(source.extentEndTime) + "/" + str.tostring(source.confirmedAt) + "/" + str.tostring(source.degenerate) + "/" + source.lifecycle + "/" + source.ruleId + "/" + str.tostring(source.ordinal)
        for dependency in source.dependencies
            result += "/" + dependency
        result += "/closure/" + str.tostring(source.zWaves) + "/" + str.tostring(source.closedAt) + "/" + source.leaveId + "/" + source.returnId
    result

chan_center_signature(ChanCenterState source) =>
    string result = source.contextId + "/" + str.tostring(source.inputCount) + "/" + str.tostring(source.direction) + "/" + str.tostring(source.waves) + "/" + str.tostring(source.maxSources) + "/L" + str.tostring(source.level) + "/" + str.tostring(source.waitingRelation) + "/" + str.tostring(source.blocked)
    for member in source.seed
        result += "/seed/" + chan_component_signature(member)
    result += "/chain/" + str.tostring(source.count) + "/" + source.relationKind + "/" + str.tostring(source.relationAt) + "/" + chan_component_signature(source.pendingLeave) + "/" + chan_center_record_signature(source.previous) + "/" + chan_center_record_signature(source.closedEvent)
    for center in source.history
        result += "/history/" + chan_center_record_signature(center)
    result + "/last/" + chan_component_signature(source.lastInput) + "/counter/" + chan_component_signature(source.counter) + "/held/" + chan_component_signature(source.heldInput) + "/center/" + chan_center_record_signature(source.center) + "/event/" + chan_center_record_signature(source.event)

chan_center_valid(ChanComponent component) =>
    bool valid = false
    if not na(component)
        valid := not na(component.confirmedAt) and component.confirmedAt >= component.realEndTime and component.realStartTime < component.realEndTime and component.actualLowTicks < component.actualHighTicks and (component.direction == 1 or component.direction == -1) and component.direction * (component.realEndTicks - component.realStartTicks) > 0 and component.ordinal > 0
        valid := valid and component.actualLowTicks <= math.min(component.realStartTicks, component.realEndTicks) and component.actualHighTicks >= math.max(component.realStartTicks, component.realEndTicks)
        valid := valid and component.analysisStartTime == component.realStartTime and component.analysisEndTime == component.realEndTime and component.analysisStartTicks == (component.direction == 1 ? component.actualLowTicks : component.actualHighTicks) and component.analysisEndTicks == (component.direction == 1 ? component.actualHighTicks : component.actualLowTicks)
        valid := valid and component.actualLowTime >= component.realStartTime and component.actualLowTime <= component.realEndTime and component.actualHighTime >= component.realStartTime and component.actualHighTime <= component.realEndTime and not na(component.dependencies)
    valid

chan_center_relation(ChanCenter older, ChanCenter newer) =>
    string kind = "unavailable"
    if not na(older) and not na(newer) and older.level == newer.level and not na(older.confirmedAt) and not na(newer.confirmedAt)
        kind := newer.ddTicks > older.ggTicks ? "up-continuation" : newer.ggTicks < older.ddTicks ? "down-continuation" : (newer.coreLowTicks > older.coreHighTicks or newer.coreHighTicks < older.coreLowTicks) ? "range-overlap" : "core-overlap"
    kind

chan_center_commit(ChanCenterState state, ChanComponent component) =>
    if state.center.dependencies.indexof(component.id) < 0
        if state.center.dependencies.size() >= state.maxSources
            state.blocked := true
        else
            state.center.dependencies.push(component.id)
            state.center.extentEndTime := component.realEndTime
            if component.direction == state.direction
                state.center.ggTicks := math.max(state.center.ggTicks, component.actualHighTicks)
                state.center.gTicks := math.min(state.center.gTicks, component.actualHighTicks)
                state.center.dTicks := math.max(state.center.dTicks, component.actualLowTicks)
                state.center.ddTicks := math.min(state.center.ddTicks, component.actualLowTicks)
                state.waves += 1
                state.center.zWaves := state.waves
    true

chan_center_close(ChanCenterState state, ChanComponent departure, ChanComponent returning) =>
    state.center.lifecycle := "closed"
    state.center.closedAt := returning.confirmedAt
    state.center.leaveId := departure.id
    state.center.returnId := returning.id
    state.previous := chan_center_copy(state.center)
    state.closedEvent := chan_center_copy(state.center)
    state.history.push(chan_center_copy(state.center))
    if state.history.size() > 15
        state.history.shift()
    state.pendingLeave := na
    state.seed := array.from(chan_component_copy(returning))
    state.relationKind := "new-center-pending"
    state.relationAt := returning.confirmedAt
    true

chan_center_step(ChanCenterState source, ChanComponent component) =>
    if not chan_center_valid(component)
        runtime.error("中枢仅消费已确认L0部件")
    ChanCenterState state = chan_center_clone(source)
    state.event := na
    state.closedEvent := na
    bool duplicate = not na(source.lastInput) and component.id == source.lastInput.id
    if duplicate
        if chan_component_signature(component) != chan_component_signature(source.lastInput)
            runtime.error("已消费L0发生变化")
    else if not source.blocked
        if component.ordinal != source.inputCount + 1
            runtime.error("中枢L0序号不连续")
        if not na(source.lastInput)
            // L0 parts share real endpoints. A submitted upper part keeps its own range,
            // so above L1 only the time seam, alternation and clock are required.
            if component.realStartTime != source.lastInput.realEndTime or (source.level == 1 and component.realStartTicks != source.lastInput.realEndTicks) or component.direction != -source.lastInput.direction or component.confirmedAt < source.lastInput.confirmedAt
                runtime.error("中枢输入不连续")
        if na(state.center) or state.center.lifecycle == "closed"
            state.seed.push(chan_component_copy(component))
            if state.seed.size() == 3
                ChanComponent first = state.seed.get(0)
                ChanComponent middle = state.seed.get(1)
                ChanComponent last = state.seed.get(2)
                int coreLow = math.max(first.actualLowTicks, math.max(middle.actualLowTicks, last.actualLowTicks))
                int coreHigh = math.min(first.actualHighTicks, math.min(middle.actualHighTicks, last.actualHighTicks))
                if coreLow <= coreHigh
                    state.direction := first.direction
                    state.waves := 2
                    state.count += 1
                    state.center := ChanCenter.new(state.contextId + "/L" + str.tostring(state.level) + "/Z/" + str.tostring(state.count) + "/" + str.tostring(first.realStartTime), state.level, coreLow, coreHigh, math.max(first.actualHighTicks, last.actualHighTicks), math.min(first.actualHighTicks, last.actualHighTicks), math.max(first.actualLowTicks, last.actualLowTicks), math.min(first.actualLowTicks, last.actualLowTicks), first.realStartTime, component.confirmedAt, component.realEndTime, component.confirmedAt, coreLow == coreHigh, "extending", "Z-001/Z-002/Z-003/E-010", array.from(first.id, middle.id, last.id), state.count)
                    state.center.zWaves := 2
                    if component.realEndTicks > coreHigh or component.realEndTicks < coreLow
                        state.pendingLeave := chan_component_copy(component)
                    state.event := state.center
                    state.seed.clear()
                else
                    state.seed.shift()
        else
            bool touches = component.actualLowTicks <= state.center.coreHighTicks and component.actualHighTicks >= state.center.coreLowTicks
            if not na(state.pendingLeave)
                if touches
                    chan_center_commit(state, state.pendingLeave)
                    state.pendingLeave := na
                else
                    chan_center_close(state, state.pendingLeave, component)
            if state.center.lifecycle != "closed" and not state.blocked
                if component.realEndTicks > state.center.coreHighTicks or component.realEndTicks < state.center.coreLowTicks
                    state.pendingLeave := chan_component_copy(component)
                else
                    chan_center_commit(state, component)
        if not na(state.previous) and not na(state.center) and state.center.lifecycle != "closed"
            state.relationKind := chan_center_relation(state.previous, state.center)
            state.relationAt := component.confirmedAt
        if state.blocked
            state := chan_center_clone(source)
            state.event := na
            state.closedEvent := na
            state.blocked := true
            state.heldInput := chan_component_copy(component)
        else
            state.lastInput := chan_component_copy(component)
            state.inputCount += 1
    state
// L1 movement completion on the structure-confirmation path (R-002..R-006).
// It reads the same confirmed L0 stream as the center chain plus that chain's
// formation and closure events. Window end, formation, extension, pending departure
// and touching returns never complete a movement.
type ChanMovementState
    string contextId
    int level = 1
    bool submit = true
    bool capped = false
    int maxMembers = 128
    int inputCount = 0
    bool active = false
    int direction = 0
    bool truncated = false
    int startTime = na
    int startTicks = na
    array<ChanComponent> members
    array<ChanCenter> centers
    ChanMovement event
    array<ChanMovement> history
    int count = 0
    int submitted = 0
    bool blocked = false
    string blockKind = ""
    ChanComponent heldInput

// submit is false on the top configured layer: a completed movement there is
// kept and marked capped, but nothing is sent upward.
chan_movement_new_level(string contextId, int maxMembers, int level, bool submit) =>
    if maxMembers < 4
        runtime.error("走势成员预算至少为4")
    if level < 1 or level > 3
        runtime.error("走势层级只支持1到3")
    ChanMovementState result = ChanMovementState.new()
    result.contextId := contextId
    result.level := level
    result.submit := submit
    result.maxMembers := maxMembers
    result.members := array.new<ChanComponent>()
    result.centers := array.new<ChanCenter>()
    result.history := array.new<ChanMovement>()
    result

chan_movement_new(string contextId, int maxMembers) =>
    chan_movement_new_level(contextId, maxMembers, 1, true)

chan_movement_copy(ChanMovement source) =>
    ChanMovement result = na
    if not na(source)
        result := source.copy()
        result.childIds := source.childIds.copy()
        result.centerIds := source.centerIds.copy()
        result.upper := chan_component_copy(source.upper)
    result

chan_movement_clone(ChanMovementState source) =>
    ChanMovementState result = source.copy()
    result.members := array.new<ChanComponent>()
    for member in source.members
        result.members.push(chan_component_copy(member))
    result.centers := array.new<ChanCenter>()
    for center in source.centers
        result.centers.push(chan_center_copy(center))
    result.event := chan_movement_copy(source.event)
    result.history := array.new<ChanMovement>()
    for item in source.history
        result.history.push(chan_movement_copy(item))
    result.heldInput := chan_component_copy(source.heldInput)
    result

chan_movement_record_signature(ChanMovement source) =>
    string result = "na"
    if not na(source)
        result := source.id + "/" + str.tostring(source.level) + "/" + str.tostring(source.direction) + "/" + str.tostring(source.startTime) + "/" + str.tostring(source.endTime) + "/" + str.tostring(source.startTicks) + "/" + str.tostring(source.endTicks) + "/" + source.morphology + "/" + str.tostring(source.completed) + "/" + str.tostring(source.confirmedAt) + "/" + source.completionProof + "/" + source.ruleId + "/" + str.tostring(source.ordinal) + "/" + str.tostring(source.lowTicks) + "/" + str.tostring(source.highTicks) + "/" + str.tostring(source.lowTime) + "/" + str.tostring(source.highTime) + "/" + str.tostring(source.occurredAt) + "/" + str.tostring(source.truncated) + "/upper/" + chan_component_signature(source.upper)
        for id in source.childIds
            result += "/child/" + id
        for id in source.centerIds
            result += "/center/" + id
    result

chan_movement_signature(ChanMovementState source) =>
    string result = source.contextId + "/L" + str.tostring(source.level) + "/" + str.tostring(source.submit) + "/" + str.tostring(source.capped) + "/" + str.tostring(source.maxMembers) + "/" + str.tostring(source.inputCount) + "/" + str.tostring(source.active) + "/" + str.tostring(source.direction) + "/" + str.tostring(source.truncated) + "/" + str.tostring(source.startTime) + "/" + str.tostring(source.startTicks) + "/" + str.tostring(source.count) + "/" + str.tostring(source.submitted) + "/" + str.tostring(source.blocked) + "/" + source.blockKind
    for member in source.members
        result += "/member/" + chan_component_signature(member)
    for center in source.centers
        result += "/center/" + chan_center_record_signature(center)
    for item in source.history
        result += "/history/" + chan_movement_record_signature(item)
    result + "/event/" + chan_movement_record_signature(source.event) + "/held/" + chan_component_signature(source.heldInput)

// A stopped layer keeps its last committed state and the unconsumed input. The
// kind separates the member budget from a violated R guard.
chan_movement_block(ChanMovementState source, ChanComponent component, string kind) =>
    ChanMovementState result = chan_movement_clone(source)
    result.event := na
    result.blocked := true
    result.blockKind := kind
    result.heldInput := chan_component_copy(component)
    result

// Reverse closure of the newest center: fixes endpoint, members and type once.
chan_movement_complete(ChanMovementState source, ChanMovementState working, ChanComponent returning, ChanCenter closed) =>
    ChanMovementState state = working
    int d = state.direction
    bool ok = state.centers.size() > 0
    ChanComponent middle = na
    ChanComponent departure = na
    if ok
        ChanCenter firstCenter = state.centers.first()
        for member in state.members
            if member.id == firstCenter.dependencies.get(1)
                middle := member
            if member.id == closed.leaveId
                departure := member
        ok := not na(middle) and not na(departure)
    int endIndex = -1
    if ok
        for i = 0 to state.members.size() - 1
            ChanComponent member = state.members.get(i)
            if member.direction == d and member.realEndTime >= middle.realEndTime and member.realEndTime <= departure.realStartTime
                if endIndex < 0 or d * member.analysisEndTicks > d * state.members.get(endIndex).analysisEndTicks
                    endIndex := i
        ok := endIndex >= 0 and endIndex < state.members.size() - 1
    ChanComponent endMember = na
    if ok
        endMember := state.members.get(endIndex)
        if not state.truncated
            ok := d * (endMember.analysisEndTicks - state.startTicks) > 0
    int lowTicks = na
    int highTicks = na
    int lowTime = na
    int highTime = na
    array<string> childIds = array.new<string>()
    if ok
        for i = 0 to endIndex
            ChanComponent member = state.members.get(i)
            childIds.push(member.id)
            if na(lowTicks) or member.actualLowTicks < lowTicks
                lowTicks := member.actualLowTicks
                lowTime := member.actualLowTime
            if na(highTicks) or member.actualHighTicks > highTicks
                highTicks := member.actualHighTicks
                highTime := member.actualHighTime
    string morphology = "consolidation"
    array<string> centerIds = array.new<string>()
    for center in state.centers
        centerIds.push(center.id)
    if state.centers.size() > 1
        morphology := "trend"
        for i = 1 to state.centers.size() - 1
            ChanCenter older = state.centers.get(i - 1)
            ChanCenter newer = state.centers.get(i)
            bool separated = d == 1 ? newer.ddTicks > older.ggTicks : newer.ggTicks < older.ddTicks
            if not separated
                morphology := "expansion-evidence"
    ChanMovement movement = na
    if ok
        string movementId = state.contextId + "/L" + str.tostring(state.level) + "/R/" + str.tostring(source.count + 1) + "/" + str.tostring(state.startTime)
        movement := ChanMovement.new(movementId, state.level, d, state.startTime, endMember.realEndTime, state.startTicks, endMember.analysisEndTicks, morphology, true, returning.confirmedAt, closed.id + "/close/" + returning.id, "R-002/R-003/R-004/R-006", childIds, centerIds, source.count + 1)
        movement.lowTicks := lowTicks
        movement.highTicks := highTicks
        movement.lowTime := lowTime
        movement.highTime := highTime
        movement.occurredAt := endMember.realEndTime
        movement.truncated := state.truncated
        if not state.truncated and state.submit
            array<string> upperDependencies = childIds.copy()
            upperDependencies.push(closed.id + "/close/" + returning.id)
            ChanComponent upper = ChanComponent.new(movementId, movementId, state.startTime, endMember.realEndTime, state.startTicks, endMember.analysisEndTicks, lowTicks, highTicks, lowTime, highTime, state.startTime, endMember.realEndTime, d == 1 ? lowTicks : highTicks, d == 1 ? highTicks : lowTicks, d, returning.confirmedAt, "R-005", upperDependencies, source.submitted + 1)
            ok := chan_center_valid(upper)
            if ok
                movement.upper := upper
    ChanMovementState result = na
    if ok
        array<ChanComponent> carried = array.new<ChanComponent>()
        for i = endIndex + 1 to state.members.size() - 1
            carried.push(state.members.get(i))
        state.members := carried
        state.direction := -d
        state.truncated := false
        state.startTime := carried.first().realStartTime
        state.startTicks := carried.first().analysisStartTicks
        state.centers := array.new<ChanCenter>()
        state.count := source.count + 1
        if not na(movement.upper)
            state.submitted := source.submitted + 1
        // state.truncated already describes the next movement here; the completed
        // one is on the record.
        if not movement.truncated and not state.submit
            state.capped := true
        state.event := movement
        state.history.push(chan_movement_copy(movement))
        if state.history.size() > 15
            state.history.shift()
        result := state
    else
        result := chan_movement_block(source, returning, "rule")
    result

chan_movement_step(ChanMovementState source, ChanComponent component, ChanCenterState centers) =>
    ChanMovementState state = chan_movement_clone(source)
    state.event := na
    if not source.blocked and component.ordinal > source.inputCount and centers.inputCount >= component.ordinal
        if component.ordinal != source.inputCount + 1
            runtime.error("走势L0序号不连续")
        if state.members.size() >= state.maxMembers
            state := chan_movement_block(source, component, "budget")
        else
            if source.inputCount == 0
                state.startTime := component.realStartTime
                state.startTicks := component.analysisStartTicks
            state.members.push(chan_component_copy(component))
            if not na(centers.event) and state.active and centers.event.startTime >= state.startTime
                state.centers.push(chan_center_copy(centers.event))
            if not na(centers.closedEvent)
                ChanCenter closed = centers.closedEvent
                int closeDirection = component.actualLowTicks > closed.coreHighTicks ? 1 : -1
                if not state.active
                    state.active := true
                    state.direction := closeDirection
                    state.truncated := true
                    state.centers := array.from(chan_center_copy(closed))
                else
                    int lastIndex = state.centers.size() - 1
                    bool tracked = lastIndex >= 0 and state.centers.get(lastIndex).id == closed.id
                    if tracked
                        state.centers.set(lastIndex, chan_center_copy(closed))
                    if closeDirection != state.direction
                        if tracked
                            state := chan_movement_complete(source, state, component, closed)
                        else
                            state := chan_movement_block(source, component, "rule")
            if not state.blocked
                state.inputCount := source.inputCount + 1
    state
// Layers above L1 consume only the parts submitted by the layer below, in the
// order L1 -> Z2 -> R2 -> Z3 -> R3. A layer never reads or rewrites a lower one:
// an extension or expansion above only adds to its own state, and the layer
// below keeps its confirmed history. limit is the configured layer ceiling.
type ChanLevels
    int levelLimit = 3
    ChanCenterState centers2
    ChanMovementState movements2
    ChanCenterState centers3
    ChanMovementState movements3

chan_levels_new(string contextId, int centerSources, int limit) =>
    if limit < 1 or limit > 3
        runtime.error("走势层数上限只支持1到3")
    ChanLevels result = ChanLevels.new()
    result.levelLimit := limit
    result.centers2 := chan_center_new_level(contextId, centerSources, 2)
    result.movements2 := chan_movement_new_level(contextId, centerSources * 2, 2, limit >= 3)
    result.centers3 := chan_center_new_level(contextId, centerSources, 3)
    result.movements3 := chan_movement_new_level(contextId, centerSources * 2, 3, false)
    result

chan_levels_clone(ChanLevels source) =>
    ChanLevels result = source.copy()
    result.centers2 := chan_center_clone(source.centers2)
    result.movements2 := chan_movement_clone(source.movements2)
    result.centers3 := chan_center_clone(source.centers3)
    result.movements3 := chan_movement_clone(source.movements3)
    result

chan_levels_signature(ChanLevels source) =>
    str.tostring(source.levelLimit) + "/Z2/" + chan_center_signature(source.centers2) + "/R2/" + chan_movement_signature(source.movements2) + "/Z3/" + chan_center_signature(source.centers3) + "/R3/" + chan_movement_signature(source.movements3)

// upper is the part just submitted by L1, or na. Events live for one call only.
chan_levels_step(ChanLevels source, ChanComponent upper) =>
    ChanLevels state = chan_levels_clone(source)
    state.centers2.event := na
    state.centers2.closedEvent := na
    state.movements2.event := na
    state.centers3.event := na
    state.centers3.closedEvent := na
    state.movements3.event := na
    if state.levelLimit >= 2 and not na(upper)
        state.centers2 := chan_center_step(state.centers2, upper)
        state.movements2 := chan_movement_step(state.movements2, upper, state.centers2)
        ChanComponent upper2 = na
        if not na(state.movements2.event)
            upper2 := state.movements2.event.upper
        if state.levelLimit >= 3 and not na(upper2)
            state.centers3 := chan_center_step(state.centers3, upper2)
            state.movements3 := chan_movement_step(state.movements3, upper2, state.centers3)
    state

// One confirmed L0 part through every layer. The runtime and the shared
// validation both call this, so the batch order is a single definition.
type ChanStack
    ChanCenterState centers
    ChanMovementState movements
    ChanLevels levels

chan_stack_step(ChanStack source, ChanComponent part) =>
    ChanStack result = ChanStack.new()
    result.centers := chan_center_step(source.centers, part)
    result.movements := chan_movement_step(source.movements, part, result.centers)
    ChanComponent submitted = na
    if not na(result.movements.event)
        submitted := result.movements.event.upper
    result.levels := chan_levels_step(source.levels, submitted)
    result
// The same close gate is used by the chart and synthetic tick validation.
// Persistent states own no drawing objects; frame events exist only for this call.
type ChanRuntime
    ChanState morphology
    ChanSegmentState segments
    ChanNormalizationState normalized
    ChanCenterState centers
    ChanMovementState movements
    ChanLevels levels
    int pendingLimit = 64
    int workLimit = 8192
    int centerSources = 64

type ChanRuntimeFrame
    ChanRuntime committed
    ChanState visible
    bool submitted = false
    array<ChanStructure> segmentEvents
    array<ChanComponent> componentEvents

type ChanSegmentPreview
    ChanSegmentState state
    array<ChanStructure> events

chan_runtime_new_levels(string contextId, int pendingLimit, int workLimit, int centerSources, int levelLimit) =>
    ChanRuntime state = ChanRuntime.new()
    state.morphology := chan_new(contextId)
    state.normalized := chan_normalization_new(state.morphology.contextId)
    state.centers := chan_center_new(state.morphology.contextId, centerSources)
    state.movements := chan_movement_new_level(state.morphology.contextId, centerSources * 2, 1, levelLimit >= 2)
    state.levels := chan_levels_new(state.morphology.contextId, centerSources, levelLimit)
    state.pendingLimit := pendingLimit
    state.workLimit := workLimit
    state.centerSources := centerSources
    state

chan_runtime_new(string contextId, int pendingLimit, int workLimit, int centerSources) =>
    chan_runtime_new_levels(contextId, pendingLimit, workLimit, centerSources, 3)

chan_runtime_clone(ChanRuntime source) =>
    ChanRuntime result = source.copy()
    result.morphology := chan_clone(source.morphology)
    result.segments := na(source.segments) ? na : chan_segment_clone(source.segments)
    result.normalized := chan_normalization_clone(source.normalized)
    result.centers := chan_center_clone(source.centers)
    result.movements := chan_movement_clone(source.movements)
    result.levels := chan_levels_clone(source.levels)
    result

chan_runtime_signature(ChanRuntime source) =>
    chan_signature(source.morphology) + "/S/" + (na(source.segments) ? "na" : chan_segment_signature(source.segments)) + "/N/" + chan_normalization_signature(source.normalized) + "/Z/" + chan_center_signature(source.centers) + "/R/" + chan_movement_signature(source.movements) + "/levels/" + chan_levels_signature(source.levels) + "/limits/" + str.tostring(source.pendingLimit) + "/" + str.tostring(source.workLimit) + "/" + str.tostring(source.centerSources)

chan_runtime_frame(ChanRuntime source) =>
    ChanRuntimeFrame result = ChanRuntimeFrame.new()
    result.committed := source
    result.visible := source.morphology
    result.segmentEvents := array.new<ChanStructure>()
    result.componentEvents := array.new<ChanComponent>()
    result

// Explicit locked-stroke seam: only the close path calls it in the chart.
// A batch of S events is delivered to N and Z in its original order.
chan_runtime_component(ChanRuntime source, ChanStructure segment) =>
    ChanRuntime state = source.copy()
    state.normalized := chan_normalization_step(source.normalized, segment)
    ChanStack stack = ChanStack.new()
    stack.centers := source.centers
    stack.movements := source.movements
    stack.levels := source.levels
    stack := chan_stack_step(stack, state.normalized.event)
    state.centers := stack.centers
    state.movements := stack.movements
    state.levels := stack.levels
    state

chan_runtime_stroke(ChanRuntime source, ChanStructure stroke) =>
    ChanRuntime state = source.copy()
    ChanRuntimeFrame result = chan_runtime_frame(state)
    if na(state.segments)
        state.segments := chan_segment_new(state.morphology.contextId, state.pendingLimit, state.workLimit)
    state.segments := chan_segment_step(state.segments, stroke)
    for segment in state.segments.events
        state := chan_runtime_component(state, segment)
        result.segmentEvents.push(chan_structure_copy(segment))
        result.componentEvents.push(chan_component_copy(state.normalized.event))
    result.committed := state
    result

chan_runtime_update(ChanRuntime source, ChanRaw incoming, bool closed) =>
    ChanRuntimeFrame result = chan_runtime_frame(source)
    // chan_step mutates its argument, so even the closed path owns a deep copy.
    result.visible := chan_step(chan_clone(source.morphology), incoming)
    if closed
        ChanRuntime state = source.copy()
        state.morphology := result.visible
        if not na(state.morphology.strokeEvent)
            result := chan_runtime_stroke(state, state.morphology.strokeEvent)
        else
            result.committed := state
        result.submitted := state.morphology.inputCount > source.morphology.inputCount
    result

// A tick can seal one P and the unsealed fractal projection can hypothesize
// another. Feed both in order; using only the last one skips a stroke ordinal.
chan_runtime_segment_preview(ChanRuntime source, ChanState visible, ChanState projected) =>
    ChanSegmentPreview result = ChanSegmentPreview.new()
    result.state := na(source.segments) ? na : chan_segment_clone(source.segments)
    result.events := array.new<ChanStructure>()
    array<ChanStructure> strokes = array.new<ChanStructure>()
    if visible.strokeCount > source.morphology.strokeCount and not na(visible.strokeEvent)
        strokes.push(visible.strokeEvent)
    if projected.strokeCount > visible.strokeCount and not na(projected.lastStroke)
        strokes.push(projected.lastStroke)
    for stroke in strokes
        if na(result.state)
            result.state := chan_segment_new(visible.contextId, source.pendingLimit, source.workLimit)
        result.state := chan_segment_step(result.state, stroke)
        for event in result.state.events
            result.events.push(chan_structure_copy(event))
    result
// Analysis context is fixed at load. The rolling display budget never reseeds it.
type ChanWindow
    bool fixed
    int requestedStart
    int startIndex
    int firstAvailable
    int maxSamples
    int count = 0
    int firstInput = na
    int lastInput = na
    bool truncated = false

type ChanWindowFrame
    ChanWindow state
    bool eligible
    bool allowed

chan_window_new(bool fixed, int requestedStart, int recentBars, int anchorIndex, int firstAvailable, int maxSamples) =>
    if requestedStart < 0 or recentBars < 1 or anchorIndex < 0 or firstAvailable < 0 or maxSamples < 1
        runtime.error("分析范围参数无效")
    ChanWindow.new(fixed, requestedStart, math.max(0, anchorIndex - recentBars + 1), firstAvailable, maxSamples)

chan_window_signature(ChanWindow state) =>
    str.tostring(state.fixed) + "/" + str.tostring(state.requestedStart) + "/" + str.tostring(state.startIndex) + "/" + str.tostring(state.firstAvailable) + "/" + str.tostring(state.maxSamples) + "/" + str.tostring(state.count) + "/" + str.tostring(state.firstInput) + "/" + str.tostring(state.lastInput) + "/" + str.tostring(state.truncated)

chan_window_step(ChanWindow source, int openTime, int index, bool closed) =>
    ChanWindowFrame result = ChanWindowFrame.new()
    result.state := source.copy()
    result.eligible := source.fixed ? openTime >= source.requestedStart : index >= source.startIndex
    bool capped = source.fixed and source.count >= source.maxSamples
    result.allowed := result.eligible and not capped
    if closed and result.eligible
        bool duplicate = not na(source.lastInput) and openTime == source.lastInput
        if capped and not duplicate
            result.state.truncated := true
        else if result.allowed and not duplicate
            result.state.count += 1
            if na(result.state.firstInput)
                result.state.firstInput := openTime
            result.state.lastInput := openTime
    result
chan_context_allows(bool supported, ChanWindowFrame frame) =>
    supported and frame.allowed

chan_status_code(ChanRuntime engine, ChanWindow window, bool supported) =>
    string code = "RUNNING"
    if not supported
        code := "UNSUPPORTED"
    else if window.truncated
        code := "TRUNCATED"
    else if window.fixed and window.count >= window.maxSamples
        code := "SAMPLE_LIMIT"
    else if not na(engine.segments) and engine.segments.blocked
        code := engine.segments.limitReason == "pending-strokes" ? "S_PENDING_LIMIT" : "S_WORK_LIMIT"
    else if engine.centers.blocked
        code := "Z_SOURCE_LIMIT"
    else if engine.movements.blocked
        code := engine.movements.blockKind == "budget" ? "R1_MEMBER_LIMIT" : "R1_RULE_ERROR"
    else if engine.levels.centers2.blocked
        code := "Z2_SOURCE_LIMIT"
    else if engine.levels.movements2.blocked
        code := engine.levels.movements2.blockKind == "budget" ? "R2_MEMBER_LIMIT" : "R2_RULE_ERROR"
    else if engine.levels.centers3.blocked
        code := "Z3_SOURCE_LIMIT"
    else if engine.levels.movements3.blocked
        code := engine.levels.movements3.blockKind == "budget" ? "R3_MEMBER_LIMIT" : "R3_RULE_ERROR"
    else if window.fixed and window.requestedStart < window.firstAvailable
        code := "HISTORY_SHORT"
    else if window.count == 0
        code := "WAIT_START"
    else if engine.morphology.direction == 0
        code := "INITIALIZING"
    else if not na(engine.segments) and engine.segments.gapPending
        code := "S_PROOF_PENDING"
    else if not na(engine.centers.pendingLeave)
        code := "Z_RETURN_PENDING"
    else if engine.centers.relationKind == "new-center-pending"
        code := "Z_NEW_PENDING"
    // The ceiling is information, not a stop: it ranks below every resource stop
    // and below data insufficiency and sample truncation.
    else if (engine.levels.levelLimit == 1 and engine.movements.capped) or (engine.levels.levelLimit == 2 and engine.levels.movements2.capped) or (engine.levels.levelLimit == 3 and engine.levels.movements3.capped)
        code := "LEVEL_CAP"
    code

chan_status_text(string code) =>
    switch code
        "UNSUPPORTED" => "仅支持有确定收盘时间的普通K线"
        "TRUNCATED" => "样本已截断：后续K线未计算"
        "SAMPLE_LIMIT" => "样本上限已达"
        "S_PENDING_LIMIT" => "线段受限：未完成笔依赖上限"
        "S_WORK_LIMIT" => "线段受限：计算预算"
        "Z_SOURCE_LIMIT" => "L1中枢受限：来源预算"
        "R1_MEMBER_LIMIT" => "L1走势受限：成员预算，停止确认与上报"
        "R1_RULE_ERROR" => "L1走势受限：完成守卫未通过，停止确认与上报"
        "Z2_SOURCE_LIMIT" => "L2中枢受限：来源预算"
        "R2_MEMBER_LIMIT" => "L2走势受限：成员预算，停止确认与上报"
        "R2_RULE_ERROR" => "L2走势受限：完成守卫未通过，停止确认与上报"
        "Z3_SOURCE_LIMIT" => "L3中枢受限：来源预算"
        "R3_MEMBER_LIMIT" => "L3走势受限：成员预算，停止确认"
        "R3_RULE_ERROR" => "L3走势受限：完成守卫未通过，停止确认"
        "LEVEL_CAP" => "已达层数上限：更高层未计算"
        "HISTORY_SHORT" => "历史不足：实际可用起点晚于请求"
        "WAIT_START" => "等待分析起点后的K线"
        "INITIALIZING" => "初始化：等待非包含输入"
        "S_PROOF_PENDING" => "线段：第二类候选等待证明"
        "Z_RETURN_PENDING" => "L1中枢：离开／回试待定"
        "Z_NEW_PENDING" => "离开已证实：等待新中枢"
        => "形态预览运行中"
// END CHANLUN CORE

// BEGIN CHANLUN SIGNALS
// Signal layer (change add-chanlun-divergence-signals, rules M/D/B). It is read-only with
// respect to the pattern CORE: nothing below writes into a CORE state.
//
// M-001/M-002: MACD over closed bars only, kept as prefix sums keyed by bar open time.
// One entry per usable closed bar: (time, cumPos, cumNeg, dif, dea). The first `warmup`
// bars advance the EMAs but are not stored. A segment (ts, te] is a difference of two
// prefix entries found by binary search on time, never by bar_index offsets.
// The arrays are bounded by `capacity`; the oldest entry is recycled when it is full,
// and any segment that starts before the oldest kept entry is "area unavailable".
type ChanMacd
    int fast
    int slow
    int signal
    int warmup
    int capacity
    int seen = 0
    int dropped = 0
    int lastTime = na
    float emaFast = na
    float emaSlow = na
    float emaSignal = na
    float sumFast = 0.0
    float sumSlow = 0.0
    float sumSignal = 0.0
    int difCount = 0
    float sumPos = 0.0
    float sumNeg = 0.0
    array<int> times
    array<float> cumPos
    array<float> cumNeg
    array<float> difs
    array<float> deas

type ChanMacdBar
    float emaFast
    float emaSlow
    float emaSignal
    float sumFast
    float sumSlow
    float sumSignal
    int difCount
    float dif
    float dea
    float hist

// direction: 1 = up (red bars), -1 = down (green bars).
type ChanMacdArea
    bool available = false
    string reason = "no-data"
    float area = na
    float difExtreme = na
    float deaExtreme = na
    int bars = 0
    int fast
    int slow
    int signal

chan_macd_new(int fast, int slow, int signal, int capacity) =>
    if fast < 1 or slow <= fast or signal < 1
        runtime.error("MACD参数无效：需要 快线 < 慢线 且信号线 ≥ 1")
    if capacity < 1 or capacity > 100000
        runtime.error("MACD前缀容量须在1到100000之间")
    ChanMacd state = ChanMacd.new()
    state.fast := fast
    state.slow := slow
    state.signal := signal
    state.warmup := slow + signal
    state.capacity := capacity
    state.times := array.new<int>()
    state.cumPos := array.new<float>()
    state.cumNeg := array.new<float>()
    state.difs := array.new<float>()
    state.deas := array.new<float>()
    state

// Same definition as ta.ema/ta.macd (checked against the platform, see signal-validation.md):
// an EMA is na for its first length-1 inputs, its first value is the simple average of the first
// length inputs, and every later value is alpha * src + (1 - alpha) * previous. The signal line
// applies the same rule to the dif values, so dif is valid from input slow, and dea and hist from
// input slow + signal - 1 (1-based). Pure: it never changes `source`, so a not-yet-closed bar can be
// previewed without entering the confirmed series.
chan_macd_peek(ChanMacd source, float price) =>
    ChanMacdBar bar = ChanMacdBar.new()
    int count = source.seen + 1
    float alphaFast = 2.0 / (source.fast + 1)
    float alphaSlow = 2.0 / (source.slow + 1)
    float alphaSignal = 2.0 / (source.signal + 1)
    bar.sumFast := count <= source.fast ? source.sumFast + price : source.sumFast
    bar.sumSlow := count <= source.slow ? source.sumSlow + price : source.sumSlow
    bar.emaFast := count < source.fast ? na : (count == source.fast ? bar.sumFast / source.fast : alphaFast * price + (1.0 - alphaFast) * source.emaFast)
    bar.emaSlow := count < source.slow ? na : (count == source.slow ? bar.sumSlow / source.slow : alphaSlow * price + (1.0 - alphaSlow) * source.emaSlow)
    bar.dif := (na(bar.emaFast) or na(bar.emaSlow)) ? na : bar.emaFast - bar.emaSlow
    bar.difCount := source.difCount + (na(bar.dif) ? 0 : 1)
    bar.sumSignal := (not na(bar.dif) and bar.difCount <= source.signal) ? source.sumSignal + bar.dif : source.sumSignal
    bar.emaSignal := na(bar.dif) ? na : (bar.difCount < source.signal ? na : (bar.difCount == source.signal ? bar.sumSignal / source.signal : alphaSignal * bar.dif + (1.0 - alphaSignal) * source.emaSignal))
    bar.dea := bar.emaSignal
    bar.hist := (na(bar.dif) or na(bar.dea)) ? na : bar.dif - bar.dea
    bar

// Shared storage path for the chart and for validation fixtures that supply dif/dea
// directly. Mutates in place, so callers use it only for closed bars.
chan_macd_store(ChanMacd state, int openTime, float dif, float dea) =>
    float hist = dif - dea
    state.seen += 1
    if state.seen > state.warmup and not na(hist)
        if hist > 0.0
            state.sumPos += hist
        if hist < 0.0
            state.sumNeg -= hist
        if state.times.size() >= state.capacity
            state.times.shift()
            state.cumPos.shift()
            state.cumNeg.shift()
            state.difs.shift()
            state.deas.shift()
            state.dropped += 1
        state.times.push(openTime)
        state.cumPos.push(state.sumPos)
        state.cumNeg.push(state.sumNeg)
        state.difs.push(dif)
        state.deas.push(dea)
    state.lastTime := openTime
    true

// One closed bar. A repeated or older open time is ignored, so re-running the same
// bar (redraw, reload of the same data) cannot append twice. Returns whether it was taken.
chan_macd_push(ChanMacd state, int openTime, float price) =>
    bool accepted = na(state.lastTime) or openTime > state.lastTime
    if accepted
        ChanMacdBar bar = chan_macd_peek(state, price)
        state.emaFast := bar.emaFast
        state.emaSlow := bar.emaSlow
        state.emaSignal := bar.emaSignal
        state.sumFast := bar.sumFast
        state.sumSlow := bar.sumSlow
        state.sumSignal := bar.sumSignal
        state.difCount := bar.difCount
        chan_macd_store(state, openTime, bar.dif, bar.dea)
    accepted

// Index of the last kept entry whose open time is not later than target, or -1.
chan_macd_index(ChanMacd state, int target) =>
    int low = 0
    int high = state.times.size() - 1
    int found = -1
    while low <= high
        int mid = int(math.floor((low + high) / 2.0))
        if state.times.get(mid) <= target
            found := mid
            low := mid + 1
        else
            high := mid - 1
    found

// M-002: same-sign area over the half-open interval (startTime, endTime].
// Unavailable (never degraded to another definition) when the start precedes the
// first kept entry (warm-up, before the window, or recycled), the interval is
// reversed, or its end lies beyond the last closed bar.
chan_macd_area(ChanMacd state, int startTime, int endTime, int direction) =>
    if direction != 1 and direction != -1
        runtime.error("MACD面积方向只能是1或-1")
    ChanMacdArea result = ChanMacdArea.new()
    result.fast := state.fast
    result.slow := state.slow
    result.signal := state.signal
    if endTime < startTime
        result.reason := "bad-range"
    else if state.times.size() == 0
        result.reason := "warmup"
    else if startTime < state.times.first()
        result.reason := state.dropped > 0 ? "recycled" : "before-start"
    else if endTime > state.lastTime
        result.reason := "not-closed"
    else
        int startIndex = chan_macd_index(state, startTime)
        int endIndex = chan_macd_index(state, endTime)
        array<float> cumulative = direction == 1 ? state.cumPos : state.cumNeg
        result.available := true
        result.reason := "ok"
        result.area := cumulative.get(endIndex) - cumulative.get(startIndex)
        result.bars := endIndex - startIndex
        if endIndex > startIndex
            float difValue = state.difs.get(startIndex + 1)
            float deaValue = state.deas.get(startIndex + 1)
            // A Pine for loop counts downward when start > end, so guard the range.
            if endIndex > startIndex + 1
                for i = startIndex + 2 to endIndex
                    difValue := direction == 1 ? math.max(difValue, state.difs.get(i)) : math.min(difValue, state.difs.get(i))
                    deaValue := direction == 1 ? math.max(deaValue, state.deas.get(i)) : math.min(deaValue, state.deas.get(i))
            result.difExtreme := difValue
            result.deaExtreme := deaValue
    result

chan_macd_signature(ChanMacd state) =>
    int size = state.times.size()
    str.tostring(state.fast) + "/" + str.tostring(state.slow) + "/" + str.tostring(state.signal) + "/" + str.tostring(state.warmup) + "/" + str.tostring(state.capacity) + "/" + str.tostring(state.seen) + "/" + str.tostring(state.dropped) + "/" + str.tostring(state.lastTime) + "/" + str.tostring(size) + "/" + (size > 0 ? str.tostring(state.times.first()) + "/" + str.tostring(state.times.last()) + "/" + str.tostring(state.cumPos.last(), "#.##########") + "/" + str.tostring(state.cumNeg.last(), "#.##########") : "empty") + "/" + str.tostring(state.emaFast, "#.##########") + "/" + str.tostring(state.emaSlow, "#.##########") + "/" + str.tostring(state.emaSignal, "#.##########")
// END CHANLUN SIGNALS

// BEGIN CHANLUN DIVERGENCE
// Divergence signals (rules D-001..D-004; B-001 first class and B-004 consolidation divergence point).
// Read-only: this section calls CORE step functions on its own mirror of the layer stack and reads
// their Z/R states. It never assigns into a CORE state, so the pattern engine is untouched.
// Order inside one confirmed part: L0 -> Z1 -> R1 -> D1 -> Z2 -> R2 -> D2 -> Z3 -> R3 -> D3.
type ChanSegmentArea
    int startTime
    int endTime
    int direction
    float area = na
    int extremeTicks

type ChanComparison
    string kind
    array<string> aIds
    string cId
    ChanSegmentArea a
    ChanSegmentArea c

// side: 1 = buy, -1 = sell.
type ChanSignal
    string id
    string type
    int layer
    int side
    int priceTicks
    int occurredAt
    int confirmedAt
    array<string> dependencies
    ChanComparison comparison
    string ruleId

type ChanSignalNote
    string type
    string reason
    ChanComparison comparison
    array<string> dependencies

type ChanSignalMemo
    string centerId
    ChanComponent entry
    bool firstDone = false
    bool consolidationDone = false

// A first-class signal waiting for its second-class point: r1 is the next part, r2 the one after.
type ChanSignalWait
    string firstId
    string componentId
    int direction
    int priceTicks
    int count = 0
    string r1Id = ""

type ChanSignalLayer
    string contextId
    int layer
    int lastOrdinal = 0
    int count = 0
    int dropped = 0
    int signalLimit = 128
    array<ChanComponent> recent
    array<ChanSignalMemo> memos
    array<ChanSignalWait> waits
    ChanComponent pending
    array<ChanSignal> signals
    array<ChanSignal> events
    array<ChanSignalNote> notes

type ChanSignalRuntime
    int levelLimit = 3
    ChanStack stack
    ChanSignalLayer d1
    ChanSignalLayer d2
    ChanSignalLayer d3
    array<ChanSignal> events
    array<ChanSignalNote> notes

chan_signal_layer_new(string contextId, int layer) =>
    ChanSignalLayer state = ChanSignalLayer.new()
    state.contextId := contextId
    state.layer := layer
    state.recent := array.new<ChanComponent>()
    state.memos := array.new<ChanSignalMemo>()
    state.waits := array.new<ChanSignalWait>()
    state.signals := array.new<ChanSignal>()
    state.events := array.new<ChanSignal>()
    state.notes := array.new<ChanSignalNote>()
    state

// Signals and notes are immutable once built, so the arrays are copied shallowly.
chan_signal_layer_clone(ChanSignalLayer source) =>
    ChanSignalLayer state = source.copy()
    state.recent := source.recent.copy()
    state.memos := array.new<ChanSignalMemo>()
    for memo in source.memos
        state.memos.push(memo.copy())
    state.waits := array.new<ChanSignalWait>()
    for wait in source.waits
        state.waits.push(wait.copy())
    state.signals := source.signals.copy()
    state.events := array.new<ChanSignal>()
    state.notes := array.new<ChanSignalNote>()
    state

chan_signal_memo(ChanSignalLayer state, string centerId) =>
    ChanSignalMemo found = na
    for memo in state.memos
        if memo.centerId == centerId
            found := memo
    if na(found)
        found := ChanSignalMemo.new(centerId)
        state.memos.push(found)
        if state.memos.size() > 8
            state.memos.shift()
    found

// Index of the component with this id, or -1. A Pine for loop counts downward on an empty range.
chan_signal_find(array<ChanComponent> members, string id) =>
    int found = -1
    if members.size() > 0
        for i = 0 to members.size() - 1
            if members.get(i).id == id
                found := i
    found

chan_signal_segment(ChanMacd macd, int startTime, int endTime, int direction, int extremeTicks) =>
    ChanSegmentArea segment = ChanSegmentArea.new(startTime, endTime, direction, na, extremeTicks)
    ChanMacdArea measured = chan_macd_area(macd, startTime, endTime, direction)
    if measured.available
        segment.area := measured.area
    segment

// The centers of the current walk W: the tracked ones plus the live center when R has not tracked it yet.
chan_signal_wset(ChanCenterState centers, ChanMovementState movements) =>
    array<ChanCenter> result = array.new<ChanCenter>()
    for center in movements.centers
        result.push(center)
    ChanCenter live = centers.center
    if not na(live) and live.lifecycle != "closed"
        if result.size() > 0 and result.last().id == live.id
            result.set(result.size() - 1, live)
        else
            result.push(live)
    result

// Appends a confirmed signal: only ever added to, never changed afterwards.
chan_signal_emit(ChanSignalLayer state, ChanSignal signal) =>
    state.signals.push(signal)
    if state.signals.size() > state.signalLimit
        state.signals.shift()
        state.dropped += 1
    state.events.push(signal)
    state.count += 1
    true

// D-001/M-003 hard conditions in a fixed order: new extreme, then areas available, then C smaller than A.
chan_signal_decide(ChanSignalLayer state, ChanSignalMemo memo, string type, string ruleId, ChanComparison comparison, array<string> dependencies, ChanComponent c, int d) =>
    string reason = ""
    if d * (comparison.c.extremeTicks - comparison.a.extremeTicks) <= 0
        reason := "not-new-extreme"
    else if na(comparison.a.area) or na(comparison.c.area)
        reason := "area-unavailable"
    else if not (comparison.c.area < comparison.a.area)
        reason := "area-not-smaller"
    if reason == ""
        ChanSignal signal = ChanSignal.new(state.contextId + "/L" + str.tostring(state.layer) + "/" + type + "/" + c.id, type, state.layer, d == 1 ? -1 : 1, c.realEndTicks, c.realEndTime, c.confirmedAt, dependencies, comparison, ruleId)
        chan_signal_emit(state, signal)
        if type == "first"
            memo.firstDone := true
            state.waits.push(ChanSignalWait.new(signal.id, c.id, d, c.realEndTicks))
        else
            memo.consolidationDone := true
    else
        state.notes.push(ChanSignalNote.new(type, reason, comparison, dependencies))
    true

// D-002. C is the departure of the newest center Zk, A runs from the previous center's departure
// up to the part before Zk's first formation part.
chan_signal_trend(ChanSignalLayer state, ChanSignalMemo memo, array<ChanCenter> wset, ChanMovementState movements, ChanCenter zk, ChanComponent c, ChanMacd macd) =>
    ChanCenter zp = wset.get(wset.size() - 2)
    int d = zk.ddTicks > zp.ggTicks ? 1 : (zk.ggTicks < zp.ddTicks ? -1 : 0)
    int depIndex = zp.lifecycle == "closed" ? chan_signal_find(movements.members, zp.leaveId) : -1
    int firstIndex = chan_signal_find(movements.members, zk.dependencies.get(0))
    if d != 0 and c.direction == d and depIndex >= 0 and firstIndex > depIndex
        ChanComponent dep = movements.members.get(depIndex)
        int closeDirection = dep.realEndTicks > zp.coreHighTicks ? 1 : -1
        if closeDirection == d
            ChanComponent aFirst = movements.members.get(depIndex)
            ChanComponent aLast = movements.members.get(firstIndex - 1)
            array<string> aIds = array.new<string>()
            array<string> dependencies = array.from(zk.id, zp.id)
            int aExtreme = na
            for i = depIndex to firstIndex - 1
                ChanComponent member = movements.members.get(i)
                aIds.push(member.id)
                dependencies.push(member.id)
                if member.direction == d
                    int value = d == 1 ? member.actualHighTicks : member.actualLowTicks
                    aExtreme := na(aExtreme) ? value : (d == 1 ? math.max(aExtreme, value) : math.min(aExtreme, value))
            dependencies.push(c.id)
            ChanSegmentArea a = chan_signal_segment(macd, aFirst.realStartTime, aLast.realEndTime, d, aExtreme)
            ChanSegmentArea cs = chan_signal_segment(macd, c.realStartTime, c.realEndTime, d, d == 1 ? c.actualHighTicks : c.actualLowTicks)
            chan_signal_decide(state, memo, "first", "D-001/D-002/M-002/M-003/B-001", ChanComparison.new("trend", aIds, c.id, a, cs), dependencies, c, d)
    true

// D-003. a is the part just before Zk's first formation part and must run the same way as C.
chan_signal_consolidation(ChanSignalLayer state, ChanSignalMemo memo, ChanCenter zk, ChanComponent c, ChanMacd macd) =>
    ChanComparison none = na
    ChanComponent entry = memo.entry
    if na(entry)
        state.notes.push(ChanSignalNote.new("consolidation-divergence-point", "no-entry-segment", none, array.from(zk.id, c.id)))
    else if entry.direction != c.direction
        state.notes.push(ChanSignalNote.new("consolidation-divergence-point", "no-same-direction-entry", none, array.from(zk.id, entry.id, c.id)))
    else
        int d = c.direction
        ChanSegmentArea a = chan_signal_segment(macd, entry.realStartTime, entry.realEndTime, d, d == 1 ? entry.actualHighTicks : entry.actualLowTicks)
        ChanSegmentArea cs = chan_signal_segment(macd, c.realStartTime, c.realEndTime, d, d == 1 ? c.actualHighTicks : c.actualLowTicks)
        chan_signal_decide(state, memo, "consolidation-divergence-point", "D-001/D-003/M-002/M-003/B-004", ChanComparison.new("consolidation", array.from(entry.id), c.id, a, cs), array.from(zk.id, entry.id, c.id), c, d)
    true

// B-002. r2 is the second part after the first-class point. It counts unless it passes the
// first-class price (equal does not pass); when it does pass, no second-class point ever follows.
chan_signal_second(ChanSignalLayer state, ChanSignalWait wait, ChanComponent r2) =>
    ChanComparison none = na
    array<string> dependencies = array.from(wait.firstId, wait.r1Id, r2.id)
    if wait.direction * (r2.realEndTicks - wait.priceTicks) <= 0
        chan_signal_emit(state, ChanSignal.new(state.contextId + "/L" + str.tostring(state.layer) + "/second/" + r2.id, "second", state.layer, wait.direction == 1 ? -1 : 1, r2.realEndTicks, r2.realEndTime, r2.confirmedAt, dependencies, none, "B-002"))
    else
        state.notes.push(ChanSignalNote.new("second", "breaks-first-class-price", none, dependencies))
    true

// B-003. A closing return part is the third-class point: above the core is a buy, below a sell.
chan_signal_third(ChanSignalLayer state, ChanCenter closed, ChanComponent ret) =>
    ChanComparison none = na
    int side = ret.actualLowTicks > closed.coreHighTicks ? 1 : -1
    chan_signal_emit(state, ChanSignal.new(state.contextId + "/L" + str.tostring(state.layer) + "/third/" + ret.id, "third", state.layer, side, ret.realEndTicks, ret.realEndTime, ret.confirmedAt, array.from(closed.id, closed.leaveId, ret.id), none, "B-003/E-010"))
    true

// One confirmed part of this layer, after the layer's Z and R have consumed it.
chan_signal_layer_step(ChanSignalLayer source, ChanCenterState centers, ChanMovementState movements, ChanComponent component, ChanMacd macd) =>
    ChanSignalLayer state = chan_signal_layer_clone(source)
    if component.ordinal > source.lastOrdinal
        state.lastOrdinal := component.ordinal
        state.recent.push(component)
        if state.recent.size() > 6
            state.recent.shift()
        // The entry segment is remembered when the center forms, while it is still in the short history.
        if not na(centers.event)
            ChanCenter formed = centers.event
            ChanSignalMemo memo = chan_signal_memo(state, formed.id)
            int at = chan_signal_find(state.recent, formed.dependencies.get(0))
            if at > 0
                memo.entry := state.recent.get(at - 1)
        // A newly held departure part is a candidate C. It is judged once, when it is confirmed.
        if not centers.blocked and not movements.blocked and not na(centers.pendingLeave) and not na(centers.center)
            if centers.center.lifecycle != "closed" and centers.pendingLeave.id == component.id
                ChanSignalMemo memo = chan_signal_memo(state, centers.center.id)
                array<ChanCenter> wset = chan_signal_wset(centers, movements)
                if wset.size() >= 2
                    if not memo.firstDone
                        chan_signal_trend(state, memo, wset, movements, centers.center, component, macd)
                else if not memo.consolidationDone
                    chan_signal_consolidation(state, memo, centers.center, component, macd)
        // Same-batch order (B-005): first/consolidation point above, then second, then third.
        if state.waits.size() > 0
            array<ChanSignalWait> kept = array.new<ChanSignalWait>()
            for wait in state.waits
                if wait.componentId == component.id
                    kept.push(wait)
                else
                    wait.count += 1
                    if wait.count == 1
                        wait.r1Id := component.id
                        kept.push(wait)
                    else
                        chan_signal_second(state, wait, component)
            state.waits := kept
        if not centers.blocked
            if not na(centers.closedEvent)
                if component.id == centers.closedEvent.returnId
                    chan_signal_third(state, centers.closedEvent, component)
            else if not na(source.pending) and not na(centers.center)
                if centers.center.lifecycle != "closed" and source.pending.id != component.id
                    // The return touches the core edge exactly: it is the middle of the center, not a third-class point.
                    ChanComparison none = na
                    bool upward = source.pending.realEndTicks > centers.center.coreHighTicks
                    bool onEdge = upward ? component.actualLowTicks == centers.center.coreHighTicks : component.actualHighTicks == centers.center.coreLowTicks
                    if onEdge
                        state.notes.push(ChanSignalNote.new("third", "touch-edge", none, array.from(centers.center.id, source.pending.id, component.id)))
        state.pending := centers.pendingLeave
    state

chan_signal_runtime_new(string contextId, int levelLimit) =>
    ChanSignalRuntime result = ChanSignalRuntime.new()
    result.levelLimit := levelLimit
    result.stack := ChanStack.new()
    result.stack.centers := chan_center_new(contextId, 64)
    result.stack.movements := chan_movement_new_level(contextId, 128, 1, levelLimit >= 2)
    result.stack.levels := chan_levels_new(contextId, 64, levelLimit)
    result.d1 := chan_signal_layer_new(contextId, 1)
    result.d2 := chan_signal_layer_new(contextId, 2)
    result.d3 := chan_signal_layer_new(contextId, 3)
    result.events := array.new<ChanSignal>()
    result.notes := array.new<ChanSignalNote>()
    result

// One confirmed L0 part through the mirror stack, then through D1..D3 in the CORE batch order.
// chan_stack_step is the same function the engine uses, so the mirror cannot disagree with it.
// Only a layer that was stepped contributes events and notes; an idle layer keeps its older ones.
chan_signal_part(ChanSignalRuntime source, ChanComponent part, ChanMacd macd) =>
    ChanSignalRuntime result = source.copy()
    result.events := array.new<ChanSignal>()
    result.notes := array.new<ChanSignalNote>()
    result.stack := chan_stack_step(source.stack, part)
    result.d1 := chan_signal_layer_step(source.d1, result.stack.centers, result.stack.movements, part, macd)
    for event in result.d1.events
        result.events.push(event)
    for note in result.d1.notes
        result.notes.push(note)
    ChanComponent upper1 = na
    if not na(result.stack.movements.event)
        upper1 := result.stack.movements.event.upper
    ChanComponent upper2 = na
    if result.levelLimit >= 2 and not na(upper1)
        result.d2 := chan_signal_layer_step(source.d2, result.stack.levels.centers2, result.stack.levels.movements2, upper1, macd)
        for event in result.d2.events
            result.events.push(event)
        for note in result.d2.notes
            result.notes.push(note)
        if not na(result.stack.levels.movements2.event)
            upper2 := result.stack.levels.movements2.event.upper
    if result.levelLimit >= 3 and not na(upper2)
        result.d3 := chan_signal_layer_step(source.d3, result.stack.levels.centers3, result.stack.levels.movements3, upper2, macd)
        for event in result.d3.events
            result.events.push(event)
        for note in result.d3.notes
            result.notes.push(note)
    result
// 5.2 isolated preview. Both functions are pure: the committed runtime and the committed MACD are only read,
// so a candidate that disappears leaves no trace, and a candidate that is confirmed is submitted by the
// normal path exactly once.
type ChanSignalCandidates
    array<ChanSignal> events
    array<ChanSignalNote> notes

// The hypothetical (unconfirmed) segments of the open bar as parts, on a copy of the normalisation state.
// The hypothetical segments themselves are copied before they are marked confirmed, and the engine's
// normalisation state is never touched.
chan_signal_preview_parts(ChanNormalizationState normalized, array<ChanStructure> hypothetical, int previewTime) =>
    array<ChanComponent> parts = array.new<ChanComponent>()
    ChanNormalizationState working = normalized
    for pendingSegment in hypothetical
        ChanStructure segment = chan_structure_copy(pendingSegment)
        segment.confirmed := true
        segment.confirmedAt := previewTime
        working := chan_normalization_step(working, segment)
        parts.push(chan_component_copy(working.event))
    parts

// A copy of the MACD with the open bar pushed. The confirmed series never sees this bar.
chan_macd_preview(ChanMacd source, int openTime, float price) =>
    ChanMacd result = source.copy()
    result.times := source.times.copy()
    result.cumPos := source.cumPos.copy()
    result.cumNeg := source.cumNeg.copy()
    result.difs := source.difs.copy()
    result.deas := source.deas.copy()
    chan_macd_push(result, openTime, price)
    result

// What the hypothetical parts of the open bar would submit, in order. The committed runtime is not changed.
chan_signal_candidates(ChanSignalRuntime committed, array<ChanComponent> parts, ChanMacd macd) =>
    ChanSignalCandidates result = ChanSignalCandidates.new()
    result.events := array.new<ChanSignal>()
    result.notes := array.new<ChanSignalNote>()
    ChanSignalRuntime working = committed
    for part in parts
        working := chan_signal_part(working, part, macd)
        for event in working.events
            result.events.push(event)
        for note in working.notes
            result.notes.push(note)
    result
// END CHANLUN DIVERGENCE

// BEGIN CHANLUN RENDERER
// One registry owns every line, box and label, including previews and diagnostics.
// Drawing descriptors are projections of core records; the registry never owns core state.
type ChanDrawSpec
    string id
    string category
    string primitive
    int x1
    int x2
    float y1
    float y2
    color hue
    int width
    bool confirmed
    string caption
    string tooltip
    int fontSize
    int fillTransparency
    bool ephemeral
    int groupLimit

type ChanDrawing
    string id
    string category
    string primitive
    line lineId
    box boxId
    label labelId
    bool ephemeral
    int touched

type ChanDrawRegistry
    array<ChanDrawing> records
    int frame = 0
    int maxLines = 450
    int maxBoxes = 450
    int maxLabels = 120

type ChanVisualStyle
    color strokeColor = color.blue
    color segmentColor = color.orange
    color l1Color = color.purple
    color l2Color = color.teal
    color l3Color = color.red
    int strokeWidth = 1
    int segmentWidth = 2
    int movementWidth = 3
    int centerTransparency = 90
    int centerWidth = 2
    int strokeLabelStride = 1
    int segmentLabelStride = 1
    int fontSize = 12
    bool detailed = false

chan_layer_color(int level, ChanVisualStyle style) =>
    level <= 1 ? style.l1Color : level == 2 ? style.l2Color : style.l3Color

chan_draw_new(int labelLimit) =>
    ChanDrawRegistry registry = ChanDrawRegistry.new()
    registry.records := array.new<ChanDrawing>()
    registry.maxLabels := labelLimit
    registry

chan_draw_count(ChanDrawRegistry registry, string primitive, string category) =>
    int count = 0
    if registry.records.size() > 0
        for record in registry.records
            if (primitive == "" or record.primitive == primitive) and (category == "" or record.category == category)
                count += 1
    count

chan_draw_index(ChanDrawRegistry registry, string id) =>
    int found = -1
    if registry.records.size() > 0
        for index = 0 to registry.records.size() - 1
            if registry.records.get(index).id == id
                found := index
                break
    found

chan_draw_delete(ChanDrawRegistry registry, int index) =>
    ChanDrawing record = registry.records.remove(index)
    if not na(record.lineId)
        line.delete(record.lineId)
    if not na(record.boxId)
        box.delete(record.boxId)
    if not na(record.labelId)
        label.delete(record.labelId)
    true

// Confirmed signal marks are never the first victim of the global label budget; they only go when nothing else is left.
chan_draw_oldest(ChanDrawRegistry registry, string primitive, string category) =>
    int found = -1
    int protectedFound = -1
    if registry.records.size() > 0
        for index = 0 to registry.records.size() - 1
            ChanDrawing record = registry.records.get(index)
            if (primitive == "" or record.primitive == primitive) and (category == "" or record.category == category)
                if category == "" and str.startswith(record.category, "D-signal")
                    if protectedFound < 0
                        protectedFound := index
                else
                    found := index
                    break
    found >= 0 ? found : protectedFound

chan_draw_put(ChanDrawRegistry registry, ChanDrawSpec spec) =>
    if na(spec.x1) or na(spec.x2) or na(spec.y1) or na(spec.y2) or spec.x2 < spec.x1 or spec.width < 1 or spec.fontSize < 1 or spec.fillTransparency < 0 or spec.fillTransparency > 100
        runtime.error("绘图描述缺少有效时价或样式")
    // Degenerate intervals share the line budget rather than disappearing as zero-height boxes.
    string primitive = spec.primitive == "box" and spec.y1 == spec.y2 ? "line" : spec.primitive
    if primitive != "line" and primitive != "box" and primitive != "label"
        runtime.error("绘图对象类型无效")
    int index = chan_draw_index(registry, spec.id)
    if index >= 0
        ChanDrawing previous = registry.records.get(index)
        if previous.primitive != primitive or previous.category != spec.category
            chan_draw_delete(registry, index)
            index := -1
    int limit = primitive == "line" ? registry.maxLines : primitive == "box" ? registry.maxBoxes : registry.maxLabels
    if limit < 1 or spec.groupLimit < 1
        if index >= 0
            chan_draw_delete(registry, index)
    else
        if index < 0
            while chan_draw_count(registry, primitive, "") >= limit
                chan_draw_delete(registry, chan_draw_oldest(registry, primitive, ""))
            while chan_draw_count(registry, "", spec.category) >= spec.groupLimit
                chan_draw_delete(registry, chan_draw_oldest(registry, "", spec.category))
            ChanDrawing created = ChanDrawing.new()
            created.id := spec.id
            created.category := spec.category
            created.primitive := primitive
            if primitive == "line"
                created.lineId := line.new(spec.x1, spec.y1, spec.x2, spec.y2, xloc = xloc.bar_time)
            else if primitive == "box"
                created.boxId := box.new(spec.x1, math.max(spec.y1, spec.y2), spec.x2, math.min(spec.y1, spec.y2), xloc = xloc.bar_time)
            else
                created.labelId := label.new(spec.x1, spec.y1, xloc = xloc.bar_time)
            registry.records.push(created)
            index := registry.records.size() - 1
        ChanDrawing record = registry.records.get(index)
        record.ephemeral := spec.ephemeral
        record.touched := registry.frame
        if primitive == "line"
            line.set_xy1(record.lineId, spec.x1, spec.y1)
            line.set_xy2(record.lineId, spec.x2, spec.y2)
            line.set_color(record.lineId, spec.hue)
            line.set_width(record.lineId, spec.width)
            line.set_style(record.lineId, spec.confirmed ? line.style_solid : line.style_dashed)
        else if primitive == "box"
            box.set_lefttop(record.boxId, spec.x1, math.max(spec.y1, spec.y2))
            box.set_rightbottom(record.boxId, spec.x2, math.min(spec.y1, spec.y2))
            box.set_border_color(record.boxId, spec.hue)
            box.set_border_width(record.boxId, spec.width)
            box.set_border_style(record.boxId, spec.confirmed ? line.style_solid : line.style_dashed)
            box.set_bgcolor(record.boxId, color.new(spec.hue, spec.fillTransparency))
        else
            label.set_xy(record.labelId, spec.x1, spec.y1)
            label.set_text(record.labelId, spec.caption)
            label.set_tooltip(record.labelId, spec.tooltip)
            string captionStyle = switch spec.category
                "P-caption" => label.style_label_left
                "S-caption" => label.style_label_down
                "N-caption" => label.style_label_up
                "F" => label.style_label_right
                "K-caption" => label.style_label_up
                "D-signal-buy" => label.style_label_up
                "D-signal-sell" => label.style_label_down
                "D-candidate-buy" => label.style_label_up
                "D-candidate-sell" => label.style_label_down
                "D-diag-top" => label.style_label_down
                "D-diag-bottom" => label.style_label_up
                => label.style_none
            label.set_style(record.labelId, captionStyle)
            // Confirmed signals are solid; candidates and structure captions are hollow text.
            bool solidMark = str.startswith(spec.category, "D-signal")
            label.set_color(record.labelId, solidMark ? spec.hue : color.new(spec.hue, 100))
            label.set_textcolor(record.labelId, solidMark ? color.white : spec.hue)
            bool diagnosticCaption = spec.category == "F" or spec.category == "F-confirmation" or spec.category == "S-confirmation" or spec.category == "K-caption" or str.startswith(spec.category, "S-feature-")
            label.set_size(record.labelId, diagnosticCaption ? math.min(12, spec.fontSize) : spec.fontSize)
    true

chan_draw_begin(ChanDrawRegistry registry) =>
    registry.frame += 1
    true

chan_draw_sweep(ChanDrawRegistry registry) =>
    if registry.records.size() > 0
        for index = registry.records.size() - 1 to 0
            ChanDrawing record = registry.records.get(index)
            if record.ephemeral and record.touched != registry.frame
                chan_draw_delete(registry, index)
    true

chan_fractal_spec(ChanFractal fractal, float tickSize, bool confirmed, color topColor, color bottomColor, int fontSize, bool detailed, bool ephemeral, int groupLimit) =>
    string shortId = "F" + (fractal.kind == 1 ? "顶" : "底") + "#" + str.tostring(fractal.middleOrdinal + 1)
    string caption = shortId + (confirmed ? "" : " · 候选")
    string tooltip = "分型结构编号，不是买卖点编号"
    if detailed
        tooltip += "\n" + fractal.id + "\n规则：" + fractal.ruleId + "\n来源时间：" + str.format_time(fractal.endpointTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
        tooltip += confirmed ? "\n确认时间：" + str.format_time(fractal.confirmedAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC" : "\n未确认；尾部可变化"
        tooltip += "\n依赖：" + fractal.leftId + "\n" + fractal.middleId + "\n" + fractal.rightId
    ChanDrawSpec.new(fractal.id, "F", "label", fractal.endpointTime, fractal.endpointTime, fractal.priceTicks * tickSize, fractal.priceTicks * tickSize, fractal.kind == 1 ? topColor : bottomColor, 1, confirmed, caption, tooltip, fontSize, 100, ephemeral, groupLimit)

chan_draw_remove_id(ChanDrawRegistry registry, string id) =>
    int index = chan_draw_index(registry, id)
    if index >= 0
        chan_draw_delete(registry, index)
    true

chan_caption_visible(bool enabled, bool confirmed, int ordinal, int stride) =>
    enabled and (not confirmed or (ordinal - 1) % math.max(1, stride) == 0)

// Adapters accept actual core records. Production only calls adapters for implemented modules.
chan_draw_structure(ChanDrawRegistry registry, ChanStructure source, float tickSize, ChanVisualStyle style, bool withCaption) =>
    if na(source.objectType) or (source.objectType != "stroke" and source.objectType != "segment")
        runtime.error("该结构须使用对应层级的绘图适配器")
    if source.confirmed and na(source.confirmedAt)
        runtime.error("已确认结构缺少确认时刻")
    bool stroke = source.objectType == "stroke"
    string tag = stroke ? "P" : "S"
    color hue = stroke ? style.strokeColor : style.segmentColor
    int width = stroke ? style.strokeWidth : style.segmentWidth
    int cap = stroke ? 150 : 60
    chan_draw_put(registry, ChanDrawSpec.new(source.id + "/line", tag + "-line", "line", source.startTime, source.endTime, source.startTicks * tickSize, source.endTicks * tickSize, hue, width, source.confirmed, "", "", style.fontSize, 100, not source.confirmed, cap))
    if chan_caption_visible(withCaption, source.confirmed, source.ordinal, stroke ? style.strokeLabelStride : style.segmentLabelStride)
        string caption = tag + "#" + str.tostring(source.ordinal) + (source.confirmed ? "" : " · 候选")
        string tooltip = style.detailed ? source.id + "\n规则：" + source.ruleId : "结构编号，不是买卖点编号"
        if style.detailed
            tooltip += "\n端点时间：" + str.format_time(source.endTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
            tooltip += source.confirmed ? "\n确认时间：" + str.format_time(source.confirmedAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC" : "\n未锁定；尾部可改变"
            if not na(source.memberLowTicks) and not na(source.memberHighTicks)
                tooltip += "\n归属笔端点范围：" + str.tostring(source.memberLowTicks * tickSize) + "～" + str.tostring(source.memberHighTicks * tickSize)
            if not na(source.dependencies) and source.dependencies.size() > 0
                int separator = str.pos(source.id, "/" + tag + "/")
                string contextPrefix = na(separator) ? "" : str.substring(source.id, 0, separator + 1)
                tooltip += contextPrefix == "" ? "\n证据：" : "\n证据（缩写沿用上方 ID 的上下文）："
                for dependency in source.dependencies
                    string dependencyId = contextPrefix != "" and str.startswith(dependency, contextPrefix) ? str.substring(dependency, str.length(contextPrefix)) : dependency
                    tooltip += "\n" + dependencyId
        chan_draw_put(registry, ChanDrawSpec.new(source.id + "/caption", tag + "-caption", "label", source.endTime, source.endTime, source.endTicks * tickSize, source.endTicks * tickSize, hue, 1, source.confirmed, caption, tooltip, style.fontSize, 100, not source.confirmed, 120))
    else
        chan_draw_remove_id(registry, source.id + "/caption")
    true

chan_draw_component(ChanDrawRegistry registry, ChanComponent source, float tickSize, ChanVisualStyle style) =>
    string tooltip = "L0独立分析区间 · " + source.ruleId + "\n来源段：" + source.segmentId
    tooltip += "\n真实端点：" + str.tostring(source.realStartTicks * tickSize) + " → " + str.tostring(source.realEndTicks * tickSize)
    tooltip += "\n分析端点：" + str.tostring(source.analysisStartTicks * tickSize) + " → " + str.tostring(source.analysisEndTicks * tickSize)
    tooltip += "\n分析时间采用真实段边界；极值来源另记"
    tooltip += "\n低点来源：" + str.format_time(source.actualLowTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC\n高点来源：" + str.format_time(source.actualHighTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
    tooltip += "\n确认：" + str.format_time(source.confirmedAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
    chan_draw_put(registry, ChanDrawSpec.new(source.id + "/line", "N-line", "line", source.analysisStartTime, source.analysisEndTime, source.analysisStartTicks * tickSize, source.analysisEndTicks * tickSize, color.gray, 1, true, "", "", style.fontSize, 100, false, 60))
    chan_draw_put(registry, ChanDrawSpec.new(source.id + "/caption", "N-caption", "label", source.analysisEndTime, source.analysisEndTime, source.analysisEndTicks * tickSize, source.analysisEndTicks * tickSize, color.gray, 1, true, "N0#" + str.tostring(source.ordinal), tooltip, style.fontSize, 100, false, 60))
    true

chan_draw_center(ChanDrawRegistry registry, ChanCenter source, float tickSize, ChanVisualStyle style, bool withCaption) =>
    if na(source.level) or na(source.coreLowTicks) or na(source.coreHighTicks) or source.level < 1 or source.level > 3 or source.coreLowTicks > source.coreHighTicks
        runtime.error("中枢层级或核心区间无效")
    color hue = chan_layer_color(source.level, style)
    string tag = "L" + str.tostring(source.level) + "-Z"
    bool confirmed = not na(source.confirmedAt)
    chan_draw_put(registry, ChanDrawSpec.new(source.id + "/range", tag + "-range", "box", source.startTime, source.extentEndTime, source.coreLowTicks * tickSize, source.coreHighTicks * tickSize, hue, style.centerWidth, confirmed, "", "", style.fontSize, style.centerTransparency, not confirmed, 15))
    if withCaption
        string caption = tag + "#" + str.tostring(source.ordinal) + (source.coreLowTicks == source.coreHighTicks ? " · 退化" : "") + (confirmed ? "" : " · 候选")
        string tooltip = style.detailed ? source.id + "\n规则：" + source.ruleId : "中枢结构编号"
        if style.detailed
            tooltip += "\n状态：" + (source.lifecycle == "closed" ? "离开已证实" : "延伸／回试中") + "\nZ波动数：" + str.tostring(source.zWaves)
            tooltip += "\nGG/G/D/DD：" + str.tostring(source.ggTicks * tickSize, format.mintick) + "/" + str.tostring(source.gTicks * tickSize, format.mintick) + "/" + str.tostring(source.dTicks * tickSize, format.mintick) + "/" + str.tostring(source.ddTicks * tickSize, format.mintick)
            if not na(source.closedAt)
                tooltip += "\n离开证明可用：" + str.format_time(source.closedAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC\n离开部件：" + source.leaveId + "\n回试部件：" + source.returnId
        chan_draw_put(registry, ChanDrawSpec.new(source.id + "/caption", tag + "-caption", "label", source.startTime, source.startTime, source.coreHighTicks * tickSize, source.coreHighTicks * tickSize, hue, 1, confirmed, caption, tooltip, style.fontSize, 100, not confirmed, 15))
    else
        chan_draw_remove_id(registry, source.id + "/caption")
    true

chan_draw_movement(ChanDrawRegistry registry, ChanMovement source, float tickSize, ChanVisualStyle style, bool withCaption) =>
    if na(source.level) or source.level < 1 or source.level > 3 or (source.completed and (na(source.confirmedAt) or na(source.completionProof) or source.completionProof == ""))
        runtime.error("走势层级或完成证明无效")
    color hue = chan_layer_color(source.level, style)
    string tag = "L" + str.tostring(source.level) + "-M"
    chan_draw_put(registry, ChanDrawSpec.new(source.id + "/line", tag + "-line", "line", source.startTime, source.endTime, source.startTicks * tickSize, source.endTicks * tickSize, hue, style.movementWidth + source.level - 1, source.completed, "", "", style.fontSize, 100, not source.completed, 30))
    if withCaption
        // The renderer never infers a trend from slope or endpoint price comparisons.
        string morphology = source.morphology == "consolidation" ? "盘整" : source.morphology == "trend" ? (source.direction == 1 ? "上涨" : "下跌") : source.morphology == "expansion-evidence" ? "含扩展证据" : source.morphology == "uptrend" ? "上涨" : source.morphology == "downtrend" ? "下跌" : "待定"
        string caption = tag + "#" + str.tostring(source.ordinal) + " · " + morphology + (source.completed ? "" : " · 进行中") + (source.truncated ? " · 起点截断" : "")
        string tooltip = style.detailed ? source.id + "\n规则：" + source.ruleId : "走势类型来自计算内核"
        chan_draw_put(registry, ChanDrawSpec.new(source.id + "/caption", tag + "-caption", "label", source.endTime, source.endTime, source.endTicks * tickSize, source.endTicks * tickSize, hue, 1, source.completed, caption, tooltip, style.fontSize, 100, not source.completed, 30))
    true
// Completed movements are solid; the open one is dashed and untyped. Its id equals
// the id the completed record will carry, so completion redraws it in place.
chan_draw_movement_layer(ChanDrawRegistry registry, ChanMovementState state, float tickSize, ChanVisualStyle style, bool withCaption) =>
    for item in state.history
        chan_draw_movement(registry, item, tickSize, style, withCaption)
    if state.active and state.members.size() > 0
        ChanComponent tail = state.members.last()
        ChanMovement progress = ChanMovement.new(state.contextId + "/L" + str.tostring(state.level) + "/R/" + str.tostring(state.count + 1) + "/" + str.tostring(state.startTime), state.level, state.direction, state.startTime, tail.realEndTime, state.startTicks, tail.analysisEndTicks, "", false, na, "", "R-002", array.new<string>(), array.new<string>(), state.count + 1)
        progress.truncated := state.truncated
        chan_draw_movement(registry, progress, tickSize, style, withCaption)
    true
// Research projection of a supplied S hypothesis; never fabricates S segments.
chan_draw_features(ChanDrawRegistry registry, ChanFeatureSequence sequence, float tickSize, ChanVisualStyle style) =>
    int count = sequence.elements.size()
    if count > 0
        for index = math.max(0, count - 12) to count - 1
            ChanFeature element = sequence.elements.get(index)
            string sequenceName = sequence.secondSequence ? "第二特征序列" : "第一特征序列"
            string caption = (sequence.secondSequence ? "E2#" : "E1#") + str.tostring(element.firstOrdinal) + (element.lastOrdinal == element.firstOrdinal ? "" : "–" + str.tostring(element.lastOrdinal))
            string tooltip = sequenceName + " · 元素诊断\n规则：S-001/S-002/S-003/E-006\n" + element.id + "\n来源笔："
            for sourceId in element.sourceIds
                tooltip += "\n" + sourceId
            tooltip += "\n高点来源：" + str.format_time(element.highTime, "yyyy-MM-dd HH:mm", "UTC") + "\n低点来源：" + str.format_time(element.lowTime, "yyyy-MM-dd HH:mm", "UTC")
            if not na(sequence.boundaryTime)
                tooltip += "\n假设分界：" + str.format_time(sequence.boundaryTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
            chan_draw_put(registry, ChanDrawSpec.new(element.id + "/range", "S-feature-range", "box", element.firstTime, element.lastTime, element.lowTicks * tickSize, element.highTicks * tickSize, style.segmentColor, 1, false, "", "", style.fontSize, 96, true, 24))
            chan_draw_put(registry, ChanDrawSpec.new(element.id + "/caption", "S-feature-caption", "label", element.lastTime, element.lastTime, element.highTicks * tickSize, element.highTicks * tickSize, style.segmentColor, 1, false, caption, tooltip, style.fontSize, 100, true, 24))
    ChanFeatureTurn turn = chan_feature_turn(sequence)
    if not na(turn)
        string caption = (turn.kind == 1 ? "特征顶" : "特征底") + (turn.gap ? " · 有缺口" : " · 无缺口") + " · 候选"
        chan_draw_put(registry, ChanDrawSpec.new(sequence.contextId + "/turn", "S-feature-turn", "label", turn.endpointTime, turn.endpointTime, turn.priceTicks * tickSize, turn.priceTicks * tickSize, style.segmentColor, 1, false, caption, "特征几何不等于段终结；仍待合法起始、破坏与归属证明", style.fontSize, 100, true, 4))
    if not na(sequence.heldInput)
        ChanStructure held = sequence.heldInput
        string caption = sequence.blocked ? "特征序列受限：依赖预算" : "特征序列等待：先前方向"
        chan_draw_put(registry, ChanDrawSpec.new(sequence.contextId + "/held", "S-feature-held", "label", held.endTime, held.endTime, held.endTicks * tickSize, held.endTicks * tickSize, style.segmentColor, 1, false, caption, "未决笔及已有依赖保留；不提交线段确认", style.fontSize, 100, true, 4))
    true
// END CHANLUN RENDERER

// ==================== Inputs: only implemented features are exposed ====================
string groupContext = "分析范围"
int initialBars = input.int(5000, "初始最近K线数", minval = 100, maxval = 5000, group = groupContext)
bool fixedStart = input.bool(false, "使用固定起点", group = groupContext)
int requestedStart = input.time(1700000000000, "固定起点", group = groupContext)
int sampleLimit = input.int(20000, "固定起点样本上限", minval = 100, maxval = 100000, group = groupContext)
int levelLimit = input.int(3, "走势层数上限（L1～L3）", minval = 1, maxval = 3, group = groupContext)
int macdFast = input.int(12, "MACD快线", minval = 1, maxval = 200, group = "MACD（信号阶段）")
int macdSlow = input.int(26, "MACD慢线", minval = 2, maxval = 400, group = "MACD（信号阶段）")
int macdSignal = input.int(9, "MACD信号线", minval = 1, maxval = 200, group = "MACD（信号阶段）")
string viewMode = input.string("普通", "视图", options = ["普通", "研究"], group = "显示")
bool showFractals = input.bool(false, "显示分型结构编号", group = "显示")
bool showStrokes = input.bool(true, "显示蓝色笔", group = "笔")
bool showStrokeIds = input.bool(true, "显示笔结构编号", group = "笔")
int strokeLabelStride = input.int(1, "笔编号间隔", minval = 1, maxval = 20, group = "笔")
color strokeColor = input.color(color.blue, "笔颜色", group = "笔")
int strokeWidth = input.int(1, "笔线宽", minval = 1, maxval = 3, group = "笔")
bool showSegments = input.bool(true, "显示橙色线段", group = "线段")
bool showSegmentIds = input.bool(true, "显示线段结构编号", group = "线段")
int segmentLabelStride = input.int(1, "线段编号间隔", minval = 1, maxval = 20, group = "线段")
color segmentColor = input.color(color.orange, "线段颜色", group = "线段")
int segmentWidth = input.int(2, "线段线宽", minval = 1, maxval = 5, group = "线段")
int segmentPendingLimit = input.int(64, "未完成笔依赖上限", minval = 16, maxval = 128, group = "线段")
int labelStride = input.int(1, "每几个确认分型显示一个编号", minval = 1, maxval = 20, group = "显示")
int fontSize = input.int(12, "提示字号", minval = 8, maxval = 24, group = "显示")
color topColor = input.color(color.orange, "顶分型颜色", group = "显示")
color bottomColor = input.color(color.blue, "底分型颜色", group = "显示")
int labelBudget = input.int(120, "全局研究标签上限", minval = 12, maxval = 120, group = "显示")
bool showMerged = input.bool(true, "研究：显示近期包含处理范围", group = "研究视图")
bool showCandidates = input.bool(false, "研究：显示候选信号（实时预览，未收盘K线）", group = "研究视图")
bool showConfirmations = input.bool(true, "研究：显示确认时刻", group = "研究视图")
bool showFeatures = input.bool(false, "研究：显示线段特征与缺口", group = "研究视图")
bool showNormalized = input.bool(false, "研究：显示L0标准化映射", group = "研究视图")
bool showCenters = input.bool(true, "显示L1中枢", group = "L1中枢")
bool showCenterIds = input.bool(true, "显示L1中枢编号", group = "L1中枢")
int centerWidth = input.int(2, "L1中枢边框线宽", minval = 1, maxval = 5, group = "L1中枢")
color centerColor = input.color(color.rgb(192, 132, 252), "L1中枢颜色", group = "L1中枢")
int centerTransparency = input.int(90, "中枢填充透明度", minval = 75, maxval = 100, group = "L1中枢")
bool showMovements1 = input.bool(true, "显示L1走势", group = "L1中枢")
bool showMovements2 = input.bool(true, "显示L2走势", group = "L2层")
bool showCenters2 = input.bool(true, "显示L2中枢", group = "L2层")
