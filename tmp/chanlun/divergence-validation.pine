//@version=6
indicator("缠论背驰层共享验证", overlay=false)
// CORE units (verbatim subset) SHA-256: 7034772ef7787c19cda20f625b324acf46f2d91731970ac2547505694c9d13d5
// SIGNALS section SHA-256: f5869e11d7ccf2784cf9c66019167facfe4bf15c261020f22db3a422a8f0b178
// DIVERGENCE section SHA-256: 89ebf4da55d2375b03948f98cb8691a1c6c0d27a5f3f477bfc4f31ea5f903d04
// Generated from the independent signal samples. Run in TradingView; generation is not a test pass.
// Shared contracts for later modules. An absent proof is represented by na,
// never by an invented completed structure. These types do not produce signals.
type ChanStructure
    string id
    string objectType
    int level
    int direction
    int startTime
    int endTime
    int startTicks
    int endTicks
    bool confirmed = false
    int confirmedAt = na
    string ruleId
    array<string> dependencies
    int ordinal = 0
    int memberLowTicks = na
    int memberHighTicks = na
    int memberLowTime = na
    int memberHighTime = na

type ChanComponent
    string id
    string segmentId
    int realStartTime
    int realEndTime
    int realStartTicks
    int realEndTicks
    int actualLowTicks
    int actualHighTicks
    int actualLowTime
    int actualHighTime
    int analysisStartTime
    int analysisEndTime
    int analysisStartTicks
    int analysisEndTicks
    int direction
    int confirmedAt
    string ruleId
    array<string> dependencies
    int ordinal = 0

type ChanCenter
    string id
    int level
    int coreLowTicks
    int coreHighTicks
    int ggTicks
    int gTicks
    int dTicks
    int ddTicks
    int startTime
    int formedAt
    int extentEndTime
    int confirmedAt = na
    bool degenerate = false
    string lifecycle
    string ruleId
    array<string> dependencies
    int ordinal = 0
    int zWaves = 0
    int closedAt = na
    string leaveId = ""
    string returnId = ""

type ChanMovement
    string id
    int level
    int direction
    int startTime
    int endTime
    int startTicks
    int endTicks
    string morphology
    bool completed = false
    int confirmedAt = na
    string completionProof
    string ruleId
    array<string> childIds
    array<string> centerIds
    int ordinal = 0
    int lowTicks = na
    int highTicks = na
    int lowTime = na
    int highTime = na
    int occurredAt = na
    bool truncated = false
    ChanComponent upper

chan_structure_copy(ChanStructure source) =>
    ChanStructure result = na
    if not na(source)
        result := source.copy()
        if not na(source.dependencies)
            result.dependencies := source.dependencies.copy()
    result

chan_structure_signature(ChanStructure source) =>
    string result = "none"
    if not na(source)
        result := source.id + "/" + source.objectType + "/" + str.tostring(source.level) + "/" + str.tostring(source.direction) + "/" + str.tostring(source.startTime) + "/" + str.tostring(source.endTime) + "/" + str.tostring(source.startTicks) + "/" + str.tostring(source.endTicks) + "/" + str.tostring(source.confirmed) + "/" + str.tostring(source.confirmedAt) + "/" + str.tostring(source.ordinal) + "/" + source.ruleId
        result += "/members/" + str.tostring(source.memberLowTicks) + "/" + str.tostring(source.memberHighTicks) + "/" + str.tostring(source.memberLowTime) + "/" + str.tostring(source.memberHighTime)
        if not na(source.dependencies)
            for dependency in source.dependencies
                result += "/" + dependency
    result

// N consumes only committed segment events. Each segment owns its own range;
// geometric time anchors and actual extreme source times are separate (E-008).
type ChanNormalizationState
    string contextId
    int count = 0
    ChanStructure lastInput
    ChanComponent lastComponent
    ChanComponent event

chan_component_copy(ChanComponent source) =>
    ChanComponent result = na
    if not na(source)
        result := source.copy()
        result.dependencies := source.dependencies.copy()
    result

chan_component_signature(ChanComponent source) =>
    string result = "na"
    if not na(source)
        result := source.id + "/" + source.segmentId + "/" + str.tostring(source.realStartTime) + "/" + str.tostring(source.realEndTime) + "/" + str.tostring(source.realStartTicks) + "/" + str.tostring(source.realEndTicks) + "/" + str.tostring(source.actualLowTicks) + "/" + str.tostring(source.actualHighTicks) + "/" + str.tostring(source.actualLowTime) + "/" + str.tostring(source.actualHighTime) + "/" + str.tostring(source.analysisStartTime) + "/" + str.tostring(source.analysisEndTime) + "/" + str.tostring(source.analysisStartTicks) + "/" + str.tostring(source.analysisEndTicks) + "/" + str.tostring(source.direction) + "/" + str.tostring(source.confirmedAt) + "/" + source.ruleId + "/" + str.tostring(source.ordinal)
        for dependency in source.dependencies
            result += "/" + dependency
    result

chan_normalization_new(string contextId) =>
    ChanNormalizationState result = ChanNormalizationState.new()
    result.contextId := contextId
    result

chan_normalization_clone(ChanNormalizationState source) =>
    ChanNormalizationState result = source.copy()
    result.lastInput := chan_structure_copy(source.lastInput)
    result.lastComponent := chan_component_copy(source.lastComponent)
    result.event := chan_component_copy(source.event)
    result

chan_normalization_valid(ChanStructure source) =>
    bool valid = false
    if not na(source)
        valid := source.objectType == "segment" and source.level == 0 and source.confirmed and not na(source.confirmedAt) and not na(source.id) and source.id != "" and source.ordinal > 0 and (source.direction == 1 or source.direction == -1) and source.startTime < source.endTime and source.confirmedAt >= source.endTime and source.direction * (source.endTicks - source.startTicks) > 0
        valid := valid and not na(source.memberLowTicks) and not na(source.memberHighTicks) and source.memberLowTicks < source.memberHighTicks and source.memberLowTicks <= math.min(source.startTicks, source.endTicks) and source.memberHighTicks >= math.max(source.startTicks, source.endTicks)
        valid := valid and source.memberLowTime >= source.startTime and source.memberLowTime <= source.endTime and source.memberHighTime >= source.startTime and source.memberHighTime <= source.endTime and not na(source.dependencies)
    valid

chan_normalization_step(ChanNormalizationState source, ChanStructure segment) =>
    if not chan_normalization_valid(segment)
        runtime.error("标准化仅消费具备归属极值摘要的确认线段")
    ChanNormalizationState state = chan_normalization_clone(source)
    state.event := na
    bool duplicate = not na(source.lastInput) and segment.id == source.lastInput.id
    if duplicate
        if chan_structure_signature(segment) != chan_structure_signature(source.lastInput)
            runtime.error("已标准化线段发生变化")
    else
        if segment.ordinal != source.count + 1
            runtime.error("标准化线段序号不连续")
        if not na(source.lastInput)
            if segment.startTime != source.lastInput.endTime or segment.startTicks != source.lastInput.endTicks or segment.direction != -source.lastInput.direction or segment.confirmedAt < source.lastInput.confirmedAt
                runtime.error("标准化线段输入不连续")
        ChanComponent component = ChanComponent.new()
        component.id := source.contextId + "/N/" + str.tostring(segment.ordinal) + "/" + str.tostring(segment.startTime)
        component.segmentId := segment.id
        component.realStartTime := segment.startTime
        component.realEndTime := segment.endTime
        component.realStartTicks := segment.startTicks
        component.realEndTicks := segment.endTicks
        component.actualLowTicks := segment.memberLowTicks
        component.actualHighTicks := segment.memberHighTicks
        component.actualLowTime := segment.memberLowTime
        component.actualHighTime := segment.memberHighTime
        component.analysisStartTime := segment.startTime
        component.analysisEndTime := segment.endTime
        component.analysisStartTicks := segment.direction == 1 ? segment.memberLowTicks : segment.memberHighTicks
        component.analysisEndTicks := segment.direction == 1 ? segment.memberHighTicks : segment.memberLowTicks
        component.direction := segment.direction
        component.confirmedAt := segment.confirmedAt
        component.ruleId := "N-001/E-008"
        component.dependencies := array.from(segment.id)
        component.ordinal := segment.ordinal
        state.count += 1
        state.lastInput := chan_structure_copy(segment)
        state.lastComponent := component
        state.event := component
    state
// L1 center chain. Relation snapshots never emit R completion or L2 input.
type ChanCenterState
    string contextId
    array<ChanComponent> seed
    ChanComponent lastInput
    ChanComponent counter
    ChanComponent heldInput
    ChanCenter center
    ChanCenter event
    int inputCount = 0
    int direction = 0
    int waves = 0
    int maxSources = 64
    int level = 1
    bool waitingRelation = false
    bool blocked = false

    ChanComponent pendingLeave
    ChanCenter previous
    ChanCenter closedEvent
    array<ChanCenter> history
    int count = 0
    string relationKind = "none"
    int relationAt = na

chan_center_copy(ChanCenter source) =>
    ChanCenter result = na
    if not na(source)
        result := source.copy()
        result.dependencies := source.dependencies.copy()
    result

chan_center_new_level(string contextId, int maxSources, int level) =>
    if maxSources < 3
        runtime.error("中枢来源预算至少为3")
    if level < 1 or level > 3
        runtime.error("中枢层级只支持1到3")
    ChanCenterState result = ChanCenterState.new()
    result.contextId := contextId
    result.maxSources := maxSources
    result.level := level
    result.seed := array.new<ChanComponent>()
    result.history := array.new<ChanCenter>()
    result

chan_center_new(string contextId, int maxSources) =>
    chan_center_new_level(contextId, maxSources, 1)

chan_center_clone(ChanCenterState source) =>
    ChanCenterState result = source.copy()
    result.seed := array.new<ChanComponent>()
    for member in source.seed
        result.seed.push(chan_component_copy(member))
    result.lastInput := chan_component_copy(source.lastInput)
    result.counter := chan_component_copy(source.counter)
    result.heldInput := chan_component_copy(source.heldInput)
    result.center := chan_center_copy(source.center)
    result.event := chan_center_copy(source.event)
    result.pendingLeave := chan_component_copy(source.pendingLeave)
    result.previous := chan_center_copy(source.previous)
    result.closedEvent := chan_center_copy(source.closedEvent)
    result.history := array.new<ChanCenter>()
    for center in source.history
        result.history.push(chan_center_copy(center))
    result

chan_center_valid(ChanComponent component) =>
    bool valid = false
    if not na(component)
        valid := not na(component.confirmedAt) and component.confirmedAt >= component.realEndTime and component.realStartTime < component.realEndTime and component.actualLowTicks < component.actualHighTicks and (component.direction == 1 or component.direction == -1) and component.direction * (component.realEndTicks - component.realStartTicks) > 0 and component.ordinal > 0
        valid := valid and component.actualLowTicks <= math.min(component.realStartTicks, component.realEndTicks) and component.actualHighTicks >= math.max(component.realStartTicks, component.realEndTicks)
        valid := valid and component.analysisStartTime == component.realStartTime and component.analysisEndTime == component.realEndTime and component.analysisStartTicks == (component.direction == 1 ? component.actualLowTicks : component.actualHighTicks) and component.analysisEndTicks == (component.direction == 1 ? component.actualHighTicks : component.actualLowTicks)
        valid := valid and component.actualLowTime >= component.realStartTime and component.actualLowTime <= component.realEndTime and component.actualHighTime >= component.realStartTime and component.actualHighTime <= component.realEndTime and not na(component.dependencies)
    valid

chan_center_relation(ChanCenter older, ChanCenter newer) =>
    string kind = "unavailable"
    if not na(older) and not na(newer) and older.level == newer.level and not na(older.confirmedAt) and not na(newer.confirmedAt)
        kind := newer.ddTicks > older.ggTicks ? "up-continuation" : newer.ggTicks < older.ddTicks ? "down-continuation" : (newer.coreLowTicks > older.coreHighTicks or newer.coreHighTicks < older.coreLowTicks) ? "range-overlap" : "core-overlap"
    kind

chan_center_commit(ChanCenterState state, ChanComponent component) =>
    if state.center.dependencies.indexof(component.id) < 0
        if state.center.dependencies.size() >= state.maxSources
            state.blocked := true
        else
            state.center.dependencies.push(component.id)
            state.center.extentEndTime := component.realEndTime
            if component.direction == state.direction
                state.center.ggTicks := math.max(state.center.ggTicks, component.actualHighTicks)
                state.center.gTicks := math.min(state.center.gTicks, component.actualHighTicks)
                state.center.dTicks := math.max(state.center.dTicks, component.actualLowTicks)
                state.center.ddTicks := math.min(state.center.ddTicks, component.actualLowTicks)
                state.waves += 1
                state.center.zWaves := state.waves
    true

chan_center_close(ChanCenterState state, ChanComponent departure, ChanComponent returning) =>
    state.center.lifecycle := "closed"
    state.center.closedAt := returning.confirmedAt
    state.center.leaveId := departure.id
    state.center.returnId := returning.id
    state.previous := chan_center_copy(state.center)
    state.closedEvent := chan_center_copy(state.center)
    state.history.push(chan_center_copy(state.center))
    if state.history.size() > 15
        state.history.shift()
    state.pendingLeave := na
    state.seed := array.from(chan_component_copy(returning))
    state.relationKind := "new-center-pending"
    state.relationAt := returning.confirmedAt
    true

chan_center_step(ChanCenterState source, ChanComponent component) =>
    if not chan_center_valid(component)
        runtime.error("中枢仅消费已确认L0部件")
    ChanCenterState state = chan_center_clone(source)
    state.event := na
    state.closedEvent := na
    bool duplicate = not na(source.lastInput) and component.id == source.lastInput.id
    if duplicate
        if chan_component_signature(component) != chan_component_signature(source.lastInput)
            runtime.error("已消费L0发生变化")
    else if not source.blocked
        if component.ordinal != source.inputCount + 1
            runtime.error("中枢L0序号不连续")
        if not na(source.lastInput)
            // L0 parts share real endpoints. A submitted upper part keeps its own range,
            // so above L1 only the time seam, alternation and clock are required.
            if component.realStartTime != source.lastInput.realEndTime or (source.level == 1 and component.realStartTicks != source.lastInput.realEndTicks) or component.direction != -source.lastInput.direction or component.confirmedAt < source.lastInput.confirmedAt
                runtime.error("中枢输入不连续")
        if na(state.center) or state.center.lifecycle == "closed"
            state.seed.push(chan_component_copy(component))
            if state.seed.size() == 3
                ChanComponent first = state.seed.get(0)
                ChanComponent middle = state.seed.get(1)
                ChanComponent last = state.seed.get(2)
                int coreLow = math.max(first.actualLowTicks, math.max(middle.actualLowTicks, last.actualLowTicks))
                int coreHigh = math.min(first.actualHighTicks, math.min(middle.actualHighTicks, last.actualHighTicks))
                if coreLow <= coreHigh
                    state.direction := first.direction
                    state.waves := 2
                    state.count += 1
                    state.center := ChanCenter.new(state.contextId + "/L" + str.tostring(state.level) + "/Z/" + str.tostring(state.count) + "/" + str.tostring(first.realStartTime), state.level, coreLow, coreHigh, math.max(first.actualHighTicks, last.actualHighTicks), math.min(first.actualHighTicks, last.actualHighTicks), math.max(first.actualLowTicks, last.actualLowTicks), math.min(first.actualLowTicks, last.actualLowTicks), first.realStartTime, component.confirmedAt, component.realEndTime, component.confirmedAt, coreLow == coreHigh, "extending", "Z-001/Z-002/Z-003/E-010", array.from(first.id, middle.id, last.id), state.count)
                    state.center.zWaves := 2
                    if component.realEndTicks > coreHigh or component.realEndTicks < coreLow
                        state.pendingLeave := chan_component_copy(component)
                    state.event := state.center
                    state.seed.clear()
                else
                    state.seed.shift()
        else
            bool touches = component.actualLowTicks <= state.center.coreHighTicks and component.actualHighTicks >= state.center.coreLowTicks
            if not na(state.pendingLeave)
                if touches
                    chan_center_commit(state, state.pendingLeave)
                    state.pendingLeave := na
                else
                    chan_center_close(state, state.pendingLeave, component)
            if state.center.lifecycle != "closed" and not state.blocked
                if component.realEndTicks > state.center.coreHighTicks or component.realEndTicks < state.center.coreLowTicks
                    state.pendingLeave := chan_component_copy(component)
                else
                    chan_center_commit(state, component)
        if not na(state.previous) and not na(state.center) and state.center.lifecycle != "closed"
            state.relationKind := chan_center_relation(state.previous, state.center)
            state.relationAt := component.confirmedAt
        if state.blocked
            state := chan_center_clone(source)
            state.event := na
            state.closedEvent := na
            state.blocked := true
            state.heldInput := chan_component_copy(component)
        else
            state.lastInput := chan_component_copy(component)
            state.inputCount += 1
    state
// L1 movement completion on the structure-confirmation path (R-002..R-006).
// It reads the same confirmed L0 stream as the center chain plus that chain's
// formation and closure events. Window end, formation, extension, pending departure
// and touching returns never complete a movement.
type ChanMovementState
    string contextId
    int level = 1
    bool submit = true
    bool capped = false
    int maxMembers = 128
    int inputCount = 0
    bool active = false
    int direction = 0
    bool truncated = false
    int startTime = na
    int startTicks = na
    array<ChanComponent> members
    array<ChanCenter> centers
    ChanMovement event
    array<ChanMovement> history
    int count = 0
    int submitted = 0
    bool blocked = false
    string blockKind = ""
    ChanComponent heldInput

// submit is false on the top configured layer: a completed movement there is
// kept and marked capped, but nothing is sent upward.
chan_movement_new_level(string contextId, int maxMembers, int level, bool submit) =>
    if maxMembers < 4
        runtime.error("走势成员预算至少为4")
    if level < 1 or level > 3
        runtime.error("走势层级只支持1到3")
    ChanMovementState result = ChanMovementState.new()
    result.contextId := contextId
    result.level := level
    result.submit := submit
    result.maxMembers := maxMembers
    result.members := array.new<ChanComponent>()
    result.centers := array.new<ChanCenter>()
    result.history := array.new<ChanMovement>()
    result

chan_movement_copy(ChanMovement source) =>
    ChanMovement result = na
    if not na(source)
        result := source.copy()
        result.childIds := source.childIds.copy()
        result.centerIds := source.centerIds.copy()
        result.upper := chan_component_copy(source.upper)
    result

chan_movement_clone(ChanMovementState source) =>
    ChanMovementState result = source.copy()
    result.members := array.new<ChanComponent>()
    for member in source.members
        result.members.push(chan_component_copy(member))
    result.centers := array.new<ChanCenter>()
    for center in source.centers
        result.centers.push(chan_center_copy(center))
    result.event := chan_movement_copy(source.event)
    result.history := array.new<ChanMovement>()
    for item in source.history
        result.history.push(chan_movement_copy(item))
    result.heldInput := chan_component_copy(source.heldInput)
    result

// A stopped layer keeps its last committed state and the unconsumed input. The
// kind separates the member budget from a violated R guard.
chan_movement_block(ChanMovementState source, ChanComponent component, string kind) =>
    ChanMovementState result = chan_movement_clone(source)
    result.event := na
    result.blocked := true
    result.blockKind := kind
    result.heldInput := chan_component_copy(component)
    result

// Reverse closure of the newest center: fixes endpoint, members and type once.
chan_movement_complete(ChanMovementState source, ChanMovementState working, ChanComponent returning, ChanCenter closed) =>
    ChanMovementState state = working
    int d = state.direction
    bool ok = state.centers.size() > 0
    ChanComponent middle = na
    ChanComponent departure = na
    if ok
        ChanCenter firstCenter = state.centers.first()
        for member in state.members
            if member.id == firstCenter.dependencies.get(1)
                middle := member
            if member.id == closed.leaveId
                departure := member
        ok := not na(middle) and not na(departure)
    int endIndex = -1
    if ok
        for i = 0 to state.members.size() - 1
            ChanComponent member = state.members.get(i)
            if member.direction == d and member.realEndTime >= middle.realEndTime and member.realEndTime <= departure.realStartTime
                if endIndex < 0 or d * member.analysisEndTicks > d * state.members.get(endIndex).analysisEndTicks
                    endIndex := i
        ok := endIndex >= 0 and endIndex < state.members.size() - 1
    ChanComponent endMember = na
    if ok
        endMember := state.members.get(endIndex)
        if not state.truncated
            ok := d * (endMember.analysisEndTicks - state.startTicks) > 0
    int lowTicks = na
    int highTicks = na
    int lowTime = na
    int highTime = na
    array<string> childIds = array.new<string>()
    if ok
        for i = 0 to endIndex
            ChanComponent member = state.members.get(i)
            childIds.push(member.id)
            if na(lowTicks) or member.actualLowTicks < lowTicks
                lowTicks := member.actualLowTicks
                lowTime := member.actualLowTime
            if na(highTicks) or member.actualHighTicks > highTicks
                highTicks := member.actualHighTicks
                highTime := member.actualHighTime
    string morphology = "consolidation"
    array<string> centerIds = array.new<string>()
    for center in state.centers
        centerIds.push(center.id)
    if state.centers.size() > 1
        morphology := "trend"
        for i = 1 to state.centers.size() - 1
            ChanCenter older = state.centers.get(i - 1)
            ChanCenter newer = state.centers.get(i)
            bool separated = d == 1 ? newer.ddTicks > older.ggTicks : newer.ggTicks < older.ddTicks
            if not separated
                morphology := "expansion-evidence"
    ChanMovement movement = na
    if ok
        string movementId = state.contextId + "/L" + str.tostring(state.level) + "/R/" + str.tostring(source.count + 1) + "/" + str.tostring(state.startTime)
        movement := ChanMovement.new(movementId, state.level, d, state.startTime, endMember.realEndTime, state.startTicks, endMember.analysisEndTicks, morphology, true, returning.confirmedAt, closed.id + "/close/" + returning.id, "R-002/R-003/R-004/R-006", childIds, centerIds, source.count + 1)
        movement.lowTicks := lowTicks
        movement.highTicks := highTicks
        movement.lowTime := lowTime
        movement.highTime := highTime
        movement.occurredAt := endMember.realEndTime
        movement.truncated := state.truncated
        if not state.truncated and state.submit
            array<string> upperDependencies = childIds.copy()
            upperDependencies.push(closed.id + "/close/" + returning.id)
            ChanComponent upper = ChanComponent.new(movementId, movementId, state.startTime, endMember.realEndTime, state.startTicks, endMember.analysisEndTicks, lowTicks, highTicks, lowTime, highTime, state.startTime, endMember.realEndTime, d == 1 ? lowTicks : highTicks, d == 1 ? highTicks : lowTicks, d, returning.confirmedAt, "R-005", upperDependencies, source.submitted + 1)
            ok := chan_center_valid(upper)
            if ok
                movement.upper := upper
    ChanMovementState result = na
    if ok
        array<ChanComponent> carried = array.new<ChanComponent>()
        for i = endIndex + 1 to state.members.size() - 1
            carried.push(state.members.get(i))
        state.members := carried
        state.direction := -d
        state.truncated := false
        state.startTime := carried.first().realStartTime
        state.startTicks := carried.first().analysisStartTicks
        state.centers := array.new<ChanCenter>()
        state.count := source.count + 1
        if not na(movement.upper)
            state.submitted := source.submitted + 1
        // state.truncated already describes the next movement here; the completed
        // one is on the record.
        if not movement.truncated and not state.submit
            state.capped := true
        state.event := movement
        state.history.push(chan_movement_copy(movement))
        if state.history.size() > 15
            state.history.shift()
        result := state
    else
        result := chan_movement_block(source, returning, "rule")
    result

chan_movement_step(ChanMovementState source, ChanComponent component, ChanCenterState centers) =>
    ChanMovementState state = chan_movement_clone(source)
    state.event := na
    if not source.blocked and component.ordinal > source.inputCount and centers.inputCount >= component.ordinal
        if component.ordinal != source.inputCount + 1
            runtime.error("走势L0序号不连续")
        if state.members.size() >= state.maxMembers
            state := chan_movement_block(source, component, "budget")
        else
            if source.inputCount == 0
                state.startTime := component.realStartTime
                state.startTicks := component.analysisStartTicks
            state.members.push(chan_component_copy(component))
            if not na(centers.event) and state.active and centers.event.startTime >= state.startTime
                state.centers.push(chan_center_copy(centers.event))
            if not na(centers.closedEvent)
                ChanCenter closed = centers.closedEvent
                int closeDirection = component.actualLowTicks > closed.coreHighTicks ? 1 : -1
                if not state.active
                    state.active := true
                    state.direction := closeDirection
                    state.truncated := true
                    state.centers := array.from(chan_center_copy(closed))
                else
                    int lastIndex = state.centers.size() - 1
                    bool tracked = lastIndex >= 0 and state.centers.get(lastIndex).id == closed.id
                    if tracked
                        state.centers.set(lastIndex, chan_center_copy(closed))
                    if closeDirection != state.direction
                        if tracked
                            state := chan_movement_complete(source, state, component, closed)
                        else
                            state := chan_movement_block(source, component, "rule")
            if not state.blocked
                state.inputCount := source.inputCount + 1
    state
// Layers above L1 consume only the parts submitted by the layer below, in the
// order L1 -> Z2 -> R2 -> Z3 -> R3. A layer never reads or rewrites a lower one:
// an extension or expansion above only adds to its own state, and the layer
// below keeps its confirmed history. limit is the configured layer ceiling.
type ChanLevels
    int levelLimit = 3
    ChanCenterState centers2
    ChanMovementState movements2
    ChanCenterState centers3
    ChanMovementState movements3

chan_levels_new(string contextId, int centerSources, int limit) =>
    if limit < 1 or limit > 3
        runtime.error("走势层数上限只支持1到3")
    ChanLevels result = ChanLevels.new()
    result.levelLimit := limit
    result.centers2 := chan_center_new_level(contextId, centerSources, 2)
    result.movements2 := chan_movement_new_level(contextId, centerSources * 2, 2, limit >= 3)
    result.centers3 := chan_center_new_level(contextId, centerSources, 3)
    result.movements3 := chan_movement_new_level(contextId, centerSources * 2, 3, false)
    result

chan_levels_clone(ChanLevels source) =>
    ChanLevels result = source.copy()
    result.centers2 := chan_center_clone(source.centers2)
    result.movements2 := chan_movement_clone(source.movements2)
    result.centers3 := chan_center_clone(source.centers3)
    result.movements3 := chan_movement_clone(source.movements3)
    result

// upper is the part just submitted by L1, or na. Events live for one call only.
chan_levels_step(ChanLevels source, ChanComponent upper) =>
    ChanLevels state = chan_levels_clone(source)
    state.centers2.event := na
    state.centers2.closedEvent := na
    state.movements2.event := na
    state.centers3.event := na
    state.centers3.closedEvent := na
    state.movements3.event := na
    if state.levelLimit >= 2 and not na(upper)
        state.centers2 := chan_center_step(state.centers2, upper)
        state.movements2 := chan_movement_step(state.movements2, upper, state.centers2)
        ChanComponent upper2 = na
        if not na(state.movements2.event)
            upper2 := state.movements2.event.upper
        if state.levelLimit >= 3 and not na(upper2)
            state.centers3 := chan_center_step(state.centers3, upper2)
            state.movements3 := chan_movement_step(state.movements3, upper2, state.centers3)
    state

// One confirmed L0 part through every layer. The runtime and the shared
// validation both call this, so the batch order is a single definition.
type ChanStack
    ChanCenterState centers
    ChanMovementState movements
    ChanLevels levels

chan_stack_step(ChanStack source, ChanComponent part) =>
    ChanStack result = ChanStack.new()
    result.centers := chan_center_step(source.centers, part)
    result.movements := chan_movement_step(source.movements, part, result.centers)
    ChanComponent submitted = na
    if not na(result.movements.event)
        submitted := result.movements.event.upper
    result.levels := chan_levels_step(source.levels, submitted)
    result
// Signal layer (change add-chanlun-divergence-signals, rules M/D/B). It is read-only with
// respect to the pattern CORE: nothing below writes into a CORE state.
//
// M-001/M-002: MACD over closed bars only, kept as prefix sums keyed by bar open time.
// One entry per usable closed bar: (time, cumPos, cumNeg, dif, dea). The first `warmup`
// bars advance the EMAs but are not stored. A segment (ts, te] is a difference of two
// prefix entries found by binary search on time, never by bar_index offsets.
// The arrays are bounded by `capacity`; the oldest entry is recycled when it is full,
// and any segment that starts before the oldest kept entry is "area unavailable".
type ChanMacd
    int fast
    int slow
    int signal
    int warmup
    int capacity
    int seen = 0
    int dropped = 0
    int lastTime = na
    float emaFast = na
    float emaSlow = na
    float emaSignal = na
    float sumFast = 0.0
    float sumSlow = 0.0
    float sumSignal = 0.0
    int difCount = 0
    float sumPos = 0.0
    float sumNeg = 0.0
    array<int> times
    array<float> cumPos
    array<float> cumNeg
    array<float> difs
    array<float> deas

type ChanMacdBar
    float emaFast
    float emaSlow
    float emaSignal
    float sumFast
    float sumSlow
    float sumSignal
    int difCount
    float dif
    float dea
    float hist

// direction: 1 = up (red bars), -1 = down (green bars).
type ChanMacdArea
    bool available = false
    string reason = "no-data"
    float area = na
    float difExtreme = na
    float deaExtreme = na
    int bars = 0
    int fast
    int slow
    int signal

chan_macd_new(int fast, int slow, int signal, int capacity) =>
    if fast < 1 or slow <= fast or signal < 1
        runtime.error("MACD参数无效：需要 快线 < 慢线 且信号线 ≥ 1")
    if capacity < 1 or capacity > 100000
        runtime.error("MACD前缀容量须在1到100000之间")
    ChanMacd state = ChanMacd.new()
    state.fast := fast
    state.slow := slow
    state.signal := signal
    state.warmup := slow + signal
    state.capacity := capacity
    state.times := array.new<int>()
    state.cumPos := array.new<float>()
    state.cumNeg := array.new<float>()
    state.difs := array.new<float>()
    state.deas := array.new<float>()
    state

// Same definition as ta.ema/ta.macd (checked against the platform, see signal-validation.md):
// an EMA is na for its first length-1 inputs, its first value is the simple average of the first
// length inputs, and every later value is alpha * src + (1 - alpha) * previous. The signal line
// applies the same rule to the dif values, so dif is valid from input slow, and dea and hist from
// input slow + signal - 1 (1-based). Pure: it never changes `source`, so a not-yet-closed bar can be
// previewed without entering the confirmed series.
chan_macd_peek(ChanMacd source, float price) =>
    ChanMacdBar bar = ChanMacdBar.new()
    int count = source.seen + 1
    float alphaFast = 2.0 / (source.fast + 1)
    float alphaSlow = 2.0 / (source.slow + 1)
    float alphaSignal = 2.0 / (source.signal + 1)
    bar.sumFast := count <= source.fast ? source.sumFast + price : source.sumFast
    bar.sumSlow := count <= source.slow ? source.sumSlow + price : source.sumSlow
    bar.emaFast := count < source.fast ? na : (count == source.fast ? bar.sumFast / source.fast : alphaFast * price + (1.0 - alphaFast) * source.emaFast)
    bar.emaSlow := count < source.slow ? na : (count == source.slow ? bar.sumSlow / source.slow : alphaSlow * price + (1.0 - alphaSlow) * source.emaSlow)
    bar.dif := (na(bar.emaFast) or na(bar.emaSlow)) ? na : bar.emaFast - bar.emaSlow
    bar.difCount := source.difCount + (na(bar.dif) ? 0 : 1)
    bar.sumSignal := (not na(bar.dif) and bar.difCount <= source.signal) ? source.sumSignal + bar.dif : source.sumSignal
    bar.emaSignal := na(bar.dif) ? na : (bar.difCount < source.signal ? na : (bar.difCount == source.signal ? bar.sumSignal / source.signal : alphaSignal * bar.dif + (1.0 - alphaSignal) * source.emaSignal))
    bar.dea := bar.emaSignal
    bar.hist := (na(bar.dif) or na(bar.dea)) ? na : bar.dif - bar.dea
    bar

// Shared storage path for the chart and for validation fixtures that supply dif/dea
// directly. Mutates in place, so callers use it only for closed bars.
chan_macd_store(ChanMacd state, int openTime, float dif, float dea) =>
    float hist = dif - dea
    state.seen += 1
    if state.seen > state.warmup and not na(hist)
        if hist > 0.0
            state.sumPos += hist
        if hist < 0.0
            state.sumNeg -= hist
        if state.times.size() >= state.capacity
            state.times.shift()
            state.cumPos.shift()
            state.cumNeg.shift()
            state.difs.shift()
            state.deas.shift()
            state.dropped += 1
        state.times.push(openTime)
        state.cumPos.push(state.sumPos)
        state.cumNeg.push(state.sumNeg)
        state.difs.push(dif)
        state.deas.push(dea)
    state.lastTime := openTime
    true

// One closed bar. A repeated or older open time is ignored, so re-running the same
// bar (redraw, reload of the same data) cannot append twice. Returns whether it was taken.
chan_macd_push(ChanMacd state, int openTime, float price) =>
    bool accepted = na(state.lastTime) or openTime > state.lastTime
    if accepted
        ChanMacdBar bar = chan_macd_peek(state, price)
        state.emaFast := bar.emaFast
        state.emaSlow := bar.emaSlow
        state.emaSignal := bar.emaSignal
        state.sumFast := bar.sumFast
        state.sumSlow := bar.sumSlow
        state.sumSignal := bar.sumSignal
        state.difCount := bar.difCount
        chan_macd_store(state, openTime, bar.dif, bar.dea)
    accepted

// Index of the last kept entry whose open time is not later than target, or -1.
chan_macd_index(ChanMacd state, int target) =>
    int low = 0
    int high = state.times.size() - 1
    int found = -1
    while low <= high
        int mid = int(math.floor((low + high) / 2.0))
        if state.times.get(mid) <= target
            found := mid
            low := mid + 1
        else
            high := mid - 1
    found

// M-002: same-sign area over the half-open interval (startTime, endTime].
// Unavailable (never degraded to another definition) when the start precedes the
// first kept entry (warm-up, before the window, or recycled), the interval is
// reversed, or its end lies beyond the last closed bar.
chan_macd_area(ChanMacd state, int startTime, int endTime, int direction) =>
    if direction != 1 and direction != -1
        runtime.error("MACD面积方向只能是1或-1")
    ChanMacdArea result = ChanMacdArea.new()
    result.fast := state.fast
    result.slow := state.slow
    result.signal := state.signal
    if endTime < startTime
        result.reason := "bad-range"
    else if state.times.size() == 0
        result.reason := "warmup"
    else if startTime < state.times.first()
        result.reason := state.dropped > 0 ? "recycled" : "before-start"
    else if endTime > state.lastTime
        result.reason := "not-closed"
    else
        int startIndex = chan_macd_index(state, startTime)
        int endIndex = chan_macd_index(state, endTime)
        array<float> cumulative = direction == 1 ? state.cumPos : state.cumNeg
        result.available := true
        result.reason := "ok"
        result.area := cumulative.get(endIndex) - cumulative.get(startIndex)
        result.bars := endIndex - startIndex
        if endIndex > startIndex
            float difValue = state.difs.get(startIndex + 1)
            float deaValue = state.deas.get(startIndex + 1)
            // A Pine for loop counts downward when start > end, so guard the range.
            if endIndex > startIndex + 1
                for i = startIndex + 2 to endIndex
                    difValue := direction == 1 ? math.max(difValue, state.difs.get(i)) : math.min(difValue, state.difs.get(i))
                    deaValue := direction == 1 ? math.max(deaValue, state.deas.get(i)) : math.min(deaValue, state.deas.get(i))
            result.difExtreme := difValue
            result.deaExtreme := deaValue
    result

chan_macd_signature(ChanMacd state) =>
    int size = state.times.size()
    str.tostring(state.fast) + "/" + str.tostring(state.slow) + "/" + str.tostring(state.signal) + "/" + str.tostring(state.warmup) + "/" + str.tostring(state.capacity) + "/" + str.tostring(state.seen) + "/" + str.tostring(state.dropped) + "/" + str.tostring(state.lastTime) + "/" + str.tostring(size) + "/" + (size > 0 ? str.tostring(state.times.first()) + "/" + str.tostring(state.times.last()) + "/" + str.tostring(state.cumPos.last(), "#.##########") + "/" + str.tostring(state.cumNeg.last(), "#.##########") : "empty") + "/" + str.tostring(state.emaFast, "#.##########") + "/" + str.tostring(state.emaSlow, "#.##########") + "/" + str.tostring(state.emaSignal, "#.##########")
// Divergence signals (rules D-001..D-004; B-001 first class and B-004 consolidation divergence point).
// Read-only: this section calls CORE step functions on its own mirror of the layer stack and reads
// their Z/R states. It never assigns into a CORE state, so the pattern engine is untouched.
// Order inside one confirmed part: L0 -> Z1 -> R1 -> D1 -> Z2 -> R2 -> D2 -> Z3 -> R3 -> D3.
type ChanSegmentArea
    int startTime
    int endTime
    int direction
    float area = na
    int extremeTicks

type ChanComparison
    string kind
    array<string> aIds
    string cId
    ChanSegmentArea a
    ChanSegmentArea c

// side: 1 = buy, -1 = sell.
type ChanSignal
    string id
    string type
    int layer
    int side
    int priceTicks
    int occurredAt
    int confirmedAt
    array<string> dependencies
    ChanComparison comparison
    string ruleId

type ChanSignalNote
    string type
    string reason
    ChanComparison comparison
    array<string> dependencies

type ChanSignalMemo
    string centerId
    ChanComponent entry
    bool firstDone = false
    bool consolidationDone = false

// A first-class signal waiting for its second-class point: r1 is the next part, r2 the one after.
type ChanSignalWait
    string firstId
    string componentId
    int direction
    int priceTicks
    int count = 0
    string r1Id = ""

type ChanSignalLayer
    string contextId
    int layer
    int lastOrdinal = 0
    int count = 0
    int dropped = 0
    int signalLimit = 128
    array<ChanComponent> recent
    array<ChanSignalMemo> memos
    array<ChanSignalWait> waits
    ChanComponent pending
    array<ChanSignal> signals
    array<ChanSignal> events
    array<ChanSignalNote> notes

type ChanSignalRuntime
    int levelLimit = 3
    ChanStack stack
    ChanSignalLayer d1
    ChanSignalLayer d2
    ChanSignalLayer d3
    array<ChanSignal> events
    array<ChanSignalNote> notes

chan_signal_layer_new(string contextId, int layer) =>
    ChanSignalLayer state = ChanSignalLayer.new()
    state.contextId := contextId
    state.layer := layer
    state.recent := array.new<ChanComponent>()
    state.memos := array.new<ChanSignalMemo>()
    state.waits := array.new<ChanSignalWait>()
    state.signals := array.new<ChanSignal>()
    state.events := array.new<ChanSignal>()
    state.notes := array.new<ChanSignalNote>()
    state

// Signals and notes are immutable once built, so the arrays are copied shallowly.
chan_signal_layer_clone(ChanSignalLayer source) =>
    ChanSignalLayer state = source.copy()
    state.recent := source.recent.copy()
    state.memos := array.new<ChanSignalMemo>()
    for memo in source.memos
        state.memos.push(memo.copy())
    state.waits := array.new<ChanSignalWait>()
    for wait in source.waits
        state.waits.push(wait.copy())
    state.signals := source.signals.copy()
    state.events := array.new<ChanSignal>()
    state.notes := array.new<ChanSignalNote>()
    state

chan_signal_memo(ChanSignalLayer state, string centerId) =>
    ChanSignalMemo found = na
    for memo in state.memos
        if memo.centerId == centerId
            found := memo
    if na(found)
        found := ChanSignalMemo.new(centerId)
        state.memos.push(found)
        if state.memos.size() > 8
            state.memos.shift()
    found

// Index of the component with this id, or -1. A Pine for loop counts downward on an empty range.
chan_signal_find(array<ChanComponent> members, string id) =>
    int found = -1
    if members.size() > 0
        for i = 0 to members.size() - 1
            if members.get(i).id == id
                found := i
    found

chan_signal_segment(ChanMacd macd, int startTime, int endTime, int direction, int extremeTicks) =>
    ChanSegmentArea segment = ChanSegmentArea.new(startTime, endTime, direction, na, extremeTicks)
    ChanMacdArea measured = chan_macd_area(macd, startTime, endTime, direction)
    if measured.available
        segment.area := measured.area
    segment

// The centers of the current walk W: the tracked ones plus the live center when R has not tracked it yet.
chan_signal_wset(ChanCenterState centers, ChanMovementState movements) =>
    array<ChanCenter> result = array.new<ChanCenter>()
    for center in movements.centers
        result.push(center)
    ChanCenter live = centers.center
    if not na(live) and live.lifecycle != "closed"
        if result.size() > 0 and result.last().id == live.id
            result.set(result.size() - 1, live)
        else
            result.push(live)
    result

// Appends a confirmed signal: only ever added to, never changed afterwards.
chan_signal_emit(ChanSignalLayer state, ChanSignal signal) =>
    state.signals.push(signal)
    if state.signals.size() > state.signalLimit
        state.signals.shift()
        state.dropped += 1
    state.events.push(signal)
    state.count += 1
    true

// D-001/M-003 hard conditions in a fixed order: new extreme, then areas available, then C smaller than A.
chan_signal_decide(ChanSignalLayer state, ChanSignalMemo memo, string type, string ruleId, ChanComparison comparison, array<string> dependencies, ChanComponent c, int d) =>
    string reason = ""
    if d * (comparison.c.extremeTicks - comparison.a.extremeTicks) <= 0
        reason := "not-new-extreme"
    else if na(comparison.a.area) or na(comparison.c.area)
        reason := "area-unavailable"
    else if not (comparison.c.area < comparison.a.area)
        reason := "area-not-smaller"
    if reason == ""
        ChanSignal signal = ChanSignal.new(state.contextId + "/L" + str.tostring(state.layer) + "/" + type + "/" + c.id, type, state.layer, d == 1 ? -1 : 1, c.realEndTicks, c.realEndTime, c.confirmedAt, dependencies, comparison, ruleId)
        chan_signal_emit(state, signal)
        if type == "first"
            memo.firstDone := true
            state.waits.push(ChanSignalWait.new(signal.id, c.id, d, c.realEndTicks))
        else
            memo.consolidationDone := true
    else
        state.notes.push(ChanSignalNote.new(type, reason, comparison, dependencies))
    true

// D-002. C is the departure of the newest center Zk, A runs from the previous center's departure
// up to the part before Zk's first formation part.
chan_signal_trend(ChanSignalLayer state, ChanSignalMemo memo, array<ChanCenter> wset, ChanMovementState movements, ChanCenter zk, ChanComponent c, ChanMacd macd) =>
    ChanCenter zp = wset.get(wset.size() - 2)
    int d = zk.ddTicks > zp.ggTicks ? 1 : (zk.ggTicks < zp.ddTicks ? -1 : 0)
    int depIndex = zp.lifecycle == "closed" ? chan_signal_find(movements.members, zp.leaveId) : -1
    int firstIndex = chan_signal_find(movements.members, zk.dependencies.get(0))
    if d != 0 and c.direction == d and depIndex >= 0 and firstIndex > depIndex
        ChanComponent dep = movements.members.get(depIndex)
        int closeDirection = dep.realEndTicks > zp.coreHighTicks ? 1 : -1
        if closeDirection == d
            ChanComponent aFirst = movements.members.get(depIndex)
            ChanComponent aLast = movements.members.get(firstIndex - 1)
            array<string> aIds = array.new<string>()
            array<string> dependencies = array.from(zk.id, zp.id)
            int aExtreme = na
            for i = depIndex to firstIndex - 1
                ChanComponent member = movements.members.get(i)
                aIds.push(member.id)
                dependencies.push(member.id)
                if member.direction == d
                    int value = d == 1 ? member.actualHighTicks : member.actualLowTicks
                    aExtreme := na(aExtreme) ? value : (d == 1 ? math.max(aExtreme, value) : math.min(aExtreme, value))
            dependencies.push(c.id)
            ChanSegmentArea a = chan_signal_segment(macd, aFirst.realStartTime, aLast.realEndTime, d, aExtreme)
            ChanSegmentArea cs = chan_signal_segment(macd, c.realStartTime, c.realEndTime, d, d == 1 ? c.actualHighTicks : c.actualLowTicks)
            chan_signal_decide(state, memo, "first", "D-001/D-002/M-002/M-003/B-001", ChanComparison.new("trend", aIds, c.id, a, cs), dependencies, c, d)
    true

// D-003. a is the part just before Zk's first formation part and must run the same way as C.
chan_signal_consolidation(ChanSignalLayer state, ChanSignalMemo memo, ChanCenter zk, ChanComponent c, ChanMacd macd) =>
    ChanComparison none = na
    ChanComponent entry = memo.entry
    if na(entry)
        state.notes.push(ChanSignalNote.new("consolidation-divergence-point", "no-entry-segment", none, array.from(zk.id, c.id)))
    else if entry.direction != c.direction
        state.notes.push(ChanSignalNote.new("consolidation-divergence-point", "no-same-direction-entry", none, array.from(zk.id, entry.id, c.id)))
    else
        int d = c.direction
        ChanSegmentArea a = chan_signal_segment(macd, entry.realStartTime, entry.realEndTime, d, d == 1 ? entry.actualHighTicks : entry.actualLowTicks)
        ChanSegmentArea cs = chan_signal_segment(macd, c.realStartTime, c.realEndTime, d, d == 1 ? c.actualHighTicks : c.actualLowTicks)
        chan_signal_decide(state, memo, "consolidation-divergence-point", "D-001/D-003/M-002/M-003/B-004", ChanComparison.new("consolidation", array.from(entry.id), c.id, a, cs), array.from(zk.id, entry.id, c.id), c, d)
    true

// B-002. r2 is the second part after the first-class point. It counts unless it passes the
// first-class price (equal does not pass); when it does pass, no second-class point ever follows.
chan_signal_second(ChanSignalLayer state, ChanSignalWait wait, ChanComponent r2) =>
    ChanComparison none = na
    array<string> dependencies = array.from(wait.firstId, wait.r1Id, r2.id)
    if wait.direction * (r2.realEndTicks - wait.priceTicks) <= 0
        chan_signal_emit(state, ChanSignal.new(state.contextId + "/L" + str.tostring(state.layer) + "/second/" + r2.id, "second", state.layer, wait.direction == 1 ? -1 : 1, r2.realEndTicks, r2.realEndTime, r2.confirmedAt, dependencies, none, "B-002"))
    else
        state.notes.push(ChanSignalNote.new("second", "breaks-first-class-price", none, dependencies))
    true

// B-003. A closing return part is the third-class point: above the core is a buy, below a sell.
chan_signal_third(ChanSignalLayer state, ChanCenter closed, ChanComponent ret) =>
    ChanComparison none = na
    int side = ret.actualLowTicks > closed.coreHighTicks ? 1 : -1
    chan_signal_emit(state, ChanSignal.new(state.contextId + "/L" + str.tostring(state.layer) + "/third/" + ret.id, "third", state.layer, side, ret.realEndTicks, ret.realEndTime, ret.confirmedAt, array.from(closed.id, closed.leaveId, ret.id), none, "B-003/E-010"))
    true

// One confirmed part of this layer, after the layer's Z and R have consumed it.
chan_signal_layer_step(ChanSignalLayer source, ChanCenterState centers, ChanMovementState movements, ChanComponent component, ChanMacd macd) =>
    ChanSignalLayer state = chan_signal_layer_clone(source)
    if component.ordinal > source.lastOrdinal
        state.lastOrdinal := component.ordinal
        state.recent.push(component)
        if state.recent.size() > 6
            state.recent.shift()
        // The entry segment is remembered when the center forms, while it is still in the short history.
        if not na(centers.event)
            ChanCenter formed = centers.event
            ChanSignalMemo memo = chan_signal_memo(state, formed.id)
            int at = chan_signal_find(state.recent, formed.dependencies.get(0))
            if at > 0
                memo.entry := state.recent.get(at - 1)
        // A newly held departure part is a candidate C. It is judged once, when it is confirmed.
        if not centers.blocked and not movements.blocked and not na(centers.pendingLeave) and not na(centers.center)
            if centers.center.lifecycle != "closed" and centers.pendingLeave.id == component.id
                ChanSignalMemo memo = chan_signal_memo(state, centers.center.id)
                array<ChanCenter> wset = chan_signal_wset(centers, movements)
                if wset.size() >= 2
                    if not memo.firstDone
                        chan_signal_trend(state, memo, wset, movements, centers.center, component, macd)
                else if not memo.consolidationDone
                    chan_signal_consolidation(state, memo, centers.center, component, macd)
        // Same-batch order (B-005): first/consolidation point above, then second, then third.
        if state.waits.size() > 0
            array<ChanSignalWait> kept = array.new<ChanSignalWait>()
            for wait in state.waits
                if wait.componentId == component.id
                    kept.push(wait)
                else
                    wait.count += 1
                    if wait.count == 1
                        wait.r1Id := component.id
                        kept.push(wait)
                    else
                        chan_signal_second(state, wait, component)
            state.waits := kept
        if not centers.blocked
            if not na(centers.closedEvent)
                if component.id == centers.closedEvent.returnId
                    chan_signal_third(state, centers.closedEvent, component)
            else if not na(source.pending) and not na(centers.center)
                if centers.center.lifecycle != "closed" and source.pending.id != component.id
                    // The return touches the core edge exactly: it is the middle of the center, not a third-class point.
                    ChanComparison none = na
                    bool upward = source.pending.realEndTicks > centers.center.coreHighTicks
                    bool onEdge = upward ? component.actualLowTicks == centers.center.coreHighTicks : component.actualHighTicks == centers.center.coreLowTicks
                    if onEdge
                        state.notes.push(ChanSignalNote.new("third", "touch-edge", none, array.from(centers.center.id, source.pending.id, component.id)))
        state.pending := centers.pendingLeave
    state

chan_signal_runtime_new(string contextId, int levelLimit) =>
    ChanSignalRuntime result = ChanSignalRuntime.new()
    result.levelLimit := levelLimit
    result.stack := ChanStack.new()
    result.stack.centers := chan_center_new(contextId, 64)
    result.stack.movements := chan_movement_new_level(contextId, 128, 1, levelLimit >= 2)
    result.stack.levels := chan_levels_new(contextId, 64, levelLimit)
    result.d1 := chan_signal_layer_new(contextId, 1)
    result.d2 := chan_signal_layer_new(contextId, 2)
    result.d3 := chan_signal_layer_new(contextId, 3)
    result.events := array.new<ChanSignal>()
    result.notes := array.new<ChanSignalNote>()
    result

// One confirmed L0 part through the mirror stack, then through D1..D3 in the CORE batch order.
// chan_stack_step is the same function the engine uses, so the mirror cannot disagree with it.
// Only a layer that was stepped contributes events and notes; an idle layer keeps its older ones.
chan_signal_part(ChanSignalRuntime source, ChanComponent part, ChanMacd macd) =>
    ChanSignalRuntime result = source.copy()
    result.events := array.new<ChanSignal>()
    result.notes := array.new<ChanSignalNote>()
    result.stack := chan_stack_step(source.stack, part)
    result.d1 := chan_signal_layer_step(source.d1, result.stack.centers, result.stack.movements, part, macd)
    for event in result.d1.events
        result.events.push(event)
    for note in result.d1.notes
        result.notes.push(note)
    ChanComponent upper1 = na
    if not na(result.stack.movements.event)
        upper1 := result.stack.movements.event.upper
    ChanComponent upper2 = na
    if result.levelLimit >= 2 and not na(upper1)
        result.d2 := chan_signal_layer_step(source.d2, result.stack.levels.centers2, result.stack.levels.movements2, upper1, macd)
        for event in result.d2.events
            result.events.push(event)
        for note in result.d2.notes
            result.notes.push(note)
        if not na(result.stack.levels.movements2.event)
            upper2 := result.stack.levels.movements2.event.upper
    if result.levelLimit >= 3 and not na(upper2)
        result.d3 := chan_signal_layer_step(source.d3, result.stack.levels.centers3, result.stack.levels.movements3, upper2, macd)
        for event in result.d3.events
            result.events.push(event)
        for note in result.d3.notes
            result.notes.push(note)
    result
// 5.2 isolated preview. Both functions are pure: the committed runtime and the committed MACD are only read,
// so a candidate that disappears leaves no trace, and a candidate that is confirmed is submitted by the
// normal path exactly once.
type ChanSignalCandidates
    array<ChanSignal> events
    array<ChanSignalNote> notes

// The hypothetical (unconfirmed) segments of the open bar as parts, on a copy of the normalisation state.
// The hypothetical segments themselves are copied before they are marked confirmed, and the engine's
// normalisation state is never touched.
chan_signal_preview_parts(ChanNormalizationState normalized, array<ChanStructure> hypothetical, int previewTime) =>
    array<ChanComponent> parts = array.new<ChanComponent>()
    ChanNormalizationState working = normalized
    for pendingSegment in hypothetical
        ChanStructure segment = chan_structure_copy(pendingSegment)
        segment.confirmed := true
        segment.confirmedAt := previewTime
        working := chan_normalization_step(working, segment)
        parts.push(chan_component_copy(working.event))
    parts

// A copy of the MACD with the open bar pushed. The confirmed series never sees this bar.
chan_macd_preview(ChanMacd source, int openTime, float price) =>
    ChanMacd result = source.copy()
    result.times := source.times.copy()
    result.cumPos := source.cumPos.copy()
    result.cumNeg := source.cumNeg.copy()
    result.difs := source.difs.copy()
    result.deas := source.deas.copy()
    chan_macd_push(result, openTime, price)
    result

// What the hypothetical parts of the open bar would submit, in order. The committed runtime is not changed.
chan_signal_candidates(ChanSignalRuntime committed, array<ChanComponent> parts, ChanMacd macd) =>
    ChanSignalCandidates result = ChanSignalCandidates.new()
    result.events := array.new<ChanSignal>()
    result.notes := array.new<ChanSignalNote>()
    ChanSignalRuntime working = committed
    for part in parts
        working := chan_signal_part(working, part, macd)
        for event in working.events
            result.events.push(event)
        for note in working.notes
            result.notes.push(note)
    result

chan_dv_assert(bool value, string context) =>
    if not value
        runtime.error("FAIL: " + context)
    true
chan_dv_k(int time, int base, int step) =>
    int(math.round((time - base) / float(step)))
chan_dv_norm(string id) =>
    string result = id
    array<string> parts = str.split(id, "/")
    if parts.size() >= 2
        for i = 0 to parts.size() - 2
            if parts.get(i) == "Z" and result == id
                result := "Z#" + parts.get(i + 1)
    result
chan_dv_deps(array<string> dependencies) =>
    array<string> parts = array.new<string>()
    for dependency in dependencies
        parts.push(chan_dv_norm(dependency))
    array.join(parts, ",")
chan_dv_seg(ChanSegmentArea segment, int base, int step) =>
    str.tostring(chan_dv_k(segment.startTime, base, step)) + ":" + str.tostring(chan_dv_k(segment.endTime, base, step)) + ":" + str.tostring(segment.direction) + ":" + (na(segment.area) ? "na" : str.tostring(math.round(segment.area * 1000000))) + ":" + str.tostring(segment.extremeTicks)
chan_dv_cmp(ChanComparison comparison, int base, int step) =>
    string result = "-"
    if not na(comparison)
        result := comparison.kind + ";" + array.join(comparison.aIds, ",") + ";" + comparison.cId + ";" + chan_dv_seg(comparison.a, base, step) + ";" + chan_dv_seg(comparison.c, base, step)
    result
chan_dv_signal(ChanSignal signal, int base, int step) =>
    "S|" + signal.type + "|" + (signal.side == 1 ? "buy" : "sell") + "|" + str.tostring(signal.priceTicks) + "|" + str.tostring(chan_dv_k(signal.occurredAt, base, step)) + "|" + str.tostring(chan_dv_k(signal.confirmedAt, base, step)) + "|" + chan_dv_deps(signal.dependencies) + "|" + chan_dv_cmp(signal.comparison, base, step)
chan_dv_note(ChanSignalNote note, int base, int step) =>
    "N|" + note.type + "|" + note.reason + "|" + chan_dv_deps(note.dependencies) + "|" + chan_dv_cmp(note.comparison, base, step)
chan_dv_lines(array<ChanSignal> events, array<ChanSignalNote> notes, int base, int step) =>
    array<string> lines = array.new<string>()
    for event in events
        lines.push(chan_dv_signal(event, base, step))
    for note in notes
        lines.push(chan_dv_note(note, base, step))
    "." + array.join(lines, "^")
chan_dv_segment(string id, int ordinal, int direction, int startTime, int endTime, int startTicks, int endTicks, int low, int high) =>
    ChanStructure segment = ChanStructure.new()
    segment.id := id
    segment.objectType := "segment"
    segment.level := 0
    segment.direction := direction
    segment.startTime := startTime
    segment.endTime := endTime
    segment.startTicks := startTicks
    segment.endTicks := endTicks
    segment.confirmed := false
    segment.ruleId := "fixture"
    segment.dependencies := array.from(id)
    segment.ordinal := ordinal
    segment.memberLowTicks := low
    segment.memberHighTicks := high
    segment.memberLowTime := direction == 1 ? startTime : endTime
    segment.memberHighTime := direction == 1 ? endTime : startTime
    segment
// Two hypothetical segments become two confirmed-looking parts at the preview time; nothing else moves.
chan_dv_preview_parts() =>
    ChanNormalizationState normalized = chan_normalization_new("PV")
    array<ChanStructure> hypothetical = array.from(chan_dv_segment("h1", 1, 1, 1000, 4000, 0, 10, 0, 10), chan_dv_segment("h2", 2, -1, 4000, 7000, 10, 6, 6, 10))
    array<ChanComponent> parts = chan_signal_preview_parts(normalized, hypothetical, 9000)
    chan_dv_assert(parts.size() == 2, "PREVIEW/parts")
    ChanComponent first = parts.get(0)
    ChanComponent second = parts.get(1)
    chan_dv_assert(first.ordinal == 1 and second.ordinal == 2 and first.direction == 1 and second.direction == -1, "PREVIEW/order")
    chan_dv_assert(first.realEndTicks == 10 and first.actualHighTicks == 10 and second.realEndTicks == 6 and second.actualLowTicks == 6, "PREVIEW/ranges")
    chan_dv_assert(first.confirmedAt == 9000 and second.confirmedAt == 9000, "PREVIEW/confirmedAt")
    chan_dv_assert(normalized.count == 0 and na(normalized.lastInput), "PREVIEW/normalization-untouched")
    ChanStructure kept = hypothetical.get(0)
    chan_dv_assert(not kept.confirmed and na(kept.confirmedAt), "PREVIEW/hypothetical-untouched")
    true
// Feeds the fixture components one at a time through the CORE Z/R functions and the DIVERGENCE section,
// storing the MACD bars that are closed by each component's confirmation time.
chan_dv_run(string id, int fast, int slow, int signal, int warmup, int base, int step, string barsText, string itemsText, string expectText) =>
    array<string> rows = str.split(barsText, ";")
    array<string> items = str.split(itemsText, ";")
    array<string> expected = str.split(expectText, "~")
    chan_dv_assert(items.size() == expected.size(), id + "/prefix count")
    ChanMacd macd = chan_macd_new(fast, slow, signal, rows.size() + 1)
    macd.warmup := warmup
    ChanSignalRuntime engine = chan_signal_runtime_new(id, 1)
    int stored = 0
    int total = 0
    string online = ""
    array<ChanComponent> parts = array.new<ChanComponent>()
    for p = 0 to items.size() - 1
        array<string> f = str.split(items.get(p), ",")
        int startTime = base + int(str.tonumber(f.get(1))) * step
        int endTime = base + int(str.tonumber(f.get(2))) * step
        int confirmedAt = base + int(str.tonumber(f.get(3))) * step
        int startTicks = int(str.tonumber(f.get(4)))
        int endTicks = int(str.tonumber(f.get(5)))
        int low = int(str.tonumber(f.get(6)))
        int high = int(str.tonumber(f.get(7)))
        int dir = int(str.tonumber(f.get(8)))
        bool more = true
        while more and stored < rows.size()
            array<string> g = str.split(rows.get(stored), ",")
            int barTime = base + int(str.tonumber(g.get(0))) * step
            if barTime + step <= confirmedAt
                chan_macd_store(macd, barTime, str.tonumber(g.get(1)), str.tonumber(g.get(2)))
                stored += 1
            else
                more := false
        ChanComponent part = ChanComponent.new(f.get(0), f.get(0), startTime, endTime, startTicks, endTicks, low, high, dir == 1 ? startTime : endTime, dir == 1 ? endTime : startTime, startTime, endTime, dir == 1 ? low : high, dir == 1 ? high : low, dir, confirmedAt, "fixture", array.from(f.get(0)), p + 1)
        // Preview first: the open bar shows what the confirmation will show, and the engine is left untouched.
        int committedCount = engine.d1.count
        int committedSize = engine.d1.signals.size()
        ChanSignalCandidates candidate = chan_signal_candidates(engine, array.from(part), macd)
        string previewText = chan_dv_lines(candidate.events, candidate.notes, base, step)
        chan_dv_assert(previewText == expected.get(p), id + "/prefix-" + str.tostring(p + 1) + "/preview actual=" + previewText + " expected=" + expected.get(p))
        chan_dv_assert(engine.stack.centers.inputCount == p and engine.d1.lastOrdinal == p and engine.d1.count == committedCount and engine.d1.signals.size() == committedSize, id + "/prefix-" + str.tostring(p + 1) + "/preview-isolated")
        engine := chan_signal_part(engine, part, macd)
        string actual = chan_dv_lines(engine.events, engine.notes, base, step)
        total += engine.events.size() + engine.notes.size()
        chan_dv_assert(actual == expected.get(p), id + "/prefix-" + str.tostring(p + 1) + " actual=" + actual + " expected=" + expected.get(p))
        online += (p == 0 ? "" : "~") + actual
        parts.push(part)
        // Closing the same part again submits nothing a second time.
        ChanSignalRuntime again = chan_signal_part(engine, part, macd)
        chan_dv_assert(again.events.size() == 0 and again.notes.size() == 0 and again.d1.count == engine.d1.count and again.d1.signals.size() == engine.d1.signals.size(), id + "/prefix-" + str.tostring(p + 1) + "/repeat")
    // Reload: one uninterrupted pass over the same parts gives the same signals and notes, prefix by prefix.
    ChanSignalRuntime reloaded = chan_signal_runtime_new(id, 1)
    string replay = ""
    for q = 0 to parts.size() - 1
        reloaded := chan_signal_part(reloaded, parts.get(q), macd)
        replay += (q == 0 ? "" : "~") + chan_dv_lines(reloaded.events, reloaded.notes, base, step)
    chan_dv_assert(replay == online and reloaded.d1.count == engine.d1.count and reloaded.d1.signals.size() == engine.d1.signals.size(), id + "/reload")
    total


var table panel = table.new(position.top_left, 1, 2)
var string verdict = "RUNNING"
if barstate.isfirst
    chan_dv_preview_parts()
    chan_dv_run("SIG-CONS-AREA-LARGER", 12, 26, 9, 0, 1701000000000, 60000, "0,0,0;1,8,4;2,10,5;3,12,6;4,-4,-2;5,-4,-2;6,-4,-2;7,2,1;8,4,2;9,4,2;10,-2,-1;11,-4,-2;12,-2,-1;13,16,8;14,18,9;15,-2,-1", "a,0,3,5,10,22,10,22,1;X1,3,6,8,22,4,4,22,-1;X2,6,9,11,4,8,4,8,1;X3,9,12,14,8,5,5,8,-1;X4,12,15,17,5,24,5,24,1", ".~.~.~.~.N|consolidation-divergence-point|area-not-smaller|Z#1,a,X4|consolidation;a;X4;0:3:1:15000000:22;12:15:1:17000000:24")
