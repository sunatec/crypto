chan_case_17() =>
    ChanState online = chan_new("P-UP-EXTEND")
    array<ChanStructure> observed = array.new<ChanStructure>()
    online := chan_stroke_step(online, ChanFractal.new("b1", -1, 1700000060000, 1, 1700000240000, "k0", "k1", "k2", "F-001/F-002", 0, 1, 2, 2, 1))
    if not na(online.strokeEvent)
        observed.push(online.strokeEvent)
    chan_assert(online.strokeCount == 0, "P-UP-EXTEND/prefix-1/confirmedStrokes")
    chan_assert((na(online.strokeCandidate) ? 0 : online.strokeCandidate.direction) == 0, "P-UP-EXTEND/prefix-1/strokeDirection")
    chan_assert(na((na(online.strokeCandidate) ? na : online.strokeCandidate.startTime)), "P-UP-EXTEND/prefix-1/strokeCandidateStartTime")
    chan_assert(na((na(online.strokeCandidate) ? na : online.strokeCandidate.endTime)), "P-UP-EXTEND/prefix-1/strokeCandidateEndTime")
    chan_assert(na((na(online.strokeCandidate) ? na : online.strokeCandidate.startTicks)), "P-UP-EXTEND/prefix-1/strokeCandidateStartTicks")
    chan_assert(na((na(online.strokeCandidate) ? na : online.strokeCandidate.endTicks)), "P-UP-EXTEND/prefix-1/strokeCandidateEndTicks")
    chan_assert(observed.size() == 0, "P-UP-EXTEND/prefix-1/confirmed-prefix-count")
    chan_assert(na(online.strokeCandidate), "P-UP-EXTEND/prefix-1/no-candidate")
    chan_assert(na(online.strokeEvent), "P-UP-EXTEND/prefix-1/no-event")
    ChanState replay1 = chan_new("P-UP-EXTEND")
    replay1 := chan_stroke_step(replay1, ChanFractal.new("b1", -1, 1700000060000, 1, 1700000240000, "k0", "k1", "k2", "F-001/F-002", 0, 1, 2, 2, 1))
    chan_assert(chan_signature(online) == chan_signature(replay1), "P-UP-EXTEND/prefix-1/prefix-reload")
    ChanState duplicate1 = chan_clone(online)
    duplicate1 := chan_stroke_step(duplicate1, ChanFractal.new("b1", -1, 1700000060000, 1, 1700000240000, "k0", "k1", "k2", "F-001/F-002", 0, 1, 2, 2, 1))
    chan_assert(na(duplicate1.strokeEvent) and duplicate1.strokeCount == online.strokeCount, "P-UP-EXTEND/prefix-1/duplicate-event")
    duplicate1.strokeEvent := online.strokeEvent
    chan_assert(chan_signature(online) == chan_signature(duplicate1), "P-UP-EXTEND/prefix-1/duplicate-state")
    string before1 = chan_signature(online)
    ChanState preview1 = chan_clone(online)
    if not na(preview1.strokeAnchor)
        preview1.strokeAnchor.priceTicks += 1
    if not na(preview1.strokeCandidate)
