    chan_assert(not na(actual4_0), "P-UP-EXTEND/prefix-4/stroke-1/exists")
    chan_assert(actual4_0.id == online.contextId + "/P/1/1700000060000", "P-UP-EXTEND/prefix-4/stroke-1/stable-id")
    chan_assert(actual4_0.ordinal == 1 and actual4_0.objectType == "stroke" and actual4_0.level == 0, "P-UP-EXTEND/prefix-4/stroke-1/identity")
    chan_assert(actual4_0.direction == 1, "P-UP-EXTEND/prefix-4/stroke-1/direction")
    chan_assert(actual4_0.startTime == 1700000060000, "P-UP-EXTEND/prefix-4/stroke-1/startTime")
    chan_assert(actual4_0.endTime == 1700000540000, "P-UP-EXTEND/prefix-4/stroke-1/endTime")
    chan_assert(actual4_0.startTicks == 1, "P-UP-EXTEND/prefix-4/stroke-1/startTicks")
    chan_assert(actual4_0.endTicks == 10, "P-UP-EXTEND/prefix-4/stroke-1/endTicks")
    chan_assert(actual4_0.confirmed == true, "P-UP-EXTEND/prefix-4/stroke-1/state")
    chan_assert(actual4_0.confirmedAt == 1700000960000, "P-UP-EXTEND/prefix-4/stroke-1/confirmed-at")
    chan_assert(actual4_0.dependencies.size() == 3, "P-UP-EXTEND/prefix-4/stroke-1/dependency-count")
    chan_assert(actual4_0.dependencies.get(0) == "b1", "P-UP-EXTEND/prefix-4/stroke-1/dependency-0")
    chan_assert(actual4_0.dependencies.get(1) == "t9", "P-UP-EXTEND/prefix-4/stroke-1/dependency-1")
    chan_assert(actual4_0.dependencies.get(2) == "b13", "P-UP-EXTEND/prefix-4/stroke-1/dependency-2")
    ChanStructure actual4_1 = online.strokeCandidate
    chan_assert(not na(actual4_1), "P-UP-EXTEND/prefix-4/stroke-2/exists")
    chan_assert(actual4_1.id == online.contextId + "/P/2/1700000540000", "P-UP-EXTEND/prefix-4/stroke-2/stable-id")
    chan_assert(actual4_1.ordinal == 2 and actual4_1.objectType == "stroke" and actual4_1.level == 0, "P-UP-EXTEND/prefix-4/stroke-2/identity")
    chan_assert(actual4_1.direction == -1, "P-UP-EXTEND/prefix-4/stroke-2/direction")
    chan_assert(actual4_1.startTime == 1700000540000, "P-UP-EXTEND/prefix-4/stroke-2/startTime")
    chan_assert(actual4_1.endTime == 1700000780000, "P-UP-EXTEND/prefix-4/stroke-2/endTime")
    chan_assert(actual4_1.startTicks == 10, "P-UP-EXTEND/prefix-4/stroke-2/startTicks")
    chan_assert(actual4_1.endTicks == 3, "P-UP-EXTEND/prefix-4/stroke-2/endTicks")
    chan_assert(actual4_1.confirmed == false, "P-UP-EXTEND/prefix-4/stroke-2/state")
    chan_assert(na(actual4_1.confirmedAt), "P-UP-EXTEND/prefix-4/stroke-2/confirmed-at")
    chan_assert(actual4_1.dependencies.size() == 2, "P-UP-EXTEND/prefix-4/stroke-2/dependency-count")
    chan_assert(actual4_1.dependencies.get(0) == "t9", "P-UP-EXTEND/prefix-4/stroke-2/dependency-0")
    chan_assert(actual4_1.dependencies.get(1) == "b13", "P-UP-EXTEND/prefix-4/stroke-2/dependency-1")
    chan_assert(not na(online.strokeEvent) and online.strokeEvent.ordinal == 1 and online.strokeEvent.endTime == 1700000540000 and online.strokeEvent.confirmedAt == 1700000960000, "P-UP-EXTEND/prefix-4/event")
    ChanState replay4 = chan_new("P-UP-EXTEND")
    replay4 := chan_stroke_step(replay4, ChanFractal.new("b1", -1, 1700000060000, 1, 1700000240000, "k0", "k1", "k2", "F-001/F-002", 0, 1, 2, 2, 1))
    replay4 := chan_stroke_step(replay4, ChanFractal.new("t5", 1, 1700000300000, 8, 1700000480000, "k4", "k5", "k6", "F-001/F-002", 4, 5, 6, 8, 6))
    replay4 := chan_stroke_step(replay4, ChanFractal.new("t9", 1, 1700000540000, 10, 1700000720000, "k8", "k9", "k10", "F-001/F-002", 8, 9, 10, 10, 8))
    replay4 := chan_stroke_step(replay4, ChanFractal.new("b13", -1, 1700000780000, 3, 1700000960000, "k12", "k13", "k14", "F-001/F-002", 12, 13, 14, 4, 3))
    chan_assert(chan_signature(online) == chan_signature(replay4), "P-UP-EXTEND/prefix-4/prefix-reload")
    ChanState duplicate4 = chan_clone(online)
    duplicate4 := chan_stroke_step(duplicate4, ChanFractal.new("b13", -1, 1700000780000, 3, 1700000960000, "k12", "k13", "k14", "F-001/F-002", 12, 13, 14, 4, 3))
    chan_assert(na(duplicate4.strokeEvent) and duplicate4.strokeCount == online.strokeCount, "P-UP-EXTEND/prefix-4/duplicate-event")
    duplicate4.strokeEvent := online.strokeEvent
    chan_assert(chan_signature(online) == chan_signature(duplicate4), "P-UP-EXTEND/prefix-4/duplicate-state")
    string before4 = chan_signature(online)
    ChanState preview4 = chan_clone(online)
    if not na(preview4.strokeAnchor)
        preview4.strokeAnchor.priceTicks += 1
    if not na(preview4.strokeCandidate)
        preview4.strokeCandidate.dependencies.push("copy-isolation-probe")
    if not na(preview4.lastStroke)
        preview4.lastStroke.dependencies.push("copy-isolation-probe")
    chan_assert(chan_signature(online) == before4, "P-UP-EXTEND/prefix-4/deep-copy-isolation")
    true
var table result = table.new(position.top_right, 1, 1)
if barstate.isfirst
    chan_case_0()
    chan_case_1()
    chan_case_2()
    table.cell(result, 0, 0, "PASS: P3B, 3 cases", text_color = color.green)
plot(na)
