    replay9 := chan_segment_step(replay9, ChanStructure.new("p6", "stroke", 0, -1, 1701000300000, 1701000360000, 16, 10, true, 1701000420000, "P-001/P-002", array.from("f5", "f6", "proof6"), 6))
    replay9 := chan_segment_step(replay9, ChanStructure.new("p7", "stroke", 0, 1, 1701000360000, 1701000420000, 10, 15, true, 1701000480000, "P-001/P-002", array.from("f6", "f7", "proof7"), 7))
    replay9 := chan_segment_step(replay9, ChanStructure.new("p8", "stroke", 0, -1, 1701000420000, 1701000480000, 15, 12, true, 1701000540000, "P-001/P-002", array.from("f7", "f8", "proof8"), 8))
    replay9 := chan_segment_step(replay9, ChanStructure.new("p9", "stroke", 0, 1, 1701000480000, 1701000540000, 12, 20, true, 1701000600000, "P-001/P-002", array.from("f8", "f9", "proof9"), 9))
    chan_assert(chan_segment_signature(online) == chan_segment_signature(replay9), "S81-LOWER/prefix-9/prefix-reload")
    string before9 = chan_segment_signature(online)
    ChanSegmentState copy9 = chan_segment_clone(online)
    copy9 := chan_segment_step(copy9, ChanStructure.new("p9", "stroke", 0, 1, 1701000480000, 1701000540000, 12, 20, true, 1701000600000, "P-001/P-002", array.from("f8", "f9", "proof9"), 9))
    chan_assert(copy9.events.size() == 0 and copy9.segmentCount == online.segmentCount, "S81-LOWER/prefix-9/duplicate-event")
    copy9.events := online.events
    chan_assert(chan_segment_signature(copy9) == before9, "S81-LOWER/prefix-9/duplicate-state")
    copy9 := chan_segment_clone(online)
    if copy9.strokes.size() > 0
        copy9.strokes.last().dependencies.push("copy-probe")
    if copy9.events.size() > 0
        copy9.events.first().dependencies.push("copy-probe")
    if copy9.hypotheses.size() > 0
        copy9.hypotheses.first().priceTicks += 1
    if not na(copy9.candidate)
        copy9.candidate.dependencies.push("copy-probe")
    if not na(copy9.lastSegment)
        copy9.lastSegment.dependencies.push("copy-probe")
    if not na(copy9.firstContext)
        if copy9.firstContext.elements.size() > 0
            copy9.firstContext.elements.last().sourceIds.push("copy-probe")
    if not na(copy9.secondContext)
        if copy9.secondContext.elements.size() > 0
            copy9.secondContext.elements.last().sourceIds.push("copy-probe")
    chan_assert(chan_segment_signature(online) == before9, "S81-LOWER/prefix-9/deep-copy-isolation")
    chan_assert(not online.blocked, "S81-LOWER/prefix-9/within-budgets")
    true
chan_segment_limits() =>
    ChanSegmentState work = chan_segment_new("work-limit", 64, 1)
    work := chan_segment_step(work, ChanStructure.new("p1", "stroke", 0, 1, 1701000000000, 1701000060000, 0, 10, true, 1701000120000, "P-001/P-002", array.from("f0", "f1", "proof1"), 1))
    work := chan_segment_step(work, ChanStructure.new("p2", "stroke", 0, -1, 1701000060000, 1701000120000, 10, 5, true, 1701000180000, "P-001/P-002", array.from("f1", "f2", "proof2"), 2))
    work := chan_segment_step(work, ChanStructure.new("p3", "stroke", 0, 1, 1701000120000, 1701000180000, 5, 12, true, 1701000240000, "P-001/P-002", array.from("f2", "f3", "proof3"), 3))
    work := chan_segment_step(work, ChanStructure.new("p4", "stroke", 0, -1, 1701000180000, 1701000240000, 12, 3, true, 1701000300000, "P-001/P-002", array.from("f3", "f4", "proof4"), 4))
    work := chan_segment_step(work, ChanStructure.new("p5", "stroke", 0, 1, 1701000240000, 1701000300000, 3, 9, true, 1701000360000, "P-001/P-002", array.from("f4", "f5", "proof5"), 5))
    work := chan_segment_step(work, ChanStructure.new("p6", "stroke", 0, -1, 1701000300000, 1701000360000, 9, 2, true, 1701000420000, "P-001/P-002", array.from("f5", "f6", "proof6"), 6))
    chan_assert(work.blocked and work.limitReason == "probe-work" and work.segmentCount == 0 and work.events.size() == 0 and work.inputCount == 5 and work.strokes.size() == 5, "S-LIMIT/atomic-work-stop")
    chan_assert(not na(work.heldInput) and work.heldInput.id == "p6" and work.lastInput.id == "p5", "S-LIMIT/preserve-unconsumed-input")
    work := chan_segment_step(work, ChanStructure.new("future-7", "stroke", 0, 1, 1701000360000, 1701000420000, 3, 4, true, 1701000480000, "P-001/P-002", array.from("f6", "f7", "proof7"), 7))
    chan_assert(work.blocked and work.segmentCount == 0 and work.events.size() == 0 and work.heldInput.id == "p6", "S-LIMIT/blocked-future-does-not-restart")
    ChanSegmentState pending = chan_segment_new("pending-limit", 6, 8192)
    pending := chan_segment_step(pending, ChanStructure.new("p1", "stroke", 0, 1, 1701000000000, 1701000060000, 0, 10, true, 1701000120000, "P-001/P-002", array.from("f0", "f1", "proof1"), 1))
    pending := chan_segment_step(pending, ChanStructure.new("p2", "stroke", 0, -1, 1701000060000, 1701000120000, 10, 5, true, 1701000180000, "P-001/P-002", array.from("f1", "f2", "proof2"), 2))
    pending := chan_segment_step(pending, ChanStructure.new("p3", "stroke", 0, 1, 1701000120000, 1701000180000, 5, 12, true, 1701000240000, "P-001/P-002", array.from("f2", "f3", "proof3"), 3))
    pending := chan_segment_step(pending, ChanStructure.new("p4", "stroke", 0, -1, 1701000180000, 1701000240000, 12, 3, true, 1701000300000, "P-001/P-002", array.from("f3", "f4", "proof4"), 4))
    pending := chan_segment_step(pending, ChanStructure.new("p5", "stroke", 0, 1, 1701000240000, 1701000300000, 3, 9, true, 1701000360000, "P-001/P-002", array.from("f4", "f5", "proof5"), 5))
    pending := chan_segment_step(pending, ChanStructure.new("p6", "stroke", 0, -1, 1701000300000, 1701000360000, 9, 3, true, 1701000420000, "P-001/P-002", array.from("f5", "f6", "proof6"), 6))
    chan_assert(not pending.blocked and pending.segmentCount == 0 and pending.strokes.size() == 6, "S-LIMIT/pending-before-cap")
    pending := chan_segment_step(pending, ChanStructure.new("future-7", "stroke", 0, 1, 1701000360000, 1701000420000, 3, 4, true, 1701000480000, "P-001/P-002", array.from("f6", "f7", "proof7"), 7))
    chan_assert(pending.blocked and pending.limitReason == "pending-strokes" and pending.strokes.size() == 6 and pending.inputCount == 6 and pending.events.size() == 0, "S-LIMIT/pending-cap-preserves-prefix")
    true
var table result = table.new(position.top_right, 1, 1)
if barstate.isfirst
    chan_case_0()
    chan_case_1()
    chan_case_2()
    chan_case_3()
    chan_case_4()
    chan_case_5()
    chan_case_6()
    chan_case_7()
    chan_case_8()
    chan_segment_limits()
    table.cell(result, 0, 0, "PASS: 9 K/F/P/S fixtures; recursion not covered", text_color = color.green)
plot(na)
