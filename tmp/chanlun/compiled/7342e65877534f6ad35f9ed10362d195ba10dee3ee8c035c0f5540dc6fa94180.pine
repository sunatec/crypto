//@version=6
indicator("缠论原文 · 形态研究预览", "缠论原文·预览", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// BEGIN CHANLUN CORE
// K/F contract: chanlun-research-0.1. N/R/Z are deliberately not implemented.
// All time coordinates are UTC milliseconds; prices are integer ticks.
type ChanRaw
    int openTime
    int closeTime
    int openTicks
    int highTicks
    int lowTicks
    int closeTicks

type ChanElement
    string id
    int ordinal
    int firstTime
    int lastTime
    int highTicks
    int lowTicks
    int highTime
    int lowTime
    int firstRaw
    int lastRaw
    bool sealed

type ChanFractal
    string id
    int kind
    int endpointTime
    int priceTicks
    int confirmedAt
    string leftId
    string middleId
    string rightId
    string ruleId
    int leftOrdinal
    int middleOrdinal
    int rightOrdinal
    int middleHighTicks
    int middleLowTicks

// Shared contracts for later modules. An absent proof is represented by na,
// never by an invented completed structure. These types do not produce signals.
type ChanStructure
    string id
    string objectType
    int level
    int direction
    int startTime
    int endTime
    int startTicks
    int endTicks
    bool confirmed = false
    int confirmedAt = na
    string ruleId
    array<string> dependencies
    int ordinal = 0

type ChanComponent
    string id
    string segmentId
    int realStartTime
    int realEndTime
    int realStartTicks
    int realEndTicks
    int actualLowTicks
    int actualHighTicks
    int actualLowTime
    int actualHighTime
    int analysisStartTime
    int analysisEndTime
    int analysisStartTicks
    int analysisEndTicks
    int direction
    int confirmedAt
    string ruleId
    array<string> dependencies

type ChanCenter
    string id
    int level
    int coreLowTicks
    int coreHighTicks
    int ggTicks
    int gTicks
    int dTicks
    int ddTicks
    int startTime
    int formedAt
    int extentEndTime
    int confirmedAt = na
    bool degenerate = false
    string lifecycle
    string ruleId
    array<string> dependencies
    int ordinal = 0

type ChanMovement
    string id
    int level
    int direction
    int startTime
    int endTime
    int startTicks
    int endTicks
    string morphology
    bool completed = false
    int confirmedAt = na
    string completionProof
    string ruleId
    array<string> childIds
    array<string> centerIds
    int ordinal = 0

type ChanConfirmation
    string id
    string objectId
    string objectType
    int level
    int occurredAt
    int confirmedAt
    string ruleId
    array<string> dependencies

type ChanState
    string contextId = ""
    array<ChanElement> elements
    ChanRaw seed
    ChanRaw lastRaw
    ChanFractal candidate
    ChanFractal lastConfirmed
    ChanFractal event
    int direction = 0
    int processedCount = 0
    int inputCount = 0
    int confirmedFractals = 0
    int effectiveStart = na
    ChanFractal strokeAnchor
    ChanFractal strokeEnd
    ChanFractal lastStrokeInput
    ChanStructure strokeCandidate
    ChanStructure strokeEvent
    ChanStructure lastStroke
    int strokeCount = 0
    int ignoredStrokeFractals = 0

chan_new(string contextId) =>
    ChanState state = ChanState.new()
    state.contextId := "chanlun-research-0.1/" + contextId
    state.elements := array.new<ChanElement>()
    state

chan_structure_copy(ChanStructure source) =>
    ChanStructure result = na
    if not na(source)
        result := source.copy()
        if not na(source.dependencies)
            result.dependencies := source.dependencies.copy()
    result

// UDT.copy() is shallow: copy the collection and each referenced record explicitly.
chan_clone(ChanState source) =>
    ChanState result = source.copy()
    result.elements := array.new<ChanElement>()
    if source.elements.size() > 0
        for element in source.elements
            result.elements.push(element.copy())
    if not na(source.seed)
        result.seed := source.seed.copy()
    if not na(source.lastRaw)
        result.lastRaw := source.lastRaw.copy()
    if not na(source.candidate)
        result.candidate := source.candidate.copy()
    if not na(source.lastConfirmed)
        result.lastConfirmed := source.lastConfirmed.copy()
    if not na(source.event)
        result.event := source.event.copy()
    if not na(source.strokeAnchor)
        result.strokeAnchor := source.strokeAnchor.copy()
    if not na(source.strokeEnd)
        result.strokeEnd := source.strokeEnd.copy()
    if not na(source.lastStrokeInput)
        result.lastStrokeInput := source.lastStrokeInput.copy()
    result.strokeCandidate := chan_structure_copy(source.strokeCandidate)
    result.strokeEvent := chan_structure_copy(source.strokeEvent)
    result.lastStroke := chan_structure_copy(source.lastStroke)
    result

chan_contains(int loA, int hiA, int loB, int hiB) =>
    (loA <= loB and hiA >= hiB) or (loB <= loA and hiB >= hiA)

chan_element(ChanState state, ChanRaw raw, int ordinal, int rawOrdinal) =>
    ChanElement.new(state.contextId + "/K/" + str.tostring(raw.openTime), ordinal, raw.openTime, raw.openTime, raw.highTicks, raw.lowTicks, raw.openTime, raw.openTime, rawOrdinal, rawOrdinal, false)

chan_fractal(ChanState state, int offset, int confirmedAt) =>
    ChanElement left = state.elements.get(offset)
    ChanElement middle = state.elements.get(offset + 1)
    ChanElement right = state.elements.get(offset + 2)
    bool top = middle.highTicks > left.highTicks and middle.highTicks > right.highTicks and middle.lowTicks > left.lowTicks and middle.lowTicks > right.lowTicks
    bool bottom = middle.highTicks < left.highTicks and middle.highTicks < right.highTicks and middle.lowTicks < left.lowTicks and middle.lowTicks < right.lowTicks
    ChanFractal result = na
    if top or bottom
        int kind = top ? 1 : -1
        result := ChanFractal.new(state.contextId + "/F/" + str.tostring(kind) + "/" + left.id + "/" + middle.id + "/" + right.id, kind, top ? middle.highTime : middle.lowTime, top ? middle.highTicks : middle.lowTicks, confirmedAt, left.id, middle.id, right.id, "F-001/F-002", left.ordinal, middle.ordinal, right.ordinal, middle.highTicks, middle.lowTicks)
    result

// P-001 is only a qualification predicate, not a stroke completion algorithm.
// The processed-element ordinals and member IDs survive raw containment merges.
chan_stroke_eligible(ChanFractal first, ChanFractal last) =>
    bool eligible = false
    if not na(first) and not na(last)
        if not na(first.confirmedAt) and not na(last.confirmedAt) and first.kind != last.kind and first.endpointTime < last.endpointTime and first.rightOrdinal + 1 < last.leftOrdinal
            ChanFractal top = first.kind == 1 ? first : last
            ChanFractal bottom = first.kind == -1 ? first : last
            eligible := top.middleHighTicks > bottom.middleHighTicks and top.priceTicks > bottom.priceTicks
    eligible

chan_fractal_signature(ChanFractal fractal) =>
    string result = "none"
    if not na(fractal)
        result := fractal.id + "/" + str.tostring(fractal.kind) + "/" + str.tostring(fractal.endpointTime) + "/" + str.tostring(fractal.priceTicks) + "/" + str.tostring(fractal.confirmedAt) + "/" + fractal.leftId + "/" + fractal.middleId + "/" + fractal.rightId + "/" + str.tostring(fractal.leftOrdinal) + "/" + str.tostring(fractal.middleOrdinal) + "/" + str.tostring(fractal.rightOrdinal) + "/" + str.tostring(fractal.middleHighTicks) + "/" + str.tostring(fractal.middleLowTicks)
    result

chan_structure_signature(ChanStructure source) =>
    string result = "none"
    if not na(source)
        result := source.id + "/" + source.objectType + "/" + str.tostring(source.level) + "/" + str.tostring(source.direction) + "/" + str.tostring(source.startTime) + "/" + str.tostring(source.endTime) + "/" + str.tostring(source.startTicks) + "/" + str.tostring(source.endTicks) + "/" + str.tostring(source.confirmed) + "/" + str.tostring(source.confirmedAt) + "/" + str.tostring(source.ordinal) + "/" + source.ruleId
        if not na(source.dependencies)
            for dependency in source.dependencies
                result += "/" + dependency
    result

chan_stroke_make(ChanState state) =>
    ChanStructure result = ChanStructure.new()
    result.id := state.contextId + "/P/" + str.tostring(state.strokeCount + 1) + "/" + str.tostring(state.strokeAnchor.endpointTime)
    result.objectType := "stroke"
    result.level := 0
    result.direction := state.strokeAnchor.kind == -1 ? 1 : -1
    result.startTime := state.strokeAnchor.endpointTime
    result.endTime := state.strokeEnd.endpointTime
    result.startTicks := state.strokeAnchor.priceTicks
    result.endTicks := state.strokeEnd.priceTicks
    result.ruleId := "P-001/P-002"
    result.dependencies := array.from(state.strokeAnchor.id, state.strokeEnd.id)
    result.ordinal := state.strokeCount + 1
    result

chan_more_extreme(ChanFractal previous, ChanFractal incoming) =>
    incoming.kind == 1 ? incoming.priceTicks > previous.priceTicks : incoming.priceTicks < previous.priceTicks

// P-002: only a qualified next stroke locks the previous one. Equal extrema
// retain the first endpoint; rejected opposite fractals never create a turn.
chan_stroke_step(ChanState state, ChanFractal incoming) =>
    if na(incoming) or na(incoming.confirmedAt)
        runtime.error("成笔正式输入必须是已封口分型")
    state.strokeEvent := na
    bool duplicate = false
    if not na(state.lastStrokeInput)
        duplicate := state.lastStrokeInput.id == incoming.id
        if duplicate and chan_fractal_signature(state.lastStrokeInput) != chan_fractal_signature(incoming)
            runtime.error("已提交分型发生变化，需重载分析上下文")
        if not duplicate and (incoming.endpointTime <= state.lastStrokeInput.endpointTime or incoming.confirmedAt < state.lastStrokeInput.confirmedAt)
            runtime.error("成笔分型输入顺序无效")
    if not duplicate
        if na(state.strokeAnchor)
            state.strokeAnchor := incoming.copy()
        else if na(state.strokeEnd)
            if incoming.kind == state.strokeAnchor.kind
                if chan_more_extreme(state.strokeAnchor, incoming)
                    state.strokeAnchor := incoming.copy()
            else if chan_stroke_eligible(state.strokeAnchor, incoming)
                state.strokeEnd := incoming.copy()
                state.strokeCandidate := chan_stroke_make(state)
            else
                state.ignoredStrokeFractals += 1
        else if incoming.kind == state.strokeEnd.kind
            if chan_more_extreme(state.strokeEnd, incoming) and chan_stroke_eligible(state.strokeAnchor, incoming)
                state.strokeEnd := incoming.copy()
                state.strokeCandidate := chan_stroke_make(state)
        else if chan_stroke_eligible(state.strokeEnd, incoming)
            ChanStructure locked = chan_structure_copy(state.strokeCandidate)
            locked.confirmed := true
            locked.confirmedAt := incoming.confirmedAt
            locked.dependencies.push(incoming.id)
            state.strokeCount += 1
            state.lastStroke := locked
            state.strokeEvent := locked
            state.strokeAnchor := state.strokeEnd.copy()
            state.strokeEnd := incoming.copy()
            state.strokeCandidate := chan_stroke_make(state)
        else
            state.ignoredStrokeFractals += 1
        state.lastStrokeInput := incoming.copy()
    state

// Project an unsealed fractal only on a deep copy. lastStroke survives a later
// rejected preview input, unlike strokeEvent, which is cleared on every step.
chan_stroke_preview(ChanState source) =>
    ChanState result = chan_clone(source)
    if not na(source.candidate) and not na(source.lastRaw)
        ChanFractal tentative = source.candidate.copy()
        tentative.confirmedAt := source.lastRaw.closeTime
        chan_stroke_step(result, tentative)
    result

chan_stroke_pending(ChanState preview, int committedCount) =>
    ChanStructure result = na
    if preview.strokeCount > committedCount and not na(preview.lastStroke)
        result := chan_structure_copy(preview.lastStroke)
        result.confirmed := false
        result.confirmedAt := na
    result

// Consume one closed input, or one input in an isolated preview copy.
// At most four processed elements are needed for K/F; counts and source spans persist.
chan_step(ChanState state, ChanRaw raw) =>
    if na(raw.openTime) or na(raw.closeTime) or na(raw.openTicks) or na(raw.highTicks) or na(raw.lowTicks) or na(raw.closeTicks) or raw.openTime < 0 or raw.closeTime <= raw.openTime or raw.lowTicks > raw.highTicks or raw.openTicks < raw.lowTicks or raw.openTicks > raw.highTicks or raw.closeTicks < raw.lowTicks or raw.closeTicks > raw.highTicks
        runtime.error("K/F: invalid OHLC input")
    state.event := na
    state.strokeEvent := na
    bool duplicate = false
    if not na(state.lastRaw)
        if raw.openTime < state.lastRaw.openTime or (raw.openTime > state.lastRaw.openTime and raw.openTime < state.lastRaw.closeTime)
            runtime.error("K/F: inputs must be chronological")
        if raw.openTime == state.lastRaw.openTime
            duplicate := raw.closeTime == state.lastRaw.closeTime and raw.openTicks == state.lastRaw.openTicks and raw.highTicks == state.lastRaw.highTicks and raw.lowTicks == state.lastRaw.lowTicks and raw.closeTicks == state.lastRaw.closeTicks
            if not duplicate
                runtime.error("K/F: committed input changed; reload the context")
    if not duplicate
        state.inputCount += 1
        bool appended = false
        if state.direction == 0
            // E-001: compare adjacent original inputs; never invent an initial direction.
            if not na(state.seed)
                if not chan_contains(state.seed.lowTicks, state.seed.highTicks, raw.lowTicks, raw.highTicks)
                    state.contextId += "/seed/" + str.tostring(state.seed.openTime)
                    ChanElement first = chan_element(state, state.seed, 0, state.inputCount - 2)
                    first.sealed := true
                    state.elements.push(first)
                    state.elements.push(chan_element(state, raw, 1, state.inputCount - 1))
                    state.processedCount := 2
                    state.effectiveStart := state.seed.openTime
                    state.direction := raw.highTicks > state.seed.highTicks ? 1 : -1
                    appended := true
            state.seed := raw.copy()
        else
            ChanElement tail = state.elements.last()
            if chan_contains(tail.lowTicks, tail.highTicks, raw.lowTicks, raw.highTicks)
                int mergedHigh = state.direction == 1 ? math.max(tail.highTicks, raw.highTicks) : math.min(tail.highTicks, raw.highTicks)
                int mergedLow = state.direction == 1 ? math.max(tail.lowTicks, raw.lowTicks) : math.min(tail.lowTicks, raw.lowTicks)
                // E-002: equal extrema keep the earlier source independently.
                if mergedHigh != tail.highTicks
                    tail.highTime := raw.openTime
                if mergedLow != tail.lowTicks
                    tail.lowTime := raw.openTime
                tail.highTicks := mergedHigh
                tail.lowTicks := mergedLow
                tail.lastTime := raw.openTime
                tail.lastRaw := state.inputCount - 1
            else
                tail.sealed := true
                state.direction := raw.highTicks > tail.highTicks ? 1 : -1
                state.elements.push(chan_element(state, raw, state.processedCount, state.inputCount - 1))
                state.processedCount += 1
                appended := true
                if state.elements.size() > 4
                    state.elements.shift()
        int count = state.elements.size()
        if appended and count >= 4
            ChanFractal confirmed = chan_fractal(state, count - 4, raw.closeTime)
            if not na(confirmed)
                state.lastConfirmed := confirmed
                state.event := confirmed
                state.confirmedFractals += 1
                chan_stroke_step(state, confirmed)
        state.candidate := count >= 3 ? chan_fractal(state, count - 3, na) : na
        state.lastRaw := raw.copy()
    state

// Deterministic K/F snapshot for replay and clone-isolation assertions.
chan_signature(ChanState state) =>
    string result = state.contextId + "/" + str.tostring(state.inputCount) + "/" + str.tostring(state.processedCount) + "/" + str.tostring(state.direction) + "/" + str.tostring(state.effectiveStart) + "/" + str.tostring(state.confirmedFractals)
    if not na(state.seed)
        result += "/seed/" + str.tostring(state.seed.openTime) + "/" + str.tostring(state.seed.highTicks) + "/" + str.tostring(state.seed.lowTicks)
    if not na(state.lastRaw)
        result += "/raw/" + str.tostring(state.lastRaw.openTime) + "/" + str.tostring(state.lastRaw.closeTime) + "/" + str.tostring(state.lastRaw.openTicks) + "/" + str.tostring(state.lastRaw.highTicks) + "/" + str.tostring(state.lastRaw.lowTicks) + "/" + str.tostring(state.lastRaw.closeTicks)
    if state.elements.size() > 0
        for element in state.elements
            result += "/" + element.id + "/" + str.tostring(element.ordinal) + "/" + str.tostring(element.firstTime) + "/" + str.tostring(element.lastTime) + "/" + str.tostring(element.highTicks) + "/" + str.tostring(element.lowTicks) + "/" + str.tostring(element.highTime) + "/" + str.tostring(element.lowTime) + "/" + str.tostring(element.firstRaw) + "/" + str.tostring(element.lastRaw) + "/" + str.tostring(element.sealed)
    if not na(state.candidate)
        result += "/candidate/" + state.candidate.id + "/" + str.tostring(state.candidate.endpointTime) + "/" + str.tostring(state.candidate.priceTicks)
    if not na(state.lastConfirmed)
        result += "/confirmed/" + state.lastConfirmed.id + "/" + str.tostring(state.lastConfirmed.endpointTime) + "/" + str.tostring(state.lastConfirmed.priceTicks) + "/" + str.tostring(state.lastConfirmed.confirmedAt)
    if not na(state.event)
        result += "/event/" + state.event.id + "/" + str.tostring(state.event.confirmedAt)
    result += "/P/" + str.tostring(state.strokeCount) + "/" + str.tostring(state.ignoredStrokeFractals) + "/" + chan_fractal_signature(state.strokeAnchor) + "/" + chan_fractal_signature(state.strokeEnd) + "/" + chan_fractal_signature(state.lastStrokeInput)
    result += "/candidate/" + chan_structure_signature(state.strokeCandidate) + "/last/" + chan_structure_signature(state.lastStroke) + "/event/" + chan_structure_signature(state.strokeEvent)
    result
// S-001/S-002/S-003: a standard feature sequence is a context-specific view of
// locked strokes. A sequence or feature turn alone never confirms a segment.
chan_segment_seed(ChanStructure first, ChanStructure second, ChanStructure third) =>
    bool eligible = false
    if not na(first) and not na(second) and not na(third)
        bool locked = first.objectType == "stroke" and second.objectType == "stroke" and third.objectType == "stroke" and first.confirmed and second.confirmed and third.confirmed and not na(first.confirmedAt) and not na(second.confirmedAt) and not na(third.confirmedAt)
        bool connected = first.endTime == second.startTime and second.endTime == third.startTime and first.endTicks == second.startTicks and second.endTicks == third.startTicks and first.ordinal + 1 == second.ordinal and second.ordinal + 1 == third.ordinal
        bool alternating = (first.direction == 1 or first.direction == -1) and second.direction == -first.direction and third.direction == first.direction
        bool causal = first.startTime < first.endTime and second.startTime < second.endTime and third.startTime < third.endTime and first.confirmedAt >= first.endTime and second.confirmedAt >= second.endTime and third.confirmedAt >= third.endTime and first.confirmedAt <= second.confirmedAt and second.confirmedAt <= third.confirmedAt
        bool prices = first.direction * (first.endTicks - first.startTicks) > 0 and second.direction * (second.endTicks - second.startTicks) > 0 and third.direction * (third.endTicks - third.startTicks) > 0
        int commonLow = math.max(math.min(first.startTicks, first.endTicks), math.max(math.min(second.startTicks, second.endTicks), math.min(third.startTicks, third.endTicks)))
        int commonHigh = math.min(math.max(first.startTicks, first.endTicks), math.min(math.max(second.startTicks, second.endTicks), math.max(third.startTicks, third.endTicks)))
        eligible := locked and connected and alternating and causal and prices and commonLow <= commonHigh and first.direction * (third.endTicks - first.startTicks) > 0
    eligible

type ChanFeature
    string id
    int lowTicks
    int highTicks
    int lowTime
    int highTime
    int firstTime
    int lastTime
    int firstOrdinal
    int lastOrdinal
    int firstSide
    int lastSide
    int availableAt
    bool sealed = false
    array<string> sourceIds

type ChanFeatureSequence
    string contextId
    int segmentDirection
    int mergeDirection
    int postDirection
    int boundaryTime
    bool secondSequence
    array<ChanFeature> elements
    ChanStructure lastInput
    ChanStructure heldInput
    int inputCount = 0
    int selectedCount = 0
    int boundaryCuts = 0
    int maxElements = 128
    int maxSources = 512
    bool waitingDirection = false
    bool blocked = false

type ChanFeatureTurn
    int kind
    int endpointTime
    int priceTicks
    int availableAt
    string leftId
    string middleId
    string rightId
    bool gap
    bool rightSealed

chan_feature_new(string contextId, int segmentDirection, int initialDirection, int postDirection, int boundaryTime, bool secondSequence, int maxElements, int maxSources) =>
    if (segmentDirection != 1 and segmentDirection != -1) or initialDirection < -1 or initialDirection > 1 or postDirection < -1 or postDirection > 1 or maxElements < 1 or maxSources < 1
        runtime.error("特征序列上下文无效")
    ChanFeatureSequence result = ChanFeatureSequence.new()
    result.contextId := contextId
    result.segmentDirection := segmentDirection
    result.mergeDirection := initialDirection
    result.postDirection := postDirection
    result.boundaryTime := boundaryTime
    result.secondSequence := secondSequence
    result.maxElements := maxElements
    result.maxSources := maxSources
    result.elements := array.new<ChanFeature>()
    result

chan_feature_clone(ChanFeatureSequence source) =>
    ChanFeatureSequence result = source.copy()
    result.elements := array.new<ChanFeature>()
    for element in source.elements
        ChanFeature copied = element.copy()
        copied.sourceIds := element.sourceIds.copy()
        result.elements.push(copied)
    result.lastInput := chan_structure_copy(source.lastInput)
    result.heldInput := chan_structure_copy(source.heldInput)
    result

chan_feature_step(ChanFeatureSequence state, ChanStructure stroke) =>
    if na(stroke) or stroke.objectType != "stroke" or not stroke.confirmed or na(stroke.confirmedAt) or na(stroke.startTime) or na(stroke.endTime) or na(stroke.startTicks) or na(stroke.endTicks) or stroke.endTime <= stroke.startTime or stroke.confirmedAt < stroke.endTime or (stroke.direction != 1 and stroke.direction != -1) or stroke.direction * (stroke.endTicks - stroke.startTicks) <= 0
        runtime.error("特征序列仅消费合法已锁定笔")
    if not na(state.boundaryTime) and stroke.startTime < state.boundaryTime and stroke.endTime > state.boundaryTime
        runtime.error("假设分界必须位于笔端点")
    bool duplicate = false
    if not na(state.lastInput)
        duplicate := stroke.id == state.lastInput.id
        if duplicate and chan_structure_signature(stroke) != chan_structure_signature(state.lastInput)
            runtime.error("已消费笔发生变化")
        if not duplicate and (stroke.startTime < state.lastInput.endTime or stroke.confirmedAt < state.lastInput.confirmedAt or stroke.ordinal <= state.lastInput.ordinal)
            runtime.error("特征序列输入顺序无效")
    if not duplicate and not state.blocked and not state.waitingDirection
        bool selected = stroke.direction == -state.segmentDirection
        if selected
            int side = not na(state.boundaryTime) and stroke.startTime >= state.boundaryTime ? 1 : 0
            ChanFeature incoming = ChanFeature.new()
            incoming.id := state.contextId + "/E/" + stroke.id
            incoming.lowTicks := math.min(stroke.startTicks, stroke.endTicks)
            incoming.highTicks := math.max(stroke.startTicks, stroke.endTicks)
            incoming.lowTime := stroke.direction == 1 ? stroke.startTime : stroke.endTime
            incoming.highTime := stroke.direction == 1 ? stroke.endTime : stroke.startTime
            incoming.firstTime := stroke.startTime
            incoming.lastTime := stroke.endTime
            incoming.firstOrdinal := stroke.ordinal
            incoming.lastOrdinal := stroke.ordinal
            incoming.firstSide := side
            incoming.lastSide := side
            incoming.availableAt := stroke.confirmedAt
            incoming.sourceIds := array.from(stroke.id)
            ChanFeature tail = state.elements.size() > 0 ? state.elements.last() : na
            bool contained = not na(tail) and chan_contains(tail.lowTicks, tail.highTicks, incoming.lowTicks, incoming.highTicks)
            bool crosses = not na(tail) and tail.lastSide != side
            bool split = crosses and not state.secondSequence
            bool merge = contained and not split
            if state.selectedCount >= state.maxSources or (not merge and state.elements.size() >= state.maxElements)
                state.blocked := true
                state.heldInput := chan_structure_copy(stroke)
            else if merge and state.mergeDirection == 0
                // Preserve the unresolved input. A caller must supply evidenced
                // prior direction and rebuild; never guess from this inclusion.
                state.waitingDirection := true
                state.heldInput := chan_structure_copy(stroke)
                state.inputCount += 1
                state.selectedCount += 1
                state.lastInput := chan_structure_copy(stroke)
            else
                state.selectedCount += 1
                if merge
                    int highTicks = state.mergeDirection == 1 ? math.max(tail.highTicks, incoming.highTicks) : math.min(tail.highTicks, incoming.highTicks)
                    int lowTicks = state.mergeDirection == 1 ? math.max(tail.lowTicks, incoming.lowTicks) : math.min(tail.lowTicks, incoming.lowTicks)
                    if highTicks != tail.highTicks
                        tail.highTime := incoming.highTime
                    if lowTicks != tail.lowTicks
                        tail.lowTime := incoming.lowTime
                    tail.highTicks := highTicks
                    tail.lowTicks := lowTicks
                    tail.lastTime := incoming.lastTime
                    tail.lastOrdinal := incoming.lastOrdinal
                    tail.lastSide := side
                    tail.availableAt := math.max(tail.availableAt, incoming.availableAt)
                    tail.sourceIds.push(stroke.id)
                else
                    if not na(tail)
                        tail.sealed := true
                        if contained and split
                            state.boundaryCuts += 1
                            state.mergeDirection := state.postDirection
                        else
                            state.mergeDirection := incoming.highTicks > tail.highTicks ? 1 : -1
                    state.elements.push(incoming)
                state.inputCount += 1
                state.lastInput := chan_structure_copy(stroke)
        else
            state.inputCount += 1
            state.lastInput := chan_structure_copy(stroke)
    state

// Geometry and gap diagnostics only: segment start, break proof, ownership,
// dependency validity and a sealed right element still belong to the S machine.
chan_feature_turn(ChanFeatureSequence state) =>
    ChanFeatureTurn result = na
    int count = state.elements.size()
    if count >= 3 and not state.blocked and not state.waitingDirection
        ChanFeature left = state.elements.get(count - 3)
        ChanFeature middle = state.elements.get(count - 2)
        ChanFeature right = state.elements.get(count - 1)
        bool top = middle.highTicks > left.highTicks and middle.highTicks > right.highTicks and middle.lowTicks > left.lowTicks and middle.lowTicks > right.lowTicks
        bool bottom = middle.highTicks < left.highTicks and middle.highTicks < right.highTicks and middle.lowTicks < left.lowTicks and middle.lowTicks < right.lowTicks
        if (state.segmentDirection == 1 and top) or (state.segmentDirection == -1 and bottom)
            bool gap = state.segmentDirection == 1 ? left.highTicks < middle.lowTicks : middle.highTicks < left.lowTicks
            result := ChanFeatureTurn.new(state.segmentDirection, state.segmentDirection == 1 ? middle.highTime : middle.lowTime, state.segmentDirection == 1 ? middle.highTicks : middle.lowTicks, math.max(left.availableAt, math.max(middle.availableAt, right.availableAt)), left.id, middle.id, right.id, gap, right.sealed)
    result

chan_feature_signature(ChanFeatureSequence state) =>
    string result = state.contextId + "/" + str.tostring(state.segmentDirection) + "/" + str.tostring(state.mergeDirection) + "/" + str.tostring(state.postDirection) + "/" + str.tostring(state.boundaryTime) + "/" + str.tostring(state.secondSequence) + "/" + str.tostring(state.maxElements) + "/" + str.tostring(state.maxSources) + "/" + str.tostring(state.inputCount) + "/" + str.tostring(state.selectedCount) + "/" + str.tostring(state.boundaryCuts) + "/" + str.tostring(state.waitingDirection) + "/" + str.tostring(state.blocked)
    for element in state.elements
        result += "/" + element.id + "/" + str.tostring(element.lowTicks) + "/" + str.tostring(element.highTicks) + "/" + str.tostring(element.lowTime) + "/" + str.tostring(element.highTime) + "/" + str.tostring(element.firstTime) + "/" + str.tostring(element.lastTime) + "/" + str.tostring(element.firstOrdinal) + "/" + str.tostring(element.lastOrdinal) + "/" + str.tostring(element.firstSide) + "/" + str.tostring(element.lastSide) + "/" + str.tostring(element.availableAt) + "/" + str.tostring(element.sealed)
        for sourceId in element.sourceIds
            result += "/" + sourceId
    result + "/last/" + chan_structure_signature(state.lastInput) + "/held/" + chan_structure_signature(state.heldInput)
// END CHANLUN CORE

// BEGIN CHANLUN RENDERER
// One registry owns every line, box and label, including previews and diagnostics.
// Drawing descriptors are projections of core records; the registry never owns core state.
type ChanDrawSpec
    string id
    string category
    string primitive
    int x1
    int x2
    float y1
    float y2
    color hue
    int width
    bool confirmed
    string caption
    string tooltip
    int fontSize
    int fillTransparency
    bool ephemeral
    int groupLimit

type ChanDrawing
    string id
    string category
    string primitive
    line lineId
    box boxId
    label labelId
    bool ephemeral
    int touched

type ChanDrawRegistry
    array<ChanDrawing> records
    int frame = 0
    int maxLines = 450
    int maxBoxes = 450
    int maxLabels = 120

type ChanVisualStyle
    color strokeColor = color.blue
    color segmentColor = color.orange
    color l1Color = color.purple
    color l2Color = color.teal
    color l3Color = color.red
    int strokeWidth = 1
    int segmentWidth = 2
    int movementWidth = 3
    int centerTransparency = 90
    int fontSize = 12
    bool detailed = false

chan_layer_color(int level, ChanVisualStyle style) =>
    level <= 1 ? style.l1Color : level == 2 ? style.l2Color : style.l3Color

chan_draw_new(int labelLimit) =>
    ChanDrawRegistry registry = ChanDrawRegistry.new()
    registry.records := array.new<ChanDrawing>()
    registry.maxLabels := labelLimit
    registry

chan_draw_count(ChanDrawRegistry registry, string primitive, string category) =>
    int count = 0
    if registry.records.size() > 0
        for record in registry.records
            if (primitive == "" or record.primitive == primitive) and (category == "" or record.category == category)
                count += 1
    count

chan_draw_index(ChanDrawRegistry registry, string id) =>
    int found = -1
    if registry.records.size() > 0
        for index = 0 to registry.records.size() - 1
            if registry.records.get(index).id == id
                found := index
                break
    found

chan_draw_delete(ChanDrawRegistry registry, int index) =>
    ChanDrawing record = registry.records.remove(index)
    if not na(record.lineId)
        line.delete(record.lineId)
    if not na(record.boxId)
        box.delete(record.boxId)
    if not na(record.labelId)
        label.delete(record.labelId)
    true

chan_draw_oldest(ChanDrawRegistry registry, string primitive, string category) =>
    int found = -1
    if registry.records.size() > 0
        for index = 0 to registry.records.size() - 1
            ChanDrawing record = registry.records.get(index)
            if (primitive == "" or record.primitive == primitive) and (category == "" or record.category == category)
                found := index
                break
    found

chan_draw_put(ChanDrawRegistry registry, ChanDrawSpec spec) =>
    if na(spec.x1) or na(spec.x2) or na(spec.y1) or na(spec.y2) or spec.x2 < spec.x1 or spec.width < 1 or spec.fontSize < 1 or spec.fillTransparency < 0 or spec.fillTransparency > 100
        runtime.error("绘图描述缺少有效时价或样式")
    // Degenerate intervals share the line budget rather than disappearing as zero-height boxes.
    string primitive = spec.primitive == "box" and spec.y1 == spec.y2 ? "line" : spec.primitive
    if primitive != "line" and primitive != "box" and primitive != "label"
        runtime.error("绘图对象类型无效")
    int index = chan_draw_index(registry, spec.id)
    if index >= 0
        ChanDrawing previous = registry.records.get(index)
        if previous.primitive != primitive or previous.category != spec.category
            chan_draw_delete(registry, index)
            index := -1
    int limit = primitive == "line" ? registry.maxLines : primitive == "box" ? registry.maxBoxes : registry.maxLabels
    if limit < 1 or spec.groupLimit < 1
        if index >= 0
            chan_draw_delete(registry, index)
    else
        if index < 0
            while chan_draw_count(registry, primitive, "") >= limit
                chan_draw_delete(registry, chan_draw_oldest(registry, primitive, ""))
            while chan_draw_count(registry, "", spec.category) >= spec.groupLimit
                chan_draw_delete(registry, chan_draw_oldest(registry, "", spec.category))
            ChanDrawing created = ChanDrawing.new()
            created.id := spec.id
            created.category := spec.category
            created.primitive := primitive
            if primitive == "line"
                created.lineId := line.new(spec.x1, spec.y1, spec.x2, spec.y2, xloc = xloc.bar_time)
            else if primitive == "box"
                created.boxId := box.new(spec.x1, math.max(spec.y1, spec.y2), spec.x2, math.min(spec.y1, spec.y2), xloc = xloc.bar_time)
            else
                created.labelId := label.new(spec.x1, spec.y1, xloc = xloc.bar_time)
            registry.records.push(created)
            index := registry.records.size() - 1
        ChanDrawing record = registry.records.get(index)
        record.ephemeral := spec.ephemeral
        record.touched := registry.frame
        if primitive == "line"
            line.set_xy1(record.lineId, spec.x1, spec.y1)
            line.set_xy2(record.lineId, spec.x2, spec.y2)
            line.set_color(record.lineId, spec.hue)
            line.set_width(record.lineId, spec.width)
            line.set_style(record.lineId, spec.confirmed ? line.style_solid : line.style_dashed)
        else if primitive == "box"
            box.set_lefttop(record.boxId, spec.x1, math.max(spec.y1, spec.y2))
            box.set_rightbottom(record.boxId, spec.x2, math.min(spec.y1, spec.y2))
            box.set_border_color(record.boxId, spec.hue)
            box.set_border_width(record.boxId, spec.width)
            box.set_border_style(record.boxId, spec.confirmed ? line.style_solid : line.style_dashed)
            box.set_bgcolor(record.boxId, color.new(spec.hue, spec.fillTransparency))
        else
            label.set_xy(record.labelId, spec.x1, spec.y1)
            label.set_text(record.labelId, spec.caption)
            label.set_tooltip(record.labelId, spec.tooltip)
            label.set_style(record.labelId, label.style_none)
            label.set_color(record.labelId, color.new(spec.hue, 100))
            label.set_textcolor(record.labelId, spec.hue)
            label.set_size(record.labelId, spec.fontSize)
    true

chan_draw_begin(ChanDrawRegistry registry) =>
    registry.frame += 1
    true

chan_draw_sweep(ChanDrawRegistry registry) =>
    if registry.records.size() > 0
        for index = registry.records.size() - 1 to 0
            ChanDrawing record = registry.records.get(index)
            if record.ephemeral and record.touched != registry.frame
                chan_draw_delete(registry, index)
    true

chan_fractal_spec(ChanFractal fractal, float tickSize, bool confirmed, color topColor, color bottomColor, int fontSize, bool detailed, bool ephemeral, int groupLimit) =>
    string shortId = "F" + (fractal.kind == 1 ? "顶" : "底") + "#" + str.tostring(fractal.middleOrdinal + 1)
    string caption = shortId + (confirmed ? "" : " · 候选")
    string tooltip = "分型结构编号，不是买卖点编号"
    if detailed
        tooltip += "\n" + fractal.id + "\n规则：" + fractal.ruleId + "\n来源时间：" + str.format_time(fractal.endpointTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
        tooltip += confirmed ? "\n确认时间：" + str.format_time(fractal.confirmedAt, "yyyy-MM-dd HH:mm", "UTC") + " UTC" : "\n未确认；尾部可变化"
        tooltip += "\n依赖：" + fractal.leftId + "\n" + fractal.middleId + "\n" + fractal.rightId
    ChanDrawSpec.new(fractal.id, "F", "label", fractal.endpointTime, fractal.endpointTime, fractal.priceTicks * tickSize, fractal.priceTicks * tickSize, fractal.kind == 1 ? topColor : bottomColor, 1, confirmed, caption, tooltip, fontSize, 100, ephemeral, groupLimit)

// Adapters accept actual core records. Production only calls adapters for implemented modules.
chan_draw_structure(ChanDrawRegistry registry, ChanStructure source, float tickSize, ChanVisualStyle style, bool withCaption) =>
    if na(source.objectType) or (source.objectType != "stroke" and source.objectType != "segment")
        runtime.error("该结构须使用对应层级的绘图适配器")
    if source.confirmed and na(source.confirmedAt)
        runtime.error("已确认结构缺少确认时刻")
    bool stroke = source.objectType == "stroke"
    string tag = stroke ? "P" : "S"
    color hue = stroke ? style.strokeColor : style.segmentColor
    int width = stroke ? style.strokeWidth : style.segmentWidth
    int cap = stroke ? 150 : 60
    chan_draw_put(registry, ChanDrawSpec.new(source.id + "/line", tag + "-line", "line", source.startTime, source.endTime, source.startTicks * tickSize, source.endTicks * tickSize, hue, width, source.confirmed, "", "", style.fontSize, 100, not source.confirmed, cap))
    if withCaption
        string caption = tag + "#" + str.tostring(source.ordinal) + (source.confirmed ? "" : " · 候选")
        string tooltip = style.detailed ? source.id + "\n规则：" + source.ruleId : "结构编号，不是买卖点编号"
        chan_draw_put(registry, ChanDrawSpec.new(source.id + "/caption", tag + "-caption", "label", source.endTime, source.endTime, source.endTicks * tickSize, source.endTicks * tickSize, hue, 1, source.confirmed, caption, tooltip, style.fontSize, 100, not source.confirmed, 120))
    true

chan_draw_center(ChanDrawRegistry registry, ChanCenter source, float tickSize, ChanVisualStyle style, bool withCaption) =>
    if na(source.level) or na(source.coreLowTicks) or na(source.coreHighTicks) or source.level < 1 or source.level > 3 or source.coreLowTicks > source.coreHighTicks
        runtime.error("中枢层级或核心区间无效")
    color hue = chan_layer_color(source.level, style)
    string tag = "L" + str.tostring(source.level) + "-Z"
    bool confirmed = not na(source.confirmedAt)
    chan_draw_put(registry, ChanDrawSpec.new(source.id + "/range", tag + "-range", "box", source.startTime, source.extentEndTime, source.coreLowTicks * tickSize, source.coreHighTicks * tickSize, hue, 1, confirmed, "", "", style.fontSize, style.centerTransparency, not confirmed, 15))
    if withCaption
        string caption = tag + "#" + str.tostring(source.ordinal) + (source.coreLowTicks == source.coreHighTicks ? " · 退化" : "") + (confirmed ? "" : " · 候选")
        string tooltip = style.detailed ? source.id + "\n规则：" + source.ruleId : "中枢结构编号"
        chan_draw_put(registry, ChanDrawSpec.new(source.id + "/caption", tag + "-caption", "label", source.startTime, source.startTime, source.coreHighTicks * tickSize, source.coreHighTicks * tickSize, hue, 1, confirmed, caption, tooltip, style.fontSize, 100, not confirmed, 15))
    true

chan_draw_movement(ChanDrawRegistry registry, ChanMovement source, float tickSize, ChanVisualStyle style, bool withCaption) =>
    if na(source.level) or source.level < 1 or source.level > 3 or (source.completed and (na(source.confirmedAt) or na(source.completionProof) or source.completionProof == ""))
        runtime.error("走势层级或完成证明无效")
    color hue = chan_layer_color(source.level, style)
    string tag = "L" + str.tostring(source.level) + "-M"
    chan_draw_put(registry, ChanDrawSpec.new(source.id + "/line", tag + "-line", "line", source.startTime, source.endTime, source.startTicks * tickSize, source.endTicks * tickSize, hue, style.movementWidth + source.level - 1, source.completed, "", "", style.fontSize, 100, not source.completed, 30))
    if withCaption
        // The renderer never infers a trend from slope or endpoint price comparisons.
        string morphology = source.morphology == "consolidation" ? "盘整" : source.morphology == "uptrend" ? "上涨" : source.morphology == "downtrend" ? "下跌" : "待定"
        string caption = tag + "#" + str.tostring(source.ordinal) + " · " + morphology + (source.completed ? "" : " · 进行中")
        string tooltip = style.detailed ? source.id + "\n规则：" + source.ruleId : "走势类型来自计算内核"
        chan_draw_put(registry, ChanDrawSpec.new(source.id + "/caption", tag + "-caption", "label", source.endTime, source.endTime, source.endTicks * tickSize, source.endTicks * tickSize, hue, 1, source.completed, caption, tooltip, style.fontSize, 100, not source.completed, 30))
    true
// Research projection of a supplied S hypothesis; never fabricates S segments.
chan_draw_features(ChanDrawRegistry registry, ChanFeatureSequence sequence, float tickSize, ChanVisualStyle style) =>
    int count = sequence.elements.size()
    if count > 0
        for index = math.max(0, count - 12) to count - 1
            ChanFeature element = sequence.elements.get(index)
            string caption = "E#" + str.tostring(element.firstOrdinal) + (element.lastOrdinal == element.firstOrdinal ? "" : "–" + str.tostring(element.lastOrdinal)) + (sequence.secondSequence ? " · 第二序列" : " · 第一序列")
            string tooltip = "特征元素诊断，不是线段确认\n规则：S-001/S-002/S-003/E-006\n" + element.id + "\n来源笔："
            for sourceId in element.sourceIds
                tooltip += "\n" + sourceId
            tooltip += "\n高点来源：" + str.format_time(element.highTime, "yyyy-MM-dd HH:mm", "UTC") + "\n低点来源：" + str.format_time(element.lowTime, "yyyy-MM-dd HH:mm", "UTC")
            if not na(sequence.boundaryTime)
                tooltip += "\n假设分界：" + str.format_time(sequence.boundaryTime, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
            chan_draw_put(registry, ChanDrawSpec.new(element.id + "/range", "S-feature-range", "box", element.firstTime, element.lastTime, element.lowTicks * tickSize, element.highTicks * tickSize, style.segmentColor, 1, false, "", "", style.fontSize, 96, true, 24))
            chan_draw_put(registry, ChanDrawSpec.new(element.id + "/caption", "S-feature-caption", "label", element.lastTime, element.lastTime, element.highTicks * tickSize, element.highTicks * tickSize, style.segmentColor, 1, false, caption, tooltip, style.fontSize, 100, true, 24))
    ChanFeatureTurn turn = chan_feature_turn(sequence)
    if not na(turn)
        string caption = (turn.kind == 1 ? "特征顶" : "特征底") + (turn.gap ? " · 有缺口" : " · 无缺口") + " · 候选"
        chan_draw_put(registry, ChanDrawSpec.new(sequence.contextId + "/turn", "S-feature-turn", "label", turn.endpointTime, turn.endpointTime, turn.priceTicks * tickSize, turn.priceTicks * tickSize, style.segmentColor, 1, false, caption, "特征几何不等于段终结；仍待合法起始、破坏与归属证明", style.fontSize, 100, true, 4))
    if not na(sequence.heldInput)
        ChanStructure held = sequence.heldInput
        string caption = sequence.blocked ? "特征序列受限：依赖预算" : "特征序列等待：先前方向"
        chan_draw_put(registry, ChanDrawSpec.new(sequence.contextId + "/held", "S-feature-held", "label", held.endTime, held.endTime, held.endTicks * tickSize, held.endTicks * tickSize, style.segmentColor, 1, false, caption, "未决笔及已有依赖保留；不提交线段确认", style.fontSize, 100, true, 4))
    true
// END CHANLUN RENDERER

// ==================== Inputs: only implemented features are exposed ====================
string groupContext = "分析范围"
int initialBars = input.int(5000, "初始最近K线数", minval = 100, maxval = 5000, group = groupContext)
bool fixedStart = input.bool(false, "使用固定起点", group = groupContext)
int requestedStart = input.time(1700000000000, "固定起点", group = groupContext)
int sampleLimit = input.int(20000, "固定起点样本上限", minval = 100, maxval = 100000, group = groupContext)
string viewMode = input.string("普通", "视图", options = ["普通", "研究"], group = "显示")
bool showFractals = input.bool(false, "显示分型结构编号", group = "显示")
bool showStrokes = input.bool(true, "显示蓝色笔", group = "笔")
bool showStrokeIds = input.bool(true, "显示笔结构编号", group = "笔")
color strokeColor = input.color(color.blue, "笔颜色", group = "笔")
int strokeWidth = input.int(1, "笔线宽", minval = 1, maxval = 3, group = "笔")
int labelStride = input.int(1, "每几个确认分型显示一个编号", minval = 1, maxval = 20, group = "显示")
int fontSize = input.int(12, "提示字号", minval = 8, maxval = 24, group = "显示")
color topColor = input.color(color.orange, "顶分型颜色", group = "显示")
color bottomColor = input.color(color.blue, "底分型颜色", group = "显示")
int labelBudget = input.int(120, "全局研究标签上限", minval = 12, maxval = 120, group = "显示")
bool showMerged = input.bool(true, "研究：显示近期包含处理范围", group = "研究视图")
bool showConfirmations = input.bool(true, "研究：显示确认时刻", group = "研究视图")
color mergedColor = input.color(color.gray, "合并K线边界颜色", group = "研究视图")
int mergedWidth = input.int(1, "合并K线边界线宽", minval = 1, maxval = 3, group = "研究视图")
int mergedTransparency = input.int(92, "合并K线填充透明度", minval = 75, maxval = 100, group = "研究视图")
bool research = viewMode == "研究"

// ==================== Chart scheduling: no drawing decisions enter the core ====================
var ChanState committed = chan_new(syminfo.tickerid + "/" + timeframe.period + "/" + str.tostring(syminfo.mintick))
var ChanDrawRegistry drawings = chan_draw_new(labelBudget)
var table status = table.new(position.top_right, 1, 5)
var int firstAvailableTime = time
bool inRange = fixedStart ? time >= requestedStart : bar_index >= last_bar_index - initialBars + 1
bool limited = fixedStart and committed.inputCount >= sampleLimit
bool supported = chart.is_standard and not na(time_close)
bool insufficientHistory = fixedStart and requestedStart < firstAvailableTime
ChanState visible = committed
ChanVisualStyle strokeStyle = ChanVisualStyle.new()
strokeStyle.strokeColor := strokeColor
strokeStyle.strokeWidth := strokeWidth
strokeStyle.fontSize := fontSize
strokeStyle.detailed := research
if supported and inRange and not limited
    ChanRaw incoming = ChanRaw.new(time, time_close, int(math.round(open / syminfo.mintick)), int(math.round(high / syminfo.mintick)), int(math.round(low / syminfo.mintick)), int(math.round(close / syminfo.mintick)))
    if barstate.isconfirmed
        committed := chan_step(committed, incoming)
        visible := committed
        if showStrokes and not na(committed.strokeEvent)
            chan_draw_structure(drawings, committed.strokeEvent, syminfo.mintick, strokeStyle, showStrokeIds)
        if showFractals and not na(committed.event) and (committed.confirmedFractals - 1) % labelStride == 0
            chan_draw_put(drawings, chan_fractal_spec(committed.event, syminfo.mintick, true, topColor, bottomColor, fontSize, research, false, labelBudget))
            if research and showConfirmations
                ChanFractal event = committed.event
                chan_draw_put(drawings, ChanDrawSpec.new(event.id + "/confirmation", "F-confirmation", "label", event.confirmedAt, event.confirmedAt, event.priceTicks * syminfo.mintick, event.priceTicks * syminfo.mintick, color.gray, 1, true, "F确认#" + str.tostring(event.middleOrdinal + 1), "端点发生时间与此处的证据确认时间不同", math.max(8, fontSize - 2), 100, false, labelBudget))
    else
        visible := chan_step(chan_clone(committed), incoming)

// ==================== Last-bar research projection ====================
if barstate.islast
    chan_draw_begin(drawings)
    if showStrokes and supported
        // Unsealed fractals are evaluated only in an isolated drawing preview.
        // Neither this preview nor its hypothetical locking event enters committed state.
        ChanState strokePreview = chan_stroke_preview(visible)
        if not na(strokePreview.strokeCandidate)
            chan_draw_structure(drawings, strokePreview.strokeCandidate, syminfo.mintick, strokeStyle, showStrokeIds)
        ChanStructure pendingLock = chan_stroke_pending(strokePreview, committed.strokeCount)
        if not na(pendingLock)
            chan_draw_structure(drawings, pendingLock, syminfo.mintick, strokeStyle, showStrokeIds)
    if showFractals and supported
        if not na(visible.candidate)
            chan_draw_put(drawings, chan_fractal_spec(visible.candidate, syminfo.mintick, false, topColor, bottomColor, fontSize, research, true, labelBudget))
        // A preview may seal an older fractal; it remains visibly unconfirmed until close.
        if not barstate.isconfirmed and not limited and not na(visible.event)
            chan_draw_put(drawings, chan_fractal_spec(visible.event, syminfo.mintick, false, topColor, bottomColor, fontSize, research, true, labelBudget))
    if research and showMerged and supported and visible.elements.size() > 0
        for element in visible.elements
            if element.lastRaw > element.firstRaw
                string caption = "K合并#" + str.tostring(element.ordinal + 1) + " · " + str.tostring(element.lastRaw - element.firstRaw + 1) + "根" + (element.sealed ? "" : " · 候选")
                string tooltip = element.id + "\n高点来源：" + str.format_time(element.highTime, "yyyy-MM-dd HH:mm", "UTC") + "\n低点来源：" + str.format_time(element.lowTime, "yyyy-MM-dd HH:mm", "UTC") + "\n规则：K-001/K-002"
                chan_draw_put(drawings, ChanDrawSpec.new(element.id + "/range", "K-range", "box", element.firstTime, element.lastTime, element.lowTicks * syminfo.mintick, element.highTicks * syminfo.mintick, mergedColor, mergedWidth, element.sealed, "", "", fontSize, mergedTransparency, true, 4))
                chan_draw_put(drawings, ChanDrawSpec.new(element.id + "/caption", "K-caption", "label", element.firstTime, element.firstTime, element.highTicks * syminfo.mintick, element.highTicks * syminfo.mintick, mergedColor, 1, element.sealed, caption, tooltip, math.max(8, fontSize - 2), 100, true, 4))
    chan_draw_sweep(drawings)
    string condition = not supported ? "仅支持有确定收盘时间的普通K线" : limited ? "样本已截断" : visible.direction == 0 ? "初始化：等待非包含输入" : insufficientHistory ? "历史不足：实际可用起点晚于请求" : "形态预览运行中"
    table.cell(status, 0, 0, "包含 / 分型 / 笔 · " + viewMode + "视图", text_color = color.orange, text_size = fontSize)
    table.cell(status, 0, 1, condition, text_size = fontSize)
    table.cell(status, 0, 2, "有效起点：" + (na(visible.effectiveStart) ? "等待" : str.format_time(visible.effectiveStart, "yyyy-MM-dd HH:mm", "UTC") + " UTC"), text_size = fontSize)
    table.cell(status, 0, 3, "确认分型：" + str.tostring(committed.confirmedFractals) + " · 确认笔：" + str.tostring(committed.strokeCount) + " · 线段 / 递归待实现", text_size = fontSize)
    table.cell(status, 0, 4, research ? "绘图：线 " + str.tostring(chan_draw_count(drawings, "line", "")) + " / 框 " + str.tostring(chan_draw_count(drawings, "box", "")) + " / 标签 " + str.tostring(chan_draw_count(drawings, "label", "")) : "结构编号不是买卖点 · chanlun-research-0.1", text_size = math.max(8, fontSize - 2))
